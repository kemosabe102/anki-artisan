{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "{{agent-name}}.schema.json",
  "title": "{{Agent Name}} Agent Schema",
  "description": "Schema for {{agent-name}} outputs. Extends base-agent.schema.json.",

  "$comment": "This schema extends the base agent schema. Standard fields (status, agent, task_id, operation_type, summary, confidence, execution_timestamp) are inherited. Only define agent_specific_output and failure_details structures below.",

  "allOf": [
    { "$ref": "../../docs/shared/schemas/base-agent.schema.json#/properties/output" }
  ],

  "definitions": {
    "$comment": "Define your agent-specific output structures below. Use descriptive field names that match your agent's domain. The base schema handles status routing - you only need to define the content structures.",

    "success_output": {
      "type": "object",
      "description": "Agent-specific success output. Customize fields for your domain.",
      "required": ["{{required_field_1 - e.g., 'analysis'}}", "{{required_field_2 - e.g., 'recommendations'}}"],
      "properties": {
        "{{mode_field - e.g., 'operation_mode'}}": {
          "type": "string",
          "enum": ["{{mode_1 - e.g., 'full_analysis'}}", "{{mode_2 - e.g., 'quick_scan'}}", "{{mode_3 - e.g., 'targeted'}}"],
          "description": "Active processing mode for this agent"
        },
        "{{primary_output - e.g., 'analysis_results'}}": {
          "type": "object",
          "description": "Primary output structure - customize field names for your agent's domain",
          "properties": {
            "{{subfield_1 - e.g., 'findings'}}": {
              "type": "string",
              "description": "Main output content - what the agent discovered/produced"
            },
            "{{subfield_2 - e.g., 'summary'}}": {
              "type": "string",
              "description": "Brief summary of results (1-3 sentences)"
            },
            "{{subfield_list - e.g., 'recommendations'}}": {
              "type": "array",
              "items": { "type": "string" },
              "description": "List of actionable items or key points"
            }
          }
        },
        "{{secondary_output - e.g., 'items'}}": {
          "type": "array",
          "description": "Collection of structured items (if applicable)",
          "items": { "$ref": "#/definitions/item_type" }
        },
        "{{metadata_output - e.g., 'context'}}": {
          "type": "object",
          "description": "Metadata and context information",
          "properties": {
            "{{meta_field_1 - e.g., 'sources_consulted'}}": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Sources, files, or references used"
            },
            "{{meta_field_2 - e.g., 'assumptions'}}": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Assumptions made during processing"
            }
          }
        },
        "validation": {
          "type": "object",
          "description": "Self-validation results (recommended for all agents)",
          "properties": {
            "passed": {
              "type": "boolean",
              "description": "Whether output passed internal validation"
            },
            "warnings": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Non-blocking issues detected"
            },
            "quality_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Self-assessed output quality (0-1)"
            }
          }
        }
      }
    },

    "failure_output": {
      "type": "object",
      "description": "Failure details structure. Extends base failure_details with domain-specific types.",
      "required": ["failure_type", "reasons", "recovery_suggestions"],
      "properties": {
        "failure_type": {
          "type": "string",
          "enum": [
            "insufficient_context",
            "invalid_input",
            "timeout",
            "dependency_failure",
            "validation_error",
            "{{domain_specific_failure - e.g., 'parsing_error' for analyzers, 'build_failure' for implementers}}"
          ],
          "description": "Standard failure categories. Replace the last placeholder with domain-specific types as needed."
        },
        "reasons": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Specific reasons for failure (be actionable, not vague)"
        },
        "missing_inputs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Required inputs that were not provided or incomplete"
        },
        "recovery_suggestions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Actionable steps to resolve failure (user or orchestrator can act on these)"
        },
        "partial_results": {
          "type": "object",
          "description": "Any work completed before failure (useful for resume scenarios)"
        },
        "context_gaps": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Specific context that would have prevented this failure"
        }
      }
    },

    "item_type": {
      "type": "object",
      "description": "Template for structured items in secondary_output. Customize for your domain.",
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Identifier for this item"
        },
        "type": {
          "type": "string",
          "enum": ["{{type_1 - e.g., 'critical'}}", "{{type_2 - e.g., 'warning'}}", "{{type_3 - e.g., 'info'}}"],
          "description": "Category/severity of this item"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description"
        },
        "{{item_details - e.g., 'evidence'}}": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Supporting details or evidence"
        },
        "{{item_connections - e.g., 'related_items'}}": {
          "type": "array",
          "items": { "type": "string" },
          "description": "References to related items or dependencies"
        }
      }
    }
  }
}
