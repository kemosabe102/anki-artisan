{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qc-memory-estimate.schema.json",
  "title": "QC Memory Estimation Result",
  "description": "Output schema for QuantConnect algorithm memory profiling",
  "type": "object",
  "properties": {
    "algorithm": {
      "type": "string",
      "description": "Algorithm name or file path analyzed"
    },
    "estimated_memory_gb": {
      "type": "number",
      "minimum": 0,
      "description": "Total estimated memory in gigabytes"
    },
    "breakdown": {
      "type": "object",
      "description": "Memory component breakdown in megabytes",
      "properties": {
        "base_memory_mb": {
          "type": "number",
          "minimum": 0,
          "description": "Base memory for subscribed securities"
        },
        "history_memory_mb": {
          "type": "number",
          "minimum": 0,
          "description": "Memory for history buffers and windows"
        },
        "options_memory_mb": {
          "type": "number",
          "minimum": 0,
          "description": "Memory for options chain data"
        },
        "overhead_mb": {
          "type": "number",
          "minimum": 0,
          "description": "GC overhead, warmup, and safety margin"
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "description": "Parsed algorithm parameters used for estimation",
      "properties": {
        "universe_size": {
          "type": "integer",
          "minimum": 1
        },
        "resolution": {
          "type": "string",
          "enum": ["daily", "hour", "minute", "second", "tick"]
        },
        "history_days": {
          "type": "integer",
          "minimum": 0
        },
        "asset_type": {
          "type": "string",
          "enum": ["equity", "forex", "crypto", "options", "futures"]
        },
        "options_underlyings": {
          "type": "integer",
          "minimum": 0
        },
        "chain_depth": {
          "type": "integer",
          "minimum": 0
        },
        "warmup_months": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "recommended_node": {
      "type": "string",
      "enum": ["S1", "S2", "L1", "L2"],
      "description": "Recommended QC node tier"
    },
    "status": {
      "type": "string",
      "enum": ["PROCEED", "WARN_MEDIUM", "WARN_HIGH", "WARN_CRITICAL"],
      "description": "Memory status indicator"
    },
    "optimizations": {
      "type": "array",
      "description": "Suggested optimizations if status is WARN",
      "items": {
        "type": "string"
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of estimation"
    }
  },
  "required": [
    "algorithm",
    "estimated_memory_gb",
    "recommended_node",
    "status"
  ],
  "additionalProperties": false
}
