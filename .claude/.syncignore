# .syncignore - GitIgnore-style exclusion patterns for plugin export
#
# This file controls which files are excluded from the plugin distribution.
# Patterns follow gitignore syntax: glob patterns, wildcards, directory matches.

# Development files
*.swp
*.swo
*~
.DS_Store

# Temporary directories
temp/**
.cache/**

# Project-specific documentation (don't export to plugin)
docs/01-planning/specifications/**
docs/01-planning/tasks/**
docs/04-guides/development/**

# Test fixtures and data
tests/fixtures/**
tests/data/**

# Build artifacts
*.pyc
__pycache__/
.pytest_cache/

# Editor configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS-specific files
Thumbs.db
Desktop.ini

# Export configuration (internal only)
.export-config.json
