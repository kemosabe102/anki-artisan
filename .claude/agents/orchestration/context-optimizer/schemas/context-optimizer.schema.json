{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Context Optimizer Agent Schema",
  "description": "Schema for context-optimizer agent analyzing Claude Code ecosystem context usage and identifying optimization opportunities",
  "version": "1.0.0",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "description": "Input parameters for context optimization analysis",
      "properties": {
        "context": {
          "type": "string",
          "description": "Task context and optimization analysis instructions"
        },
        "execution_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp from orchestrator (mandatory)"
        },
        "analysis_scope": {
          "type": "string",
          "enum": ["agents", "orchestrator", "mcp", "full"],
          "description": "Scope of analysis"
        },
        "target_agents": {
          "oneOf": [
            {
              "type": "string",
              "const": "all",
              "description": "Analyze all agents in ecosystem"
            },
            {
              "type": "array",
              "items": { "type": "string" },
              "description": "Specific list of agent names to analyze"
            },
            {
              "type": "string",
              "pattern": "^[a-z0-9-]+\\*$",
              "description": "Glob pattern for agent matching (e.g., 'researcher-*')"
            }
          ],
          "description": "Target agents for analysis (default: 'all')"
        },
        "depth_level": {
          "type": "string",
          "enum": ["quick", "standard", "comprehensive"],
          "default": "standard",
          "description": "Analysis depth level"
        },
        "focus_areas": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["redundancy", "structure", "compression", "tooling", "all"]
          },
          "default": ["all"],
          "description": "Specific optimization areas to focus on"
        }
      },
      "required": ["context", "execution_timestamp"]
    },
    "output": {
      "type": "object",
      "oneOf": [
        {
          "title": "Success Output",
          "properties": {
            "status": { "const": "SUCCESS" },
            "agent": {
              "type": "string",
              "const": "context-optimizer"
            },
            "task_id": {
              "type": "string",
              "description": "Unique task identifier"
            },
            "operation_type": {
              "type": "string",
              "enum": ["context_analysis", "optimization_planning"],
              "description": "Type of optimization operation performed"
            },
            "summary": {
              "type": "string",
              "description": "1-3 sentence executive summary of analysis findings"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Confidence level in analysis accuracy and recommendations"
            },
            "execution_timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 UTC timestamp from orchestrator"
            },
            "agent_specific_output": {
              "type": "object",
              "description": "Context optimization analysis results",
              "properties": {
                "analysis_summary": {
                  "type": "object",
                  "properties": {
                    "total_tokens_analyzed": {
                      "type": "number",
                      "description": "Total token count analyzed across target scope"
                    },
                    "total_agents": {
                      "type": "number",
                      "description": "Total number of agents in ecosystem"
                    },
                    "targeted_agents": {
                      "type": "array",
                      "items": { "type": "string" },
                      "description": "List of agent names included in analysis"
                    },
                    "targeting_mode": {
                      "type": "string",
                      "enum": ["all", "specific", "pattern"],
                      "description": "How agents were selected for analysis"
                    },
                    "optimization_potential_tokens": {
                      "type": "number",
                      "description": "Estimated token savings from all recommendations"
                    },
                    "optimization_potential_pct": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100,
                      "description": "Optimization potential as percentage of total tokens"
                    },
                    "findings_count": {
                      "type": "number",
                      "description": "Total number of optimization findings identified"
                    },
                    "recommendations_count": {
                      "type": "number",
                      "description": "Total number of actionable recommendations generated"
                    }
                  },
                  "required": [
                    "total_tokens_analyzed",
                    "targeted_agents",
                    "targeting_mode",
                    "optimization_potential_tokens",
                    "optimization_potential_pct",
                    "findings_count",
                    "recommendations_count"
                  ]
                },
                "findings": {
                  "type": "array",
                  "description": "Detailed optimization findings",
                  "items": {
                    "type": "object",
                    "properties": {
                      "category": {
                        "type": "string",
                        "enum": ["redundancy", "mcp_bloat", "structure", "compression", "tooling"],
                        "description": "Category of optimization finding"
                      },
                      "severity": {
                        "type": "string",
                        "enum": ["critical", "high", "medium", "low"],
                        "description": "Severity level of the finding"
                      },
                      "location": {
                        "type": "string",
                        "description": "File path or component where finding was identified"
                      },
                      "tokens_wasted": {
                        "type": "number",
                        "description": "Estimated token waste from this finding"
                      },
                      "description": {
                        "type": "string",
                        "description": "Detailed description of the finding"
                      },
                      "impact": {
                        "type": "string",
                        "description": "Impact assessment of this finding"
                      }
                    },
                    "required": ["category", "severity", "location", "tokens_wasted", "description"]
                  }
                },
                "recommendations": {
                  "type": "array",
                  "description": "Prioritized optimization recommendations",
                  "items": {
                    "type": "object",
                    "properties": {
                      "priority": {
                        "type": "string",
                        "enum": ["P1", "P2", "P3", "P4"],
                        "description": "Recommendation priority level"
                      },
                      "title": {
                        "type": "string",
                        "description": "Brief title of the recommendation"
                      },
                      "savings_tokens": {
                        "type": "number",
                        "description": "Estimated token savings from implementing this recommendation"
                      },
                      "effort_hours": {
                        "type": "number",
                        "description": "Estimated implementation effort in hours"
                      },
                      "risk_score": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1,
                        "description": "Risk score for implementing this recommendation (0.0-1.0)"
                      },
                      "roi": {
                        "type": "number",
                        "description": "Return on investment (savings_tokens / effort_hours)"
                      },
                      "description": {
                        "type": "string",
                        "description": "Detailed description of the recommendation"
                      },
                      "implementation_steps": {
                        "type": "array",
                        "items": { "type": "string" },
                        "description": "Step-by-step implementation instructions"
                      }
                    },
                    "required": ["priority", "title", "savings_tokens", "effort_hours", "roi", "implementation_steps"]
                  }
                },
                "metrics": {
                  "type": "object",
                  "description": "Quantitative metrics from the analysis",
                  "properties": {
                    "agent_token_distribution": {
                      "type": "object",
                      "description": "Token distribution across agents (agent_name: token_count)"
                    },
                    "redundancy_rate": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "description": "Percentage of redundant content detected (0.0-1.0)"
                    },
                    "compression_ratio": {
                      "type": "number",
                      "description": "Potential compression ratio after optimization"
                    },
                    "template_compliance": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "description": "Compliance rate with base-agent-pattern template (0.0-1.0)"
                    },
                    "redundancy_score": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100,
                      "description": "Overall redundancy score (0-100, lower is better)"
                    },
                    "progressive_disclosure_score": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100,
                      "description": "Progressive disclosure compliance score (0-100, higher is better)"
                    },
                    "token_density_score": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100,
                      "description": "Token density quality score (0-100, higher is better)"
                    },
                    "overall_health_score": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100,
                      "description": "Overall context health score (0-100, higher is better)"
                    }
                  },
                  "required": [
                    "redundancy_score",
                    "progressive_disclosure_score",
                    "token_density_score",
                    "overall_health_score"
                  ]
                },
                "implementation_plan": {
                  "type": "object",
                  "description": "Phased implementation plan for optimization",
                  "properties": {
                    "phases": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "phase_number": { "type": "number" },
                          "title": { "type": "string" },
                          "recommendations": {
                            "type": "array",
                            "items": { "type": "string" }
                          },
                          "estimated_savings_tokens": { "type": "number" },
                          "estimated_effort_hours": { "type": "number" }
                        }
                      }
                    },
                    "timeline_weeks": {
                      "type": "number",
                      "description": "Estimated timeline in weeks for complete implementation"
                    },
                    "total_savings_estimate": {
                      "type": "number",
                      "description": "Total estimated token savings from all phases"
                    }
                  },
                  "required": ["phases", "timeline_weeks", "total_savings_estimate"]
                }
              },
              "required": ["analysis_summary", "findings", "recommendations", "metrics", "implementation_plan"]
            }
          },
          "required": ["status", "agent", "confidence", "agent_specific_output"],
          "additionalProperties": false
        },
        {
          "title": "Failure Output",
          "properties": {
            "status": { "const": "FAILURE" },
            "agent": {
              "type": "string",
              "const": "context-optimizer"
            },
            "task_id": {
              "type": "string",
              "description": "Unique task identifier"
            },
            "operation_type": {
              "type": "string",
              "enum": ["context_analysis", "optimization_planning"],
              "description": "Type of optimization operation attempted"
            },
            "summary": {
              "type": "string",
              "description": "1-3 sentence summary of why analysis failed"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Confidence level in failure analysis"
            },
            "execution_timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 UTC timestamp from orchestrator"
            },
            "failure_details": {
              "type": "object",
              "description": "Details about why the context optimization analysis failed",
              "properties": {
                "failure_type": {
                  "type": "string",
                  "enum": [
                    "scope_validation_error",
                    "file_read_error",
                    "insufficient_data",
                    "analysis_timeout",
                    "invalid_input",
                    "permission_denied"
                  ],
                  "description": "Primary type of failure encountered"
                },
                "reasons": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Specific reasons why analysis failed"
                },
                "affected_agents": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "List of agents that could not be analyzed"
                },
                "recovery_suggestions": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Suggested approaches to resolve failure and retry analysis"
                }
              },
              "required": ["failure_type", "reasons"]
            }
          },
          "required": ["status", "agent", "confidence", "failure_details"],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["input", "output"]
}
