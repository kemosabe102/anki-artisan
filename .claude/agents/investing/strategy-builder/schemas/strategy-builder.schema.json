{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Strategy Builder I/O Contract",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["full_build", "spec_only", "skeleton_only", "classify_only", "hdd_validate", "hypothesis_only", "submit_to_backtest", "validate"]},
        "nl_description": {"type": "string"},
        "existing_spec": {"type": "object"},
        "hdd_context": {
          "type": "object",
          "description": "HDD trial tracking context",
          "properties": {
            "trial_number": {"type": "integer", "minimum": 1, "maximum": 5, "description": "Current trial number (max 5 per hypothesis)"},
            "hypothesis_id": {"type": "string", "pattern": "^HYP-[0-9]{3}$", "description": "Unique hypothesis identifier (e.g., HYP-001)"},
            "locked_parameters": {"type": "array", "items": {"type": "string"}, "description": "Parameters that cannot be changed this trial"}
          }
        }
      },
      "required": ["mode"]
    },
    "output": {
      "type": "object",
      "properties": {
        "status": {"enum": ["SUCCESS", "FAILURE", "PENDING"]},
        "strategy_type": {"enum": ["momentum", "mean_reversion", "event_driven", "multi_factor"]},
        "classification_confidence": {"type": "number", "minimum": 0.4, "maximum": 0.95},
        "spec": {"$ref": "#/definitions/strategy_spec"},
        "python_skeleton": {"type": "string"},
        "clarifying_questions": {"type": "array", "items": {"type": "string"}},
        "trial_metadata": {
          "type": "object",
          "description": "HDD trial tracking output",
          "properties": {
            "trial_number": {"type": "integer"},
            "remaining_trials": {"type": "integer"},
            "parameter_count": {"type": "integer", "maximum": 10},
            "single_change_this_trial": {"type": "string", "description": "The ONE parameter changed in this trial"}
          }
        },
        "hypothesis_graveyard": {
          "type": "array",
          "description": "Archive of failed hypotheses",
          "items": {
            "type": "object",
            "properties": {
              "hypothesis_id": {"type": "string"},
              "cause_effect_why": {
                "type": "object",
                "properties": {
                  "cause": {"type": "string"},
                  "effect": {"type": "string"},
                  "why": {"type": "string"}
                }
              },
              "trial_count": {"type": "integer"},
              "failure_mode": {"type": "string", "enum": ["curve_fit", "regime_mismatch", "insufficient_trades", "implementation_bug"]},
              "backtest_metrics": {
                "type": "object",
                "properties": {
                  "sharpe_raw": {"type": "number"},
                  "sharpe_deflated": {"type": "number"},
                  "trade_count": {"type": "integer"},
                  "max_drawdown": {"type": "number"}
                }
              },
              "buried_at": {"type": "string", "format": "date-time"}
            }
          }
        }
      },
      "required": ["status"]
    }
  },
  "definitions": {
    "strategy_spec": {
      "type": "object",
      "properties": {
        "strategy_name": {"type": "string"},
        "strategy_type": {"type": "string"},
        "universe": {"type": "object"},
        "entry": {"type": "object"},
        "exit": {"type": "object"},
        "position_sizing": {"type": "object"},
        "risk_management": {"type": "object"},
        "timeframe": {"type": "string"},
        "regime_filters": {
          "type": "object",
          "description": "Market regime detection and position scaling configuration",
          "properties": {
            "indicator": {
              "type": "string",
              "description": "Regime indicator (e.g., SPY_200DMA, VIX_LEVEL)"
            },
            "conditions": {
              "type": "object",
              "description": "Condition-to-multiplier mapping"
            }
          },
          "required": ["indicator", "conditions"]
        }
      },
      "required": ["strategy_name", "strategy_type", "universe", "entry", "exit", "position_sizing", "risk_management", "timeframe", "regime_filters"]
    }
  }
}
