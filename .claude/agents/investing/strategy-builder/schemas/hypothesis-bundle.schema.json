{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hypothesis-bundle.schema.json",
  "title": "Hypothesis Bundle - 10-Phase Architecture",
  "description": "Extended schema for HDD hypothesis bundles supporting full 10-phase strategy development lifecycle",
  "type": "object",
  "required": ["hypothesis_id", "cause", "effect", "when", "why", "testability_score", "params_locked", "trial_number"],
  "properties": {
    "hypothesis_id": {
      "type": "string",
      "pattern": "^HYP-[0-9]{3}$",
      "description": "Unique hypothesis identifier (HYP-001 format)"
    },
    "cause": {
      "type": "string",
      "minLength": 10,
      "description": "Market condition or signal that triggers action"
    },
    "effect": {
      "type": "string",
      "minLength": 10,
      "description": "Expected price behavior following the cause"
    },
    "why": {
      "type": "string",
      "minLength": 20,
      "description": "Economic/behavioral rationale connecting cause to effect"
    },
    "when": {
      "type": "object",
      "description": "Regime condition under which hypothesis is valid",
      "properties": {
        "trend_filter": {
          "type": "string",
          "enum": ["above_200dma", "below_200dma", "any"],
          "default": "any",
          "description": "Price position relative to 200-day moving average"
        },
        "volatility_regime": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["LOW", "NORMAL", "HIGH"]
          },
          "default": ["LOW", "NORMAL", "HIGH"],
          "description": "Allowed volatility regimes for this hypothesis"
        },
        "atr_percentile_max": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 100,
          "description": "Maximum ATR percentile (e.g., 75 = exclude HIGH regime)"
        }
      },
      "required": ["volatility_regime"]
    },
    "testability_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "How testable is this hypothesis (0.7 minimum required)"
    },
    "params_locked": {
      "type": "object",
      "description": "Locked parameter values that cannot change under this hypothesis",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "value": {},
          "rationale": { "type": "string" }
        },
        "required": ["value"]
      }
    },
    "trial_number": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "description": "Current trial count (resets on new hypothesis)"
    },
    "max_trials": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "default": 5,
      "description": "Maximum trials allowed before hypothesis rejection"
    },
    "timeframe": {
      "type": "string",
      "enum": ["1min", "5min", "15min", "30min", "1hour", "4hour", "daily", "weekly"],
      "description": "Trading timeframe"
    },
    "mentioned_indicators": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Indicators mentioned in hypothesis for consistency checking"
    },
    "mechanism_type": {
      "type": "string",
      "enum": ["momentum", "mean_reversion", "event_driven", "multi_factor"],
      "description": "Strategy mechanism type"
    },

    "___DEFINITION_LAYER_COMMENT___": "=== DEFINITION LAYER (P1-P3): Universe & Backtest Setup ===",

    "universe": {
      "type": "object",
      "description": "P1-P3: Trading universe definition from universe-selector",
      "properties": {
        "symbols": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of ticker symbols in the universe"
        },
        "asset_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["equity", "etf", "futures", "options", "crypto", "forex", "fixed_income"]
          },
          "description": "Asset classes included in universe"
        },
        "scope": {
          "type": "string",
          "enum": ["single", "basket", "index", "sector", "cross_asset"],
          "default": "basket",
          "description": "Universe scope type"
        },
        "selection_criteria": {
          "type": "object",
          "properties": {
            "min_market_cap": { "type": "number", "description": "Minimum market cap in USD" },
            "min_adv": { "type": "number", "description": "Minimum average daily volume" },
            "min_price": { "type": "number", "description": "Minimum stock price" },
            "max_spread_bps": { "type": "number", "description": "Maximum bid-ask spread in basis points" }
          }
        }
      },
      "default": { "symbols": [], "asset_classes": ["equity"], "scope": "basket" }
    },
    "backtest_constraints": {
      "type": "object",
      "description": "P1-P3: Backtest configuration constraints",
      "properties": {
        "start_date": {
          "type": "string",
          "format": "date",
          "description": "Backtest start date (YYYY-MM-DD)"
        },
        "end_date": {
          "type": "string",
          "format": "date",
          "description": "Backtest end date (YYYY-MM-DD)"
        },
        "frequency": {
          "type": "string",
          "enum": ["tick", "1min", "5min", "15min", "30min", "1hour", "4hour", "daily"],
          "default": "daily",
          "description": "Data frequency for backtest"
        },
        "lookback_days": {
          "type": "integer",
          "minimum": 30,
          "maximum": 3650,
          "default": 252,
          "description": "Number of lookback days for indicator calculation"
        }
      },
      "default": { "frequency": "daily", "lookback_days": 252 }
    },
    "universe_quality_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 0,
      "description": "P1-P3: Universe quality score from universe-selector (0-100)"
    },
    "survivor_bias_status": {
      "type": "string",
      "enum": ["CHECKED", "UNCHECKED", "MITIGATED"],
      "default": "UNCHECKED",
      "description": "P1-P3: Status of survivorship bias check"
    },

    "___STRATEGY_LAYER_COMMENT___": "=== STRATEGY LAYER (P4-P6): Alpha & Execution ===",

    "alpha_rationale": {
      "type": "string",
      "minLength": 50,
      "description": "P4-P6: Statistical or economic rationale for why this alpha exists"
    },
    "position_sizing_method": {
      "type": "string",
      "enum": ["fixed", "volatility_scaled", "kelly", "regime_adjusted", "equal_weight", "risk_parity"],
      "default": "fixed",
      "description": "P4-P6: Position sizing methodology"
    },
    "regime_adjustment": {
      "type": "object",
      "description": "P4-P6: Regime-based position adjustment configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Whether regime adjustment is enabled"
        },
        "factors": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["volatility", "trend", "correlation", "momentum", "liquidity"]
          },
          "default": [],
          "description": "Factors used for regime detection"
        },
        "multipliers": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 2 },
          "default": {},
          "description": "Regime-to-multiplier mapping (e.g., {'HIGH_VOL': 0.5, 'LOW_VOL': 1.5})"
        }
      },
      "default": { "enabled": false, "factors": [], "multipliers": {} }
    },
    "execution_model": {
      "type": "object",
      "description": "P4-P6: Execution cost and market impact model",
      "properties": {
        "slippage_bps": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 5,
          "description": "Expected slippage in basis points"
        },
        "commission_bps": {
          "type": "number",
          "minimum": 0,
          "maximum": 50,
          "default": 1,
          "description": "Commission cost in basis points"
        },
        "market_impact": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "default": "low",
          "description": "Expected market impact level"
        },
        "execution_style": {
          "type": "string",
          "enum": ["aggressive", "passive", "twap", "vwap"],
          "default": "passive",
          "description": "Order execution style"
        }
      },
      "default": { "slippage_bps": 5, "commission_bps": 1, "market_impact": "low" }
    },

    "___RISK_LAYER_COMMENT___": "=== RISK LAYER (P7): Risk Management ===",

    "risk_regime": {
      "type": "object",
      "description": "P7: Current market risk regime assessment",
      "properties": {
        "volatility": {
          "type": "string",
          "enum": ["LOW", "NORMAL", "HIGH"],
          "default": "NORMAL",
          "description": "Current volatility regime"
        },
        "correlation": {
          "type": "string",
          "enum": ["LOW", "NORMAL", "HIGH"],
          "default": "NORMAL",
          "description": "Current cross-asset correlation regime"
        },
        "trend": {
          "type": "string",
          "enum": ["BULL", "BEAR", "NEUTRAL"],
          "default": "NEUTRAL",
          "description": "Current market trend regime"
        },
        "liquidity": {
          "type": "string",
          "enum": ["NORMAL", "STRESSED"],
          "default": "NORMAL",
          "description": "Current liquidity regime"
        }
      },
      "default": { "volatility": "NORMAL", "correlation": "NORMAL", "trend": "NEUTRAL" }
    },
    "circuit_breakers": {
      "type": "object",
      "description": "P7: Risk circuit breaker thresholds",
      "properties": {
        "daily_loss_limit": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.02,
          "description": "Maximum daily loss as fraction of portfolio (e.g., 0.02 = 2%)"
        },
        "drawdown_limit": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.10,
          "description": "Maximum drawdown before strategy pause (e.g., 0.10 = 10%)"
        },
        "position_limit": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.20,
          "description": "Maximum single position size as fraction of portfolio"
        },
        "sector_limit": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.30,
          "description": "Maximum sector concentration"
        }
      },
      "default": { "daily_loss_limit": 0.02, "drawdown_limit": 0.10, "position_limit": 0.20 }
    },

    "___VALIDATION_LAYER_COMMENT___": "=== VALIDATION LAYER (P8-P10): Testing & Validation ===",

    "backtest_metrics": {
      "type": "object",
      "description": "P8-P10: Core backtest performance metrics",
      "properties": {
        "sharpe": {
          "type": "number",
          "description": "Annualized Sharpe ratio"
        },
        "sharpe_deflated": {
          "type": "number",
          "description": "Deflated Sharpe ratio (adjusted for multiple testing)"
        },
        "max_dd": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Maximum drawdown as fraction"
        },
        "trade_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of trades in backtest"
        },
        "win_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Percentage of winning trades"
        },
        "profit_factor": {
          "type": "number",
          "minimum": 0,
          "description": "Gross profit / gross loss ratio"
        },
        "calmar_ratio": {
          "type": "number",
          "description": "CAGR / Max Drawdown ratio"
        },
        "sortino_ratio": {
          "type": "number",
          "description": "Risk-adjusted return using downside deviation"
        },
        "avg_trade_duration_days": {
          "type": "number",
          "minimum": 0,
          "description": "Average holding period in days"
        }
      },
      "default": {}
    },
    "sensitivity_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 0,
      "description": "P8-P10: Robustness score from noise/walk-forward testing (0-100, higher=more robust)"
    },
    "stress_test_results": {
      "type": "object",
      "description": "P8-P10: Results from historical crisis stress tests",
      "properties": {
        "crisis_2008": {
          "type": "string",
          "enum": ["PASS", "FAIL", "NOT_TESTED"],
          "default": "NOT_TESTED",
          "description": "Performance during 2008 financial crisis"
        },
        "crisis_2020": {
          "type": "string",
          "enum": ["PASS", "FAIL", "NOT_TESTED"],
          "default": "NOT_TESTED",
          "description": "Performance during 2020 COVID crash"
        },
        "crisis_2022": {
          "type": "string",
          "enum": ["PASS", "FAIL", "NOT_TESTED"],
          "default": "NOT_TESTED",
          "description": "Performance during 2022 rate hike selloff"
        },
        "flash_crash_2010": {
          "type": "string",
          "enum": ["PASS", "FAIL", "NOT_TESTED"],
          "default": "NOT_TESTED",
          "description": "Performance during 2010 flash crash"
        },
        "custom_scenarios": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": ["PASS", "FAIL", "NOT_TESTED"]
          },
          "default": {},
          "description": "Custom stress test scenarios"
        }
      },
      "default": { "crisis_2008": "NOT_TESTED", "crisis_2020": "NOT_TESTED", "crisis_2022": "NOT_TESTED" }
    },
    "walk_forward_results": {
      "type": "object",
      "description": "P8-P10: Walk-forward optimization results",
      "properties": {
        "in_sample_sharpe": { "type": "number", "description": "In-sample Sharpe ratio" },
        "out_sample_sharpe": { "type": "number", "description": "Out-of-sample Sharpe ratio" },
        "efficiency_ratio": { 
          "type": "number", 
          "minimum": 0,
          "maximum": 2,
          "description": "Out-of-sample / In-sample Sharpe (>0.5 is acceptable)" 
        },
        "num_folds": { "type": "integer", "minimum": 1, "description": "Number of walk-forward folds" }
      },
      "default": {}
    },

    "___PATTERN_LIFECYCLE_COMMENT___": "=== PATTERN LIFECYCLE INTEGRATION ===",

    "pattern_lifecycle_stage": {
      "type": "string",
      "enum": ["PRE_DISCOVERY", "EARLY", "MATURE", "CROWDED", "DEAD"],
      "default": "PRE_DISCOVERY",
      "description": "Current stage in the alpha lifecycle (affects position sizing and expectations)"
    },
    "edge_decay_risk": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH"],
      "default": "MEDIUM",
      "description": "Risk of alpha decay due to crowding or regime change"
    },
    "pattern_metadata": {
      "type": "object",
      "description": "Additional pattern lifecycle metadata",
      "properties": {
        "discovery_date": {
          "type": "string",
          "format": "date",
          "description": "When this pattern was first identified"
        },
        "academic_references": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Academic papers documenting this pattern"
        },
        "crowding_indicators": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Indicators used to detect crowding"
        },
        "estimated_capacity_usd": {
          "type": "number",
          "minimum": 0,
          "description": "Estimated strategy capacity in USD"
        }
      },
      "default": {}
    },

    "___METADATA_COMMENT___": "=== METADATA & AUDIT TRAIL ===",

    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when hypothesis was created"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last update"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "default": "1.0.0",
      "description": "Schema version for this hypothesis bundle"
    },
    "phase_status": {
      "type": "object",
      "description": "Completion status of each phase",
      "properties": {
        "P1_universe_selection": { "type": "string", "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETE"], "default": "NOT_STARTED" },
        "P2_data_quality": { "type": "string", "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETE"], "default": "NOT_STARTED" },
        "P3_backtest_setup": { "type": "string", "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETE"], "default": "NOT_STARTED" },
        "P4_alpha_formulation": { "type": "string", "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETE"], "default": "NOT_STARTED" },
        "P5_signal_generation": { "type": "string", "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETE"], "default": "NOT_STARTED" },
        "P6_execution_model": { "type": "string", "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETE"], "default": "NOT_STARTED" },
        "P7_risk_management": { "type": "string", "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETE"], "default": "NOT_STARTED" },
        "P8_backtest_validation": { "type": "string", "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETE"], "default": "NOT_STARTED" },
        "P9_sensitivity_analysis": { "type": "string", "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETE"], "default": "NOT_STARTED" },
        "P10_stress_testing": { "type": "string", "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETE"], "default": "NOT_STARTED" }
      },
      "default": {}
    },
    "audit_log": {
      "type": "array",
      "description": "Audit trail of significant changes",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "action": { "type": "string" },
          "phase": { "type": "string" },
          "details": { "type": "string" }
        }
      },
      "default": []
    }
  }
}
