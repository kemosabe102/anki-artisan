{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "market-data-specialist.schema.json",
  "version": "1.0.0",
  "title": "Market Data Specialist Schema",
  "description": "Input/output schema for OHLCV validation, API integration, Parquet compression, and time-series data model operations",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "description": "Unique identifier for the task"
        },
        "operation_type": {
          "type": "string",
          "enum": [
            "validate_ohlcv",
            "fetch_market_data",
            "compress_dataset",
            "create_data_models",
            "quality_check"
          ],
          "description": "Type of market data operation to perform"
        },
        "description": {
          "type": "string",
          "description": "Detailed description of what needs to be accomplished"
        },
        "data_validation": {
          "type": "object",
          "description": "OHLCV data validation configuration (validate_ohlcv, quality_check operations)",
          "properties": {
            "data_source": {
              "type": "string",
              "description": "Source location: file path, API endpoint, or database connection string"
            },
            "data_format": {
              "type": "string",
              "enum": ["csv", "json", "parquet", "api_response"],
              "description": "Input data format for validation"
            },
            "validation_rules": {
              "type": "object",
              "description": "Custom validation constraints and consistency checks",
              "properties": {
                "required_fields": {
                  "type": "array",
                  "items": { "type": "string" },
                  "default": ["timestamp", "open", "high", "low", "close", "volume"],
                  "description": "Fields required in each OHLCV record"
                },
                "consistency_checks": {
                  "type": "array",
                  "items": { "type": "string" },
                  "default": ["high_gte_low", "high_gte_open", "high_gte_close", "low_lte_open", "low_lte_close", "volume_gte_zero", "no_gaps"],
                  "description": "Consistency rules to enforce (7 standard checks)"
                },
                "custom_constraints": {
                  "type": "object",
                  "description": "Additional field-specific constraints (min/max values, patterns)"
                }
              }
            },
            "quality_threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.95,
              "description": "Minimum quality score (0-1) required to pass validation"
            }
          },
          "required": ["data_source", "data_format"]
        },
        "api_integration": {
          "type": "object",
          "description": "API connector configuration (fetch_market_data operation)",
          "properties": {
            "provider": {
              "type": "string",
              "enum": ["alpaca", "polygon", "yahoo"],
              "description": "Primary data provider (fallback cascade: Alpaca → Polygon → Yahoo)"
            },
            "symbols": {
              "type": "array",
              "items": { "type": "string" },
              "description": "List of ticker symbols to fetch (e.g., ['AAPL', 'MSFT', 'GOOGL'])"
            },
            "date_range": {
              "type": "object",
              "properties": {
                "start_date": {
                  "type": "string",
                  "format": "date",
                  "description": "Start date (YYYY-MM-DD format)"
                },
                "end_date": {
                  "type": "string",
                  "format": "date",
                  "description": "End date (YYYY-MM-DD format)"
                }
              },
              "required": ["start_date", "end_date"]
            },
            "fallback_enabled": {
              "type": "boolean",
              "default": true,
              "description": "Enable automatic fallback to secondary providers on failure"
            },
            "retry_config": {
              "type": "object",
              "properties": {
                "max_attempts": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5,
                  "default": 3
                },
                "backoff_seconds": {
                  "type": "number",
                  "minimum": 0,
                  "default": 2.0
                }
              }
            }
          },
          "required": ["provider", "symbols", "date_range"]
        },
        "compression_config": {
          "type": "object",
          "description": "Parquet compression configuration (compress_dataset operation)",
          "properties": {
            "target_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.70,
              "description": "Target compression ratio (0-1 scale, 0.70 = 70% compression aspiration)"
            },
            "codec": {
              "type": "string",
              "enum": ["snappy", "gzip", "lz4", "zstd"],
              "default": "snappy",
              "description": "Compression algorithm (snappy=balanced, gzip=max compression, lz4=speed, zstd=best overall)"
            },
            "partition_strategy": {
              "type": "string",
              "enum": ["date", "ticker", "hybrid", "none"],
              "default": "hybrid",
              "description": "Partitioning scheme for Parquet files"
            },
            "output_path": {
              "type": "string",
              "description": "Destination directory for compressed Parquet files"
            }
          },
          "required": ["output_path"]
        },
        "data_model_config": {
          "type": "object",
          "description": "SQLAlchemy model design configuration (create_data_models operation)",
          "properties": {
            "model_type": {
              "type": "string",
              "enum": ["ohlcv", "tick", "quote", "trade"],
              "description": "Type of time-series data model to create"
            },
            "output_path": {
              "type": "string",
              "description": "File path where SQLAlchemy models should be written"
            },
            "include_relationships": {
              "type": "boolean",
              "default": true,
              "description": "Generate relationship definitions (e.g., Symbol.ohlcv_records)"
            }
          },
          "required": ["model_type", "output_path"]
        },
        "execution_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp from orchestrator"
        }
      },
      "required": ["task_id", "operation_type", "description", "execution_timestamp"],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "oneOf": [
        {
          "title": "Market Data Specialist Success",
          "properties": {
            "status": { "const": "SUCCESS" },
            "agent": { "const": "market-data-specialist" },
            "task_id": { "type": "string" },
            "operation_type": {
              "enum": [
                "validate_ohlcv",
                "fetch_market_data",
                "compress_dataset",
                "create_data_models",
                "quality_check"
              ]
            },
            "summary": {
              "type": "string",
              "description": "1-3 sentence executive summary of operation completed"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Confidence level in operation success (required for orchestrator tracking)"
            },
            "execution_timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 UTC timestamp from orchestrator"
            },
            "agent_specific_output": {
              "type": "object",
              "description": "Market data specialist operation results",
              "properties": {
                "validated_dataset": {
                  "type": "object",
                  "description": "Dataset validation metadata",
                  "properties": {
                    "total_records": {
                      "type": "integer",
                      "description": "Total number of OHLCV records processed"
                    },
                    "valid_records": {
                      "type": "integer",
                      "description": "Number of records passing all validation checks"
                    },
                    "invalid_records": {
                      "type": "integer",
                      "description": "Number of records failing validation"
                    },
                    "data_quality_score": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "description": "Overall quality score (valid_records / total_records)"
                    },
                    "date_range": {
                      "type": "object",
                      "properties": {
                        "start": { "type": "string", "format": "date" },
                        "end": { "type": "string", "format": "date" }
                      }
                    },
                    "symbols": {
                      "type": "array",
                      "items": { "type": "string" },
                      "description": "List of ticker symbols in dataset"
                    }
                  },
                  "required": ["total_records", "valid_records", "invalid_records", "data_quality_score"]
                },
                "compression_metrics": {
                  "type": "object",
                  "description": "Parquet compression performance metrics",
                  "properties": {
                    "compression_ratio": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "description": "Achieved compression ratio (compressed_size / original_size)"
                    },
                    "codec_used": {
                      "type": "string",
                      "enum": ["snappy", "gzip", "lz4", "zstd"],
                      "description": "Compression algorithm applied"
                    },
                    "file_size_before": {
                      "type": "integer",
                      "description": "Original file size in bytes"
                    },
                    "file_size_after": {
                      "type": "integer",
                      "description": "Compressed file size in bytes"
                    },
                    "space_saved_mb": {
                      "type": "number",
                      "description": "Space saved in megabytes"
                    }
                  },
                  "required": ["compression_ratio", "codec_used", "file_size_before", "file_size_after"]
                },
                "validation_results": {
                  "type": "object",
                  "description": "Detailed validation check results",
                  "properties": {
                    "consistency_checks_passed": {
                      "type": "array",
                      "items": { "type": "string" },
                      "description": "List of consistency rules that passed (e.g., 'high_gte_low', 'volume_gte_zero')"
                    },
                    "consistency_checks_failed": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "rule": { "type": "string" },
                          "violation_count": { "type": "integer" },
                          "sample_records": {
                            "type": "array",
                            "items": { "type": "object" },
                            "description": "Sample of records violating this rule (max 5)"
                          }
                        }
                      }
                    },
                    "missing_data_summary": {
                      "type": "object",
                      "properties": {
                        "gaps_detected": { "type": "integer" },
                        "null_fields": {
                          "type": "object",
                          "description": "Count of null values per field"
                        }
                      }
                    }
                  }
                },
                "parquet_files": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": { "type": "string", "description": "Absolute file path" },
                      "partition_key": { "type": "string", "description": "Partition identifier (e.g., 'date=2024-01-01')" },
                      "row_count": { "type": "integer" },
                      "file_size_bytes": { "type": "integer" }
                    }
                  },
                  "description": "List of generated Parquet files with metadata"
                },
                "api_metrics": {
                  "type": "object",
                  "description": "API integration performance metrics",
                  "properties": {
                    "provider_used": {
                      "type": "string",
                      "enum": ["alpaca", "polygon", "yahoo"],
                      "description": "Primary provider that successfully returned data"
                    },
                    "fallback_attempts": {
                      "type": "integer",
                      "description": "Number of fallback attempts before success"
                    },
                    "api_calls_total": {
                      "type": "integer",
                      "description": "Total API requests made (including retries)"
                    },
                    "response_time_ms": {
                      "type": "number",
                      "description": "Average response time in milliseconds"
                    },
                    "rate_limit_remaining": {
                      "type": "integer",
                      "description": "Remaining API quota after operation"
                    }
                  }
                },
                "data_models_created": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "model_name": { "type": "string" },
                      "file_path": { "type": "string" },
                      "table_name": { "type": "string" },
                      "fields_count": { "type": "integer" }
                    }
                  },
                  "description": "SQLAlchemy models created (create_data_models operation)"
                }
              }
            }
          },
          "required": ["status", "agent", "task_id", "operation_type", "summary", "confidence", "agent_specific_output", "execution_timestamp"],
          "additionalProperties": false
        },
        {
          "title": "Market Data Specialist Failure",
          "properties": {
            "status": { "const": "FAILURE" },
            "agent": { "const": "market-data-specialist" },
            "task_id": { "type": "string" },
            "operation_type": {
              "enum": [
                "validate_ohlcv",
                "fetch_market_data",
                "compress_dataset",
                "create_data_models",
                "quality_check"
              ]
            },
            "summary": {
              "type": "string",
              "description": "1-3 sentence summary of why operation failed"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Confidence level in failure analysis"
            },
            "execution_timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 UTC timestamp from orchestrator"
            },
            "failure_details": {
              "type": "object",
              "description": "Market data specialist failure information",
              "properties": {
                "failure_type": {
                  "type": "string",
                  "enum": [
                    "data_quality_failure",
                    "api_integration_failure",
                    "compression_failure",
                    "validation_failure",
                    "schema_violation",
                    "file_io_error",
                    "network_error",
                    "rate_limit_exceeded"
                  ],
                  "description": "Primary category of failure"
                },
                "reasons": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Specific reasons why operation failed"
                },
                "invalid_records": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "record_index": { "type": "integer" },
                      "record_data": { "type": "object" },
                      "violation_type": {
                        "type": "string",
                        "enum": ["missing_field", "consistency_violation", "type_error", "out_of_range"]
                      },
                      "violation_details": { "type": "string" }
                    }
                  },
                  "description": "Sample of invalid records (max 10) for manual review"
                },
                "consistency_violations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "rule": { "type": "string" },
                      "affected_records": { "type": "integer" },
                      "severity": { "type": "string", "enum": ["critical", "major", "minor"] },
                      "sample_violations": {
                        "type": "array",
                        "items": { "type": "object" },
                        "description": "Sample records violating this rule (max 3)"
                      }
                    }
                  },
                  "description": "Consistency check violations grouped by rule"
                },
                "api_errors": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "provider": { "type": "string", "enum": ["alpaca", "polygon", "yahoo"] },
                      "error_code": { "type": "string" },
                      "error_message": { "type": "string" },
                      "http_status": { "type": "integer" },
                      "fallback_status": { "type": "string", "enum": ["attempted", "failed", "not_attempted"] },
                      "retry_count": { "type": "integer" }
                    }
                  },
                  "description": "API integration errors encountered during fetch"
                },
                "recovery_guidance": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Recommended actions to resolve failure (e.g., 'Quarantine invalid records to temp/', 'Retry with fallback provider', 'Manual review required')"
                },
                "manual_review_required": {
                  "type": "boolean",
                  "description": "Whether human intervention is needed to resolve failure"
                },
                "quarantine_path": {
                  "type": "string",
                  "description": "Path where invalid records were quarantined for review"
                },
                "partial_results": {
                  "type": "object",
                  "description": "Any partial work completed before failure (e.g., valid records processed, files written)"
                }
              },
              "required": ["failure_type", "reasons", "recovery_guidance"]
            }
          },
          "required": ["status", "agent", "task_id", "operation_type", "summary", "confidence", "failure_details", "execution_timestamp"],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["input", "output"]
}
