{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sentiment-nlp-specialist.schema.json",
  "version": "1.0.0",
  "title": "Sentiment NLP Specialist Schema",
  "description": "Input/output schema for FinBERT sentiment analysis, aggregation, burst detection, and theme extraction operations",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "description": "Unique identifier for the task"
        },
        "operation_type": {
          "type": "string",
          "enum": [
            "analyze_sentiment",
            "aggregate_sentiment",
            "detect_bursts",
            "extract_themes"
          ],
          "description": "Type of sentiment analysis operation to perform"
        },
        "headlines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "description": "News headline text to analyze"
              },
              "symbol": {
                "type": "string",
                "pattern": "^[A-Z]{1,5}$",
                "description": "Stock symbol associated with headline"
              },
              "timestamp": {
                "type": "string",
                "format": "date-time",
                "description": "ISO 8601 UTC timestamp when headline was published"
              },
              "source": {
                "type": "string",
                "description": "News source identifier (e.g., 'reuters', 'bloomberg', 'alpaca-news')"
              },
              "url": {
                "type": "string",
                "format": "uri",
                "description": "Optional URL to full article"
              }
            },
            "required": ["text", "symbol", "timestamp", "source"]
          },
          "minItems": 1,
          "description": "List of news headlines with metadata for analysis"
        },
        "aggregation_params": {
          "type": "object",
          "description": "Parameters for sentiment aggregation (aggregate_sentiment operation)",
          "properties": {
            "time_bucket": {
              "type": "string",
              "enum": ["1min", "5min", "15min", "1hour", "1day"],
              "default": "1hour",
              "description": "Time window for aggregating sentiment scores"
            },
            "weighting_method": {
              "type": "string",
              "enum": ["recency", "volume", "equal"],
              "default": "recency",
              "description": "Method for weighting sentiment scores during aggregation"
            },
            "normalization": {
              "type": "boolean",
              "default": true,
              "description": "Whether to apply z-score normalization (zS, zΔS)"
            },
            "lookback_periods": {
              "type": "integer",
              "minimum": 5,
              "maximum": 100,
              "default": 20,
              "description": "Number of periods for calculating moving statistics"
            }
          }
        },
        "burst_params": {
          "type": "object",
          "description": "Parameters for burst detection (detect_bursts operation)",
          "properties": {
            "volume_threshold": {
              "type": "number",
              "minimum": 1.5,
              "maximum": 5.0,
              "default": 2.0,
              "description": "Multiplier above baseline to trigger volume burst (e.g., 2.0 = 2x normal volume)"
            },
            "sentiment_shift_threshold": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 1.0,
              "default": 0.3,
              "description": "Absolute change in sentiment score to trigger shift alert"
            },
            "baseline_window": {
              "type": "string",
              "enum": ["1hour", "4hour", "1day", "1week"],
              "default": "1day",
              "description": "Window for calculating baseline volume/sentiment"
            }
          }
        },
        "theme_params": {
          "type": "object",
          "description": "Parameters for theme extraction (extract_themes operation)",
          "properties": {
            "max_themes": {
              "type": "integer",
              "minimum": 3,
              "maximum": 20,
              "default": 10,
              "description": "Maximum number of themes to extract"
            },
            "min_frequency": {
              "type": "integer",
              "minimum": 2,
              "maximum": 10,
              "default": 3,
              "description": "Minimum headline count for a theme to be reported"
            },
            "extraction_method": {
              "type": "string",
              "enum": ["keyword", "ngram", "topic_model"],
              "default": "keyword",
              "description": "Method for theme extraction (keyword for MVP, topic_model for Alpha)"
            }
          }
        },
        "config": {
          "type": "object",
          "description": "Model and processing configuration",
          "properties": {
            "model_name": {
              "type": "string",
              "default": "ProsusAI/finbert",
              "description": "HuggingFace model identifier for sentiment analysis"
            },
            "confidence_threshold": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0,
              "default": 0.6,
              "description": "Minimum confidence score to accept sentiment classification"
            },
            "batch_size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64,
              "default": 16,
              "description": "Number of headlines to process in parallel"
            },
            "max_length": {
              "type": "integer",
              "minimum": 64,
              "maximum": 512,
              "default": 128,
              "description": "Maximum token length for input text"
            },
            "device": {
              "type": "string",
              "enum": ["cpu", "cuda", "mps", "auto"],
              "default": "auto",
              "description": "Compute device for model inference"
            },
            "use_cache": {
              "type": "boolean",
              "default": true,
              "description": "Whether to cache model outputs for identical inputs"
            }
          }
        },
        "execution_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp from orchestrator (mandatory)"
        }
      },
      "required": ["task_id", "operation_type", "headlines", "execution_timestamp"],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "oneOf": [
        {
          "title": "Sentiment Analysis Success",
          "properties": {
            "status": { "const": "SUCCESS" },
            "agent": { "const": "sentiment-nlp-specialist" },
            "task_id": { "type": "string" },
            "operation_type": {
              "enum": ["analyze_sentiment", "aggregate_sentiment", "detect_bursts", "extract_themes"]
            },
            "summary": {
              "type": "string",
              "description": "1-3 sentence executive summary of sentiment analysis results"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Overall confidence in sentiment analysis results"
            },
            "execution_timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 UTC timestamp from orchestrator"
            },
            "agent_specific_output": {
              "type": "object",
              "description": "Sentiment analysis results (structure varies by operation_type)",
              "oneOf": [
                {
                  "title": "Analyze Sentiment Output",
                  "properties": {
                    "sentiment_scores": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "headline_id": {
                            "type": "string",
                            "description": "Unique identifier for headline (hash or index)"
                          },
                          "text": {
                            "type": "string",
                            "description": "Original headline text"
                          },
                          "symbol": {
                            "type": "string",
                            "description": "Stock symbol"
                          },
                          "timestamp": {
                            "type": "string",
                            "format": "date-time",
                            "description": "Headline publication timestamp"
                          },
                          "sentiment": {
                            "type": "object",
                            "properties": {
                              "label": {
                                "type": "string",
                                "enum": ["positive", "negative", "neutral"],
                                "description": "Sentiment classification"
                              },
                              "polarity": {
                                "type": "number",
                                "minimum": -1.0,
                                "maximum": 1.0,
                                "description": "Sentiment polarity score (-1 = very negative, +1 = very positive)"
                              },
                              "confidence": {
                                "type": "number",
                                "minimum": 0.0,
                                "maximum": 1.0,
                                "description": "Model confidence in classification"
                              },
                              "scores": {
                                "type": "object",
                                "properties": {
                                  "positive": { "type": "number", "minimum": 0, "maximum": 1 },
                                  "negative": { "type": "number", "minimum": 0, "maximum": 1 },
                                  "neutral": { "type": "number", "minimum": 0, "maximum": 1 }
                                },
                                "description": "Raw probability scores for all classes"
                              }
                            },
                            "required": ["label", "polarity", "confidence", "scores"]
                          },
                          "source": {
                            "type": "string",
                            "description": "News source identifier"
                          }
                        },
                        "required": ["headline_id", "text", "symbol", "timestamp", "sentiment", "source"]
                      },
                      "description": "Individual sentiment scores for each headline"
                    },
                    "processing_stats": {
                      "type": "object",
                      "properties": {
                        "total_headlines": { "type": "integer" },
                        "successful_analyses": { "type": "integer" },
                        "failed_analyses": { "type": "integer" },
                        "avg_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                        "processing_time_ms": { "type": "number" },
                        "batch_count": { "type": "integer" }
                      },
                      "required": ["total_headlines", "successful_analyses", "processing_time_ms"]
                    }
                  },
                  "required": ["sentiment_scores", "processing_stats"]
                },
                {
                  "title": "Aggregate Sentiment Output",
                  "properties": {
                    "aggregated_scores": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "symbol": {
                            "type": "string",
                            "description": "Stock symbol"
                          },
                          "time_bucket": {
                            "type": "string",
                            "format": "date-time",
                            "description": "Start of time bucket"
                          },
                          "sentiment": {
                            "type": "object",
                            "properties": {
                              "raw_score": {
                                "type": "number",
                                "minimum": -1.0,
                                "maximum": 1.0,
                                "description": "Weighted average sentiment score"
                              },
                              "zS": {
                                "type": "number",
                                "description": "Z-score normalized sentiment (0 = neutral relative to baseline)"
                              },
                              "zΔS": {
                                "type": "number",
                                "description": "Z-score of sentiment change (momentum indicator)"
                              },
                              "avg_confidence": {
                                "type": "number",
                                "minimum": 0.0,
                                "maximum": 1.0,
                                "description": "Average confidence across headlines in bucket"
                              }
                            },
                            "required": ["raw_score", "zS", "zΔS", "avg_confidence"]
                          },
                          "volume": {
                            "type": "integer",
                            "description": "Number of headlines in time bucket"
                          },
                          "source_distribution": {
                            "type": "object",
                            "additionalProperties": {
                              "type": "integer"
                            },
                            "description": "Headline count per source"
                          }
                        },
                        "required": ["symbol", "time_bucket", "sentiment", "volume"]
                      },
                      "description": "Symbol-level aggregated sentiment scores"
                    },
                    "normalization_params": {
                      "type": "object",
                      "properties": {
                        "mean": { "type": "number" },
                        "std_dev": { "type": "number" },
                        "lookback_periods": { "type": "integer" },
                        "baseline_window": { "type": "string" }
                      },
                      "description": "Parameters used for z-score normalization"
                    }
                  },
                  "required": ["aggregated_scores", "normalization_params"]
                },
                {
                  "title": "Detect Bursts Output",
                  "properties": {
                    "bursts_detected": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "symbol": { "type": "string" },
                          "timestamp": {
                            "type": "string",
                            "format": "date-time",
                            "description": "When burst was detected"
                          },
                          "burst_type": {
                            "type": "string",
                            "enum": ["volume_spike", "sentiment_shift", "combined"],
                            "description": "Type of burst detected"
                          },
                          "metrics": {
                            "type": "object",
                            "properties": {
                              "volume_multiplier": {
                                "type": "number",
                                "description": "Current volume / baseline volume"
                              },
                              "sentiment_change": {
                                "type": "number",
                                "minimum": -2.0,
                                "maximum": 2.0,
                                "description": "Change in sentiment score"
                              },
                              "baseline_volume": { "type": "number" },
                              "current_volume": { "type": "integer" },
                              "baseline_sentiment": { "type": "number" },
                              "current_sentiment": { "type": "number" }
                            }
                          },
                          "significance": {
                            "type": "string",
                            "enum": ["high", "medium", "low"],
                            "description": "Significance level of burst"
                          },
                          "headline_samples": {
                            "type": "array",
                            "items": { "type": "string" },
                            "maxItems": 5,
                            "description": "Sample headlines from burst period"
                          }
                        },
                        "required": ["symbol", "timestamp", "burst_type", "metrics", "significance"]
                      },
                      "description": "List of detected volume/sentiment bursts"
                    },
                    "baseline_stats": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "avg_volume": { "type": "number" },
                          "avg_sentiment": { "type": "number" },
                          "std_dev_sentiment": { "type": "number" }
                        }
                      },
                      "description": "Baseline statistics per symbol used for burst detection"
                    }
                  },
                  "required": ["bursts_detected", "baseline_stats"]
                },
                {
                  "title": "Extract Themes Output",
                  "properties": {
                    "themes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "theme_id": {
                            "type": "string",
                            "description": "Unique identifier for theme"
                          },
                          "label": {
                            "type": "string",
                            "description": "Human-readable theme label"
                          },
                          "keywords": {
                            "type": "array",
                            "items": { "type": "string" },
                            "description": "Keywords representing theme"
                          },
                          "headline_count": {
                            "type": "integer",
                            "description": "Number of headlines matching theme"
                          },
                          "symbols": {
                            "type": "array",
                            "items": { "type": "string" },
                            "description": "Symbols associated with theme"
                          },
                          "avg_sentiment": {
                            "type": "number",
                            "minimum": -1.0,
                            "maximum": 1.0,
                            "description": "Average sentiment for headlines in theme"
                          },
                          "time_range": {
                            "type": "object",
                            "properties": {
                              "start": { "type": "string", "format": "date-time" },
                              "end": { "type": "string", "format": "date-time" }
                            },
                            "description": "Time range when theme was active"
                          },
                          "sample_headlines": {
                            "type": "array",
                            "items": { "type": "string" },
                            "maxItems": 3,
                            "description": "Representative headlines for theme"
                          }
                        },
                        "required": ["theme_id", "label", "keywords", "headline_count", "avg_sentiment"]
                      },
                      "description": "Extracted themes with metadata"
                    },
                    "extraction_method": {
                      "type": "string",
                      "enum": ["keyword", "ngram", "topic_model"],
                      "description": "Method used for theme extraction"
                    }
                  },
                  "required": ["themes", "extraction_method"]
                }
              ]
            },
            "metadata": {
              "type": "object",
              "properties": {
                "model_version": {
                  "type": "string",
                  "description": "FinBERT model identifier used"
                },
                "processing_time_ms": {
                  "type": "number",
                  "description": "Total processing time in milliseconds"
                },
                "batch_stats": {
                  "type": "object",
                  "properties": {
                    "total_batches": { "type": "integer" },
                    "avg_batch_time_ms": { "type": "number" },
                    "max_batch_time_ms": { "type": "number" }
                  }
                },
                "device_used": {
                  "type": "string",
                  "enum": ["cpu", "cuda", "mps"],
                  "description": "Compute device used for inference"
                },
                "cache_hits": {
                  "type": "integer",
                  "description": "Number of cached results used"
                }
              },
              "required": ["model_version", "processing_time_ms", "device_used"]
            }
          },
          "required": [
            "status",
            "agent",
            "task_id",
            "operation_type",
            "summary",
            "confidence",
            "execution_timestamp",
            "agent_specific_output",
            "metadata"
          ],
          "additionalProperties": false
        },
        {
          "title": "Sentiment Analysis Failure",
          "properties": {
            "status": { "const": "FAILURE" },
            "agent": { "const": "sentiment-nlp-specialist" },
            "task_id": { "type": "string" },
            "operation_type": {
              "enum": ["analyze_sentiment", "aggregate_sentiment", "detect_bursts", "extract_themes"]
            },
            "summary": {
              "type": "string",
              "description": "Summary of why sentiment analysis operation failed"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Confidence level in failure analysis"
            },
            "execution_timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 UTC timestamp from orchestrator"
            },
            "failure_details": {
              "type": "object",
              "properties": {
                "failure_type": {
                  "type": "string",
                  "enum": [
                    "model_load_error",
                    "inference_timeout",
                    "invalid_input",
                    "resource_exhausted",
                    "batch_processing_error",
                    "normalization_error",
                    "insufficient_data",
                    "device_error"
                  ],
                  "description": "Primary type of failure"
                },
                "reasons": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Specific reasons why sentiment analysis failed"
                },
                "error_details": {
                  "type": "object",
                  "properties": {
                    "error_message": { "type": "string" },
                    "error_code": { "type": "string" },
                    "stacktrace": { "type": "string" },
                    "failed_batch_index": { "type": "integer" },
                    "failed_headline_indices": {
                      "type": "array",
                      "items": { "type": "integer" }
                    }
                  },
                  "description": "Detailed error information"
                },
                "recovery_suggestions": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Suggested approaches to resolve failure",
                  "examples": [
                    "Reduce batch_size from 32 to 16",
                    "Retry with keyword-based sentiment fallback",
                    "Reload model with device='cpu'",
                    "Filter headlines with length > max_length",
                    "Increase lookback_periods for normalization",
                    "Use cached results for partial retry"
                  ]
                },
                "partial_results": {
                  "type": "object",
                  "properties": {
                    "processed_count": {
                      "type": "integer",
                      "description": "Number of headlines successfully processed before failure"
                    },
                    "sentiment_scores": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "headline_id": { "type": "string" },
                          "sentiment": { "type": "object" }
                        }
                      },
                      "description": "Partial sentiment results if batch partially processed"
                    },
                    "processing_progress": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "description": "Percentage of work completed before failure (0.0-1.0)"
                    }
                  },
                  "description": "Partial results if batch partially processed"
                },
                "fallback_available": {
                  "type": "boolean",
                  "description": "Whether keyword-based fallback sentiment is available"
                },
                "retry_recommended": {
                  "type": "boolean",
                  "description": "Whether retry is likely to succeed with adjusted parameters"
                }
              },
              "required": ["failure_type", "reasons", "recovery_suggestions"]
            },
            "metadata": {
              "type": "object",
              "properties": {
                "model_version": { "type": "string" },
                "processing_time_before_failure_ms": { "type": "number" },
                "device_attempted": { "type": "string" },
                "batch_config": {
                  "type": "object",
                  "properties": {
                    "batch_size": { "type": "integer" },
                    "max_length": { "type": "integer" }
                  }
                }
              },
              "description": "Metadata about failure context"
            }
          },
          "required": [
            "status",
            "agent",
            "task_id",
            "operation_type",
            "summary",
            "confidence",
            "execution_timestamp",
            "failure_details"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["input", "output"]
}
