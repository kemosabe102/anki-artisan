{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "data-validator.schema.json",
  "title": "Data Validator Schema",
  "description": "Input/output contract for data-validator agent - audits daily news collection quality",
  "type": "object",
  "oneOf": [
    { "$ref": "#/definitions/SuccessResponse" },
    { "$ref": "#/definitions/FailureResponse" }
  ],
  "definitions": {
    "SuccessResponse": {
      "type": "object",
      "required": ["status", "audit_date", "data_quality_score", "grade", "category_coverage", "events_audited", "breakdown", "recommendations"],
      "properties": {
        "status": { "const": "SUCCESS" },
        "audit_date": {
          "type": "string",
          "format": "date",
          "description": "Audit date in YYYY-MM-DD format"
        },
        "data_quality_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Composite quality score (0-100)"
        },
        "grade": {
          "type": "string",
          "enum": ["A", "B", "C", "D", "F"],
          "description": "Quality grade (A: 90+, B: 80-89, C: 70-79, D: 60-69, F: <60)"
        },
        "category_coverage": { "$ref": "#/definitions/CategoryCoverage" },
        "categories_covered": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "categories_total": {
          "const": 5
        },
        "missing_categories": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["geopolitical", "health", "regulatory", "macro", "tech"]
          }
        },
        "events_audited": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of events validated"
        },
        "low_confidence_risks": {
          "type": "array",
          "items": { "$ref": "#/definitions/LowConfidenceRisk" }
        },
        "single_source_events": {
          "type": "array",
          "items": { "$ref": "#/definitions/SingleSourceEvent" }
        },
        "missing_escalation_history": {
          "type": "array",
          "items": { "$ref": "#/definitions/MissingEscalation" }
        },
        "recommendations": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Actionable improvement recommendations"
        },
        "breakdown": { "$ref": "#/definitions/ScoreBreakdown" },
        "breakdown_details": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Human-readable explanations for each score"
        }
      }
    },
    "FailureResponse": {
      "type": "object",
      "required": ["status", "failure_category", "error_details", "recovery_suggestions"],
      "properties": {
        "status": { "const": "FAILURE" },
        "failure_category": {
          "type": "string",
          "enum": ["no_data", "query_error", "invalid_date", "connection_failure", "schema_drift"]
        },
        "error_details": { "type": "string" },
        "recovery_suggestions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "CategoryCoverage": {
      "type": "object",
      "required": ["geopolitical", "health", "regulatory", "macro", "tech"],
      "properties": {
        "geopolitical": { "type": "boolean" },
        "health": { "type": "boolean" },
        "regulatory": { "type": "boolean" },
        "macro": { "type": "boolean" },
        "tech": { "type": "boolean" }
      }
    },
    "ScoreBreakdown": {
      "type": "object",
      "required": ["category_score", "confidence_score", "source_score", "severity_score", "escalation_score"],
      "properties": {
        "category_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 20,
          "description": "Category coverage score (0-20)"
        },
        "confidence_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 20,
          "description": "Confidence threshold score (0-20)"
        },
        "source_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 20,
          "description": "Multi-source confirmation score (0-20)"
        },
        "severity_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 20,
          "description": "Severity range validity score (0-20)"
        },
        "escalation_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 20,
          "description": "Escalation history completeness score (0-20)"
        }
      }
    },
    "LowConfidenceRisk": {
      "type": "object",
      "required": ["risk_id", "confidence", "reason", "recommendation"],
      "properties": {
        "risk_id": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
        "reason": { "type": "string" },
        "recommendation": { "type": "string" }
      }
    },
    "SingleSourceEvent": {
      "type": "object",
      "required": ["risk_id", "sources", "recommendation"],
      "properties": {
        "risk_id": { "type": "string" },
        "sources": { "type": "integer", "minimum": 1 },
        "recommendation": { "type": "string" }
      }
    },
    "MissingEscalation": {
      "type": "object",
      "required": ["risk_id", "stage", "recommendation"],
      "properties": {
        "risk_id": { "type": "string" },
        "stage": { "type": "string" },
        "recommendation": { "type": "string" }
      }
    },
    "AuditInput": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "format": "date",
          "description": "Audit date (YYYY-MM-DD), defaults to today"
        }
      }
    }
  }
}
