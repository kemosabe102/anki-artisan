{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "execution-modeler.schema.json",
  "title": "Execution Modeler Output Schema",
  "description": "Schema for execution-modeler agent outputs validating strategy viability under realistic trading conditions",
  "type": "object",
  "required": ["status", "execution_cost_bps", "cost_breakdown", "confidence", "stress_test_performed"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["VIABLE", "MARGINAL", "NOT_VIABLE", "FAILURE"],
      "description": "Viability verdict for the strategy"
    },
    "execution_cost_bps": {
      "type": "number",
      "minimum": 0,
      "description": "Total execution cost in basis points"
    },
    "cost_breakdown": {
      "type": "object",
      "required": ["slippage_estimate_bps", "market_impact_bps", "commission_bps"],
      "properties": {
        "slippage_estimate_bps": {
          "type": "number",
          "minimum": 0,
          "description": "Estimated slippage cost in basis points"
        },
        "market_impact_bps": {
          "type": "number",
          "minimum": 0,
          "description": "Market impact cost in basis points"
        },
        "commission_bps": {
          "type": "number",
          "minimum": 0,
          "description": "Commission cost in basis points"
        }
      },
      "additionalProperties": false
    },
    "impact_model_used": {
      "type": "string",
      "enum": ["linear", "square_root", "almgren_chriss"],
      "description": "Market impact model applied"
    },
    "sharpe_analysis": {
      "type": "object",
      "properties": {
        "sharpe_before_costs": {
          "type": "number",
          "description": "Strategy Sharpe before execution costs"
        },
        "sharpe_after_costs": {
          "type": "number",
          "description": "Strategy Sharpe after execution costs"
        },
        "degradation_pct": {
          "type": "number",
          "minimum": 0,
          "description": "Percentage degradation in Sharpe ratio"
        }
      },
      "additionalProperties": false
    },
    "sensitivity_analysis": {
      "type": "object",
      "required": ["stress_case"],
      "properties": {
        "base_case": {
          "type": "object",
          "properties": {
            "slippage_bps": { "type": "number" },
            "total_cost_bps": { "type": "number" },
            "sharpe": { "type": "number" }
          },
          "additionalProperties": true
        },
        "stress_case": {
          "type": "object",
          "properties": {
            "slippage_bps": { "type": "number" },
            "total_cost_bps": { "type": "number" },
            "sharpe": { "type": "number" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "stress_test_performed": {
      "type": "boolean",
      "description": "Whether mandatory +50% slippage stress test was executed"
    },
    "capacity_estimate_usd": {
      "type": "number",
      "minimum": 0,
      "description": "Maximum strategy capacity in USD before impact exceeds threshold"
    },
    "gates_passed": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["SLIPPAGE_ESTIMATE", "MARKET_IMPACT_MODEL", "SENSITIVITY_PASS"]
      },
      "description": "List of validation gates passed"
    },
    "recommendations": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Actionable recommendations for improving viability"
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "All assumptions made during estimation"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence score for the estimate (0.0-1.0)"
    },
    "error": {
      "type": "string",
      "description": "Error message when status is FAILURE"
    },
    "required_fields": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Missing required fields when status is FAILURE"
    },
    "recovery_guidance": {
      "type": "string",
      "description": "Guidance for recovering from FAILURE status"
    }
  },
  "additionalProperties": true,
  "if": {
    "properties": { "status": { "const": "VIABLE" } }
  },
  "then": {
    "required": ["gates_passed", "sensitivity_analysis"]
  }
}
