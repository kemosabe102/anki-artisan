{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "technical-indicator-specialist.schema.json",
  "version": "1.0.0",
  "title": "Technical Indicator Specialist Schema",
  "description": "Input/output schema for technical indicator computation, multi-timeframe feature engineering, and pandas optimization operations with two-state model (SUCCESS/FAILURE)",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "description": "Input schema for technical indicator computation operations",
      "properties": {
        "task_id": {
          "type": "string",
          "description": "Unique identifier for the computation task"
        },
        "operation_type": {
          "type": "string",
          "enum": ["compute_indicators", "engineer_features", "validate_indicators"],
          "description": "Type of technical indicator operation to perform"
        },
        "ticker": {
          "type": "string",
          "pattern": "^[A-Z]{1,5}$",
          "description": "Stock ticker symbol matching uppercase 1-5 character pattern (e.g., AAPL, SPY)"
        },
        "timeframe": {
          "type": "string",
          "description": "Pandas frequency string for OHLC aggregation (e.g., 1min, 5min, 1H, 1D)"
        },
        "indicators": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["ATR", "EMA", "RSI", "Donchian", "ADX", "OBV", "RVOL", "VWAP", "MFI"]
          },
          "minItems": 1,
          "description": "List of technical indicators to compute (subset of supported indicators)"
        },
        "data_source": {
          "type": "object",
          "description": "Source of OHLCV data for indicator computation",
          "oneOf": [
            {
              "properties": {
                "type": { "const": "parquet" },
                "path": {
                  "type": "string",
                  "description": "Absolute path to Parquet file containing OHLCV data"
                }
              },
              "required": ["type", "path"]
            },
            {
              "properties": {
                "type": { "const": "dataframe" },
                "data": {
                  "type": "string",
                  "description": "Base64-encoded pickled pandas DataFrame with OHLCV columns"
                }
              },
              "required": ["type", "data"]
            }
          ]
        },
        "lookback_period": {
          "type": "integer",
          "minimum": 5,
          "description": "Number of periods to use for indicator calculation (default varies by indicator: ATR=14, RSI=14, ADX=14, Donchian=20, EMA=20)"
        },
        "multi_timeframe": {
          "type": "boolean",
          "default": false,
          "description": "Enable OHLC+V batch aggregation across multiple timeframes"
        },
        "optimization_level": {
          "type": "string",
          "enum": ["standard", "aggressive"],
          "default": "standard",
          "description": "Vectorization vs memory trade-off strategy (standard=balanced, aggressive=max speed)"
        },
        "validation_mode": {
          "type": "boolean",
          "default": false,
          "description": "Compare computed indicators against golden datasets for accuracy verification"
        },
        "context": {
          "type": "string",
          "description": "Additional task context and instructions"
        },
        "execution_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp from orchestrator (mandatory)"
        }
      },
      "required": ["task_id", "operation_type", "ticker", "timeframe", "indicators", "data_source", "execution_timestamp"]
    },
    "output": {
      "type": "object",
      "oneOf": [
        {
          "title": "Technical Indicator Success Output",
          "properties": {
            "status": { "const": "SUCCESS" },
            "agent": { "const": "technical-indicator-specialist" },
            "task_id": {
              "type": "string",
              "description": "Task identifier matching input task_id"
            },
            "operation_type": {
              "type": "string",
              "enum": ["compute_indicators", "engineer_features", "validate_indicators"],
              "description": "Operation type from input"
            },
            "summary": {
              "type": "string",
              "description": "1-3 sentence summary of indicators computed and validation status"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Confidence in computation accuracy (base 0.90, penalties for missing data/insufficient history, bonus for validation)"
            },
            "execution_timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 UTC timestamp from orchestrator"
            },
            "agent_specific_output": {
              "type": "object",
              "description": "Technical indicator computation results",
              "properties": {
                "indicators_computed": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": ["ATR", "EMA", "RSI", "Donchian", "ADX", "OBV", "RVOL", "VWAP", "MFI"]
                  },
                  "description": "List of indicators successfully computed (may be subset if some failed)"
                },
                "timeframes_processed": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Timeframes included in output (e.g., ['1min', '5min', '1H'] for multi-timeframe mode)"
                },
                "data_points_processed": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Total number of OHLCV rows processed (input row count)"
                },
                "performance_metrics": {
                  "type": "object",
                  "description": "Computation performance statistics",
                  "properties": {
                    "computation_time_seconds": {
                      "type": "number",
                      "minimum": 0,
                      "description": "Total computation time in seconds (SLA: <1s for 10K rows, <5s for 100K rows)"
                    },
                    "memory_peak_mb": {
                      "type": "number",
                      "minimum": 0,
                      "description": "Peak memory usage in megabytes (limit: 200MB)"
                    },
                    "vectorization_ratio": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "description": "Fraction of computations using vectorized operations (target: >0.95)"
                    }
                  },
                  "required": ["computation_time_seconds", "memory_peak_mb", "vectorization_ratio"]
                },
                "validation_results": {
                  "type": "object",
                  "description": "Golden dataset validation metrics (when validation_mode=true)",
                  "properties": {
                    "indicators_validated": {
                      "type": "array",
                      "items": { "type": "string" },
                      "description": "Indicators compared against golden datasets"
                    },
                    "accuracy_vs_golden": {
                      "type": "object",
                      "description": "Statistical accuracy metrics",
                      "properties": {
                        "mean_absolute_error": {
                          "type": "number",
                          "minimum": 0,
                          "description": "MAE across all validated indicators (target: <0.01 for production)"
                        },
                        "max_absolute_error": {
                          "type": "number",
                          "minimum": 0,
                          "description": "Maximum single-period error (target: <0.05)"
                        },
                        "correlation_coefficient": {
                          "type": "number",
                          "minimum": -1,
                          "maximum": 1,
                          "description": "Pearson correlation with golden dataset (target: >0.99)"
                        }
                      },
                      "required": ["mean_absolute_error", "max_absolute_error", "correlation_coefficient"]
                    },
                    "edge_cases_handled": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": ["missing_data", "insufficient_history", "zero_volume", "extreme_values"]
                      },
                      "description": "Edge case types encountered and handled during validation"
                    }
                  },
                  "required": ["indicators_validated", "accuracy_vs_golden"]
                },
                "output_location": {
                  "type": "string",
                  "description": "Absolute path to output Parquet file with wide-format indicator data (OHLCV + indicator columns)"
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "indicator": {
                        "type": "string",
                        "description": "Indicator that triggered the warning"
                      },
                      "warning_type": {
                        "type": "string",
                        "enum": ["missing_data", "insufficient_history", "zero_volume", "extreme_values", "performance_degradation"],
                        "description": "Category of edge case encountered"
                      },
                      "rows_affected": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "Number of data rows impacted by this warning"
                      },
                      "message": {
                        "type": "string",
                        "description": "Human-readable warning description with context"
                      }
                    },
                    "required": ["indicator", "warning_type", "rows_affected", "message"]
                  },
                  "description": "Edge case warnings and data quality notifications"
                }
              },
              "required": [
                "indicators_computed",
                "timeframes_processed",
                "data_points_processed",
                "performance_metrics",
                "validation_results",
                "output_location",
                "warnings"
              ]
            }
          },
          "required": ["status", "agent", "task_id", "operation_type", "summary", "confidence", "execution_timestamp", "agent_specific_output"],
          "additionalProperties": false
        },
        {
          "title": "Technical Indicator Failure Output",
          "properties": {
            "status": { "const": "FAILURE" },
            "agent": { "const": "technical-indicator-specialist" },
            "task_id": {
              "type": "string",
              "description": "Task identifier matching input task_id"
            },
            "operation_type": {
              "type": "string",
              "enum": ["compute_indicators", "engineer_features", "validate_indicators"],
              "description": "Operation type attempted"
            },
            "summary": {
              "type": "string",
              "description": "1-3 sentence summary of why indicator computation failed"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Confidence in failure analysis and recovery suggestions"
            },
            "execution_timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 UTC timestamp from orchestrator"
            },
            "failure_details": {
              "type": "object",
              "description": "Detailed failure information and recovery guidance",
              "properties": {
                "failure_category": {
                  "type": "string",
                  "enum": ["data_source_error", "validation_error", "computation_error", "dependency_error"],
                  "description": "Primary category of failure (data_source_error=file not found/corrupted, validation_error=invalid inputs, computation_error=TA-Lib failure, dependency_error=missing packages)"
                },
                "error_context": {
                  "type": "object",
                  "description": "Contextual information about the failure",
                  "properties": {
                    "ticker": {
                      "type": "string",
                      "description": "Ticker symbol from failed request"
                    },
                    "timeframe": {
                      "type": "string",
                      "description": "Timeframe from failed request"
                    },
                    "failed_indicator": {
                      "type": "string",
                      "description": "Specific indicator that failed (null if all failed)"
                    },
                    "data_source_path": {
                      "type": "string",
                      "description": "Path to data source that caused failure (null if not file-related)"
                    },
                    "error_message": {
                      "type": "string",
                      "description": "Raw error message from underlying library or system"
                    },
                    "stack_trace_summary": {
                      "type": "string",
                      "description": "Sanitized summary of error stack trace (no full traces in user output)"
                    }
                  },
                  "required": ["ticker", "timeframe"]
                },
                "recovery_suggestions": {
                  "type": "array",
                  "items": { "type": "string" },
                  "minItems": 1,
                  "description": "Actionable steps to resolve the failure (e.g., 'Verify Parquet file exists at path', 'Install TA-Lib: uv add TA-Lib', 'Validate OHLCV schema includes required columns')"
                },
                "partial_results": {
                  "type": "object",
                  "description": "Partial computation results if some indicators succeeded",
                  "properties": {
                    "successfully_computed": {
                      "type": "array",
                      "items": { "type": "string" },
                      "description": "Indicators that computed successfully before failure"
                    },
                    "failed_indicators": {
                      "type": "array",
                      "items": { "type": "string" },
                      "description": "Indicators that failed to compute"
                    },
                    "partial_output_path": {
                      "type": "string",
                      "description": "Path to partial results Parquet file (null if no partial results available)"
                    }
                  },
                  "required": ["successfully_computed", "failed_indicators"]
                }
              },
              "required": ["failure_category", "error_context", "recovery_suggestions", "partial_results"]
            }
          },
          "required": ["status", "agent", "task_id", "operation_type", "summary", "confidence", "execution_timestamp", "failure_details"],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["input", "output"]
}
