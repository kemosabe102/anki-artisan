{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Portfolio Compliance Analyzer Schema",
  "description": "Agent schema for portfolio compliance analysis against Investment Policy Statement (IPS) constraints",
  "version": "1.0.0",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "description": "Input data for portfolio compliance analysis",
      "properties": {
        "context": {
          "type": "string",
          "description": "Orchestrator-provided task context"
        },
        "execution_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp from orchestrator"
        },
        "ips_document": {
          "oneOf": [
            {
              "type": "string",
              "description": "File path to IPS document (PDF/markdown/JSON)"
            },
            {
              "type": "object",
              "description": "Pre-parsed IPS structure",
              "properties": {
                "saa_targets": {
                  "type": "object",
                  "description": "Strategic Asset Allocation targets (asset class -> weight)",
                  "patternProperties": {
                    ".*": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                },
                "risk_budget": {
                  "type": "object",
                  "properties": {
                    "max_drawdown_pct": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "vol_target_pct": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "var_limit": { "type": "number" }
                  },
                  "required": ["max_drawdown_pct", "vol_target_pct"]
                },
                "rebalancing_bands": {
                  "type": "object",
                  "description": "Tolerance bands for allocation drift (asset class -> tolerance %)",
                  "patternProperties": {
                    ".*": { "type": "number", "minimum": 0, "maximum": 100 }
                  }
                },
                "tactical_sleeves": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": { "type": "string" },
                      "activation_rules": { "type": "object" },
                      "max_allocation_pct": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      }
                    },
                    "required": ["name", "max_allocation_pct"]
                  }
                },
                "investor_constraints": {
                  "type": "object",
                  "properties": {
                    "liquidity_min_pct": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "prohibited_securities": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "concentration_limits": { "type": "object" }
                  }
                }
              },
              "required": ["saa_targets", "risk_budget", "rebalancing_bands"]
            }
          ]
        },
        "current_holdings": {
          "type": "array",
          "description": "Array of current portfolio holdings",
          "items": {
            "type": "object",
            "properties": {
              "symbol": { "type": "string" },
              "quantity": { "type": "number", "minimum": 0, "exclusiveMinimum": true },
              "current_price": {
                "type": "number",
                "minimum": 0,
                "exclusiveMinimum": true
              },
              "cost_basis": {
                "oneOf": [
                  { "type": "number" },
                  {
                    "type": "array",
                    "description": "Lot-level cost basis for tax-loss harvesting",
                    "items": {
                      "type": "object",
                      "properties": {
                        "lot_id": { "type": "string" },
                        "quantity": { "type": "number", "minimum": 0 },
                        "cost_per_share": { "type": "number", "minimum": 0 },
                        "purchase_date": { "type": "string", "format": "date" }
                      },
                      "required": ["lot_id", "quantity", "cost_per_share"]
                    }
                  }
                ]
              },
              "purchase_date": { "type": "string", "format": "date" },
              "account_type": {
                "type": "string",
                "enum": ["taxable", "IRA", "Roth", "401k"]
              }
            },
            "required": ["symbol", "quantity", "current_price", "cost_basis", "account_type"]
          },
          "minItems": 1
        },
        "analysis_date": {
          "type": "string",
          "format": "date",
          "description": "Analysis reference date (YYYY-MM-DD)"
        },
        "market_data": {
          "type": "object",
          "description": "Optional market data (user-provided, NOT fetched by agent)",
          "properties": {
            "current_prices": {
              "type": "object",
              "description": "Symbol -> current price mapping",
              "patternProperties": {
                ".*": { "type": "number", "minimum": 0, "exclusiveMinimum": true }
              }
            },
            "historical_volatility": {
              "type": "object",
              "description": "Symbol -> annualized volatility mapping",
              "patternProperties": {
                ".*": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            },
            "correlation_matrix": {
              "type": "array",
              "description": "2D symmetric correlation matrix",
              "items": {
                "type": "array",
                "items": { "type": "number", "minimum": -1, "maximum": 1 }
              }
            }
          }
        },
        "analysis_mode": {
          "type": "string",
          "enum": ["comprehensive", "rebalancing_only", "tax_harvest_only", "compliance_check"],
          "default": "comprehensive",
          "description": "Determines which analysis modules to run"
        }
      },
      "required": [
        "context",
        "execution_timestamp",
        "ips_document",
        "current_holdings",
        "analysis_date"
      ]
    },
    "output": {
      "type": "object",
      "oneOf": [
        {
          "title": "Success Output",
          "properties": {
            "status": { "const": "SUCCESS" },
            "agent": { "const": "portfolio-compliance-analyzer" },
            "task_id": { "type": "string" },
            "operation_type": {
              "type": "string",
              "enum": [
                "portfolio_compliance_analysis",
                "rebalancing_analysis",
                "tax_harvest_analysis",
                "compliance_check"
              ]
            },
            "summary": {
              "type": "string",
              "description": "1-3 sentence executive summary"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Overall confidence in analysis quality"
            },
            "execution_timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "agent_specific_output": {
              "type": "object",
              "description": "Portfolio analysis results",
              "properties": {
                "gap_analysis": {
                  "type": "object",
                  "properties": {
                    "current_allocation": {
                      "type": "object",
                      "description": "Asset class -> current weight mapping",
                      "patternProperties": {
                        ".*": { "type": "number", "minimum": 0, "maximum": 1 }
                      }
                    },
                    "target_allocation": {
                      "type": "object",
                      "description": "Asset class -> SAA target weight mapping",
                      "patternProperties": {
                        ".*": { "type": "number", "minimum": 0, "maximum": 1 }
                      }
                    },
                    "allocation_drift": {
                      "type": "object",
                      "description": "Asset class -> drift in percentage points",
                      "patternProperties": {
                        ".*": { "type": "number" }
                      }
                    },
                    "drift_severity": {
                      "type": "string",
                      "enum": ["WITHIN_BANDS", "APPROACHING_LIMIT", "EXCEEDS_TOLERANCE"]
                    },
                    "risk_metrics_comparison": {
                      "type": "object",
                      "properties": {
                        "current_volatility": { "type": "number", "minimum": 0 },
                        "target_volatility": { "type": "number", "minimum": 0 },
                        "current_drawdown": { "type": "number" },
                        "max_drawdown_limit": { "type": "number", "minimum": 0 },
                        "var_estimate": { "type": "number" },
                        "var_limit": { "type": "number" }
                      },
                      "required": ["current_volatility", "current_drawdown"]
                    }
                  },
                  "required": [
                    "current_allocation",
                    "target_allocation",
                    "allocation_drift",
                    "drift_severity"
                  ]
                },
                "rebalancing_recommendations": {
                  "type": "object",
                  "properties": {
                    "trades": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "symbol": { "type": "string" },
                          "action": { "type": "string", "enum": ["BUY", "SELL"] },
                          "quantity": {
                            "type": "number",
                            "minimum": 0,
                            "exclusiveMinimum": true
                          },
                          "lot_id": { "type": ["string", "null"] },
                          "rationale": { "type": "string" },
                          "expected_impact_allocation": { "type": "number" }
                        },
                        "required": ["symbol", "action", "quantity", "rationale"]
                      }
                    },
                    "expected_post_trade_allocation": {
                      "type": "object",
                      "description": "Projected allocation after trades",
                      "patternProperties": {
                        ".*": { "type": "number", "minimum": 0, "maximum": 1 }
                      }
                    },
                    "estimated_transaction_costs": { "type": "number", "minimum": 0 },
                    "priority_ranking": {
                      "type": "array",
                      "items": { "type": "integer", "minimum": 0 },
                      "description": "Trade indices ordered by impact"
                    }
                  },
                  "required": ["trades", "expected_post_trade_allocation"]
                },
                "tax_optimization": {
                  "type": "object",
                  "properties": {
                    "harvest_opportunities": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "symbol": { "type": "string" },
                          "unrealized_loss": { "type": "number", "minimum": 0 },
                          "lot_id": { "type": "string" },
                          "cost_basis": { "type": "number" },
                          "current_value": { "type": "number" },
                          "purchase_date": { "type": "string", "format": "date" },
                          "replacement_candidates": {
                            "type": "array",
                            "items": { "type": "string" },
                            "description": "Symbols with correlation < 0.85 for wash-sale compliance"
                          }
                        },
                        "required": [
                          "symbol",
                          "unrealized_loss",
                          "lot_id",
                          "replacement_candidates"
                        ]
                      }
                    },
                    "projected_tax_savings": { "type": "number", "minimum": 0 },
                    "wash_sale_warnings": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "symbol": { "type": "string" },
                          "warning_type": {
                            "type": "string",
                            "enum": ["RECENT_PURCHASE", "PENDING_SALE"]
                          },
                          "conflict_date": { "type": "string", "format": "date" }
                        },
                        "required": ["symbol", "warning_type"]
                      }
                    },
                    "location_optimization_suggestions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "symbol": { "type": "string" },
                          "current_account": { "type": "string" },
                          "recommended_account": { "type": "string" },
                          "rationale": { "type": "string" }
                        },
                        "required": ["symbol", "current_account", "recommended_account"]
                      }
                    }
                  },
                  "required": [
                    "harvest_opportunities",
                    "projected_tax_savings",
                    "wash_sale_warnings"
                  ]
                },
                "tactical_sleeve_adjustments": {
                  "type": "object",
                  "properties": {
                    "sleeve_status": {
                      "type": "object",
                      "description": "Sleeve name -> status object",
                      "patternProperties": {
                        ".*": {
                          "type": "object",
                          "properties": {
                            "activation_status": {
                              "type": "string",
                              "enum": [
                                "ACTIVE",
                                "INACTIVE",
                                "PENDING_ACTIVATION",
                                "PENDING_DEACTIVATION"
                              ]
                            },
                            "current_risk_contribution": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 100
                            },
                            "target_risk_contribution": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 100
                            },
                            "trigger_conditions_met": { "type": "boolean" }
                          },
                          "required": ["activation_status", "trigger_conditions_met"]
                        }
                      }
                    },
                    "recommended_actions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "sleeve_name": { "type": "string" },
                          "action": {
                            "type": "string",
                            "enum": ["ACTIVATE", "DEACTIVATE", "RESIZE"]
                          },
                          "recommended_size": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100
                          },
                          "rationale": { "type": "string" }
                        },
                        "required": ["sleeve_name", "action", "rationale"]
                      }
                    }
                  },
                  "required": ["sleeve_status", "recommended_actions"]
                },
                "compliance_flags": {
                  "type": "object",
                  "properties": {
                    "risk_violations": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "constraint_type": {
                            "type": "string",
                            "enum": [
                              "MAX_DRAWDOWN",
                              "VOLATILITY_TARGET",
                              "VAR_LIMIT",
                              "CONCENTRATION"
                            ]
                          },
                          "current_value": { "type": "number" },
                          "limit_value": { "type": "number" },
                          "severity": {
                            "type": "string",
                            "enum": ["WARNING", "CRITICAL"]
                          }
                        },
                        "required": ["constraint_type", "current_value", "limit_value", "severity"]
                      }
                    },
                    "kill_switch_status": { "type": "boolean" },
                    "constraint_violations": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "constraint_type": {
                            "type": "string",
                            "enum": ["PROHIBITED_SECURITY", "LIQUIDITY_MIN", "ASSET_LOCATION"]
                          },
                          "affected_holdings": {
                            "type": "array",
                            "items": { "type": "string" }
                          },
                          "description": { "type": "string" }
                        },
                        "required": ["constraint_type", "description"]
                      }
                    }
                  },
                  "required": ["risk_violations", "kill_switch_status", "constraint_violations"]
                },
                "data_requirements": {
                  "type": "array",
                  "description": "Missing data requests (if critical data unavailable)",
                  "items": {
                    "type": "object",
                    "properties": {
                      "symbol": { "type": "string" },
                      "data_type": {
                        "type": "string",
                        "enum": ["CURRENT_PRICE", "HISTORICAL_VOLATILITY", "CORRELATION_DATA"]
                      },
                      "required_timeframe": { "type": "string" }
                    },
                    "required": ["symbol", "data_type"]
                  }
                },
                "summary_narrative": {
                  "type": "string",
                  "description": "3-5 sentence executive summary"
                },
                "analysis_metadata": {
                  "type": "object",
                  "properties": {
                    "analysis_date": { "type": "string", "format": "date-time" },
                    "execution_time_seconds": { "type": "number", "minimum": 0 },
                    "ips_version": { "type": "string" },
                    "holdings_count": { "type": "integer", "minimum": 0 },
                    "confidence_score": { "type": "number", "minimum": 0, "maximum": 1 }
                  },
                  "required": ["analysis_date", "holdings_count", "confidence_score"]
                }
              },
              "required": [
                "gap_analysis",
                "compliance_flags",
                "summary_narrative",
                "analysis_metadata"
              ]
            }
          },
          "required": ["status", "agent", "confidence", "agent_specific_output"],
          "additionalProperties": false
        },
        {
          "title": "Failure Output",
          "properties": {
            "status": { "const": "FAILURE" },
            "agent": { "const": "portfolio-compliance-analyzer" },
            "task_id": { "type": "string" },
            "operation_type": { "type": "string" },
            "summary": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "execution_timestamp": { "type": "string", "format": "date-time" },
            "failure_details": {
              "type": "object",
              "properties": {
                "failure_type": {
                  "type": "string",
                  "enum": [
                    "IPS_PARSE_ERROR",
                    "HOLDINGS_DATA_INVALID",
                    "MARKET_DATA_UNAVAILABLE",
                    "CALCULATION_ERROR",
                    "INSUFFICIENT_DATA",
                    "CONSTRAINT_VALIDATION_ERROR"
                  ]
                },
                "error_details": {
                  "type": "string",
                  "description": "Specific error message with line numbers/field names"
                },
                "recovery_suggestions": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Actionable remediation steps"
                },
                "partial_results": {
                  "type": "object",
                  "description": "Successfully completed analysis components (graceful degradation)",
                  "properties": {
                    "ips_constraints": { "type": "object" },
                    "gap_analysis": { "type": "object" },
                    "rebalancing_recommendations": { "type": "object" }
                  }
                },
                "validation_errors": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "field_name": { "type": "string" },
                      "expected_format": { "type": "string" },
                      "actual_value": { "type": "string" },
                      "validation_rule_violated": { "type": "string" }
                    },
                    "required": ["field_name", "validation_rule_violated"]
                  }
                }
              },
              "required": ["failure_type", "error_details", "recovery_suggestions"]
            }
          },
          "required": ["status", "agent", "confidence", "failure_details"],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["input", "output"]
}
