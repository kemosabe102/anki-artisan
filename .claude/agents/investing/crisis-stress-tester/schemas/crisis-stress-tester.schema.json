{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Crisis Stress Tester I/O Contract",
  "description": "HDD-compliant crisis resilience testing with temporal coverage validation and two-state output model",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "description": "Crisis stress tester input parameters",
      "properties": {
        "mode": {
          "enum": ["full_crisis_suite", "single_crisis", "tail_analysis", "synthetic_test"],
          "description": "Testing mode: full_crisis_suite runs all historical crises, single_crisis targets one period, tail_analysis focuses on extreme events, synthetic_test uses generated scenarios"
        },
        "hypothesis_id": {
          "type": "string",
          "pattern": "^HYP-[0-9]{3}$",
          "description": "REQUIRED: Unique hypothesis identifier (e.g., HYP-001)"
        },
        "strategy_spec": {
          "type": "object",
          "description": "Strategy specification from strategy-builder",
          "properties": {
            "inception_date": {
              "type": "string",
              "format": "date",
              "description": "Strategy inception date for temporal coverage calculation"
            }
          },
          "required": ["inception_date"]
        },
        "backtest_passed": {
          "type": "boolean",
          "description": "Whether the strategy passed backtesting validation gates (prerequisite for crisis testing)"
        },
        "crisis_period": {
          "enum": ["GFC_2008", "COVID_2020", "RATE_HIKE_2022", "FLASH_CRASH_2010"],
          "description": "Target crisis period for single_crisis mode"
        },
        "synthetic_params": {
          "type": "object",
          "description": "Parameters for synthetic_test mode",
          "properties": {
            "scenario_type": {
              "enum": ["correlation_spike", "liquidity_crisis", "volatility_explosion", "credit_freeze", "custom"],
              "description": "Type of synthetic crisis scenario to generate"
            },
            "correlation": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Cross-asset correlation level (0-1)"
            },
            "vix_level": {
              "type": "number",
              "minimum": 10,
              "maximum": 100,
              "description": "Simulated VIX level during crisis"
            },
            "spread_multiplier": {
              "type": "number",
              "minimum": 1,
              "maximum": 10,
              "description": "Multiplier for bid-ask spreads during crisis"
            },
            "duration_days": {
              "type": "integer",
              "minimum": 5,
              "maximum": 365,
              "description": "Duration of synthetic crisis in trading days"
            }
          }
        },
        "execution_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp from orchestrator (mandatory)"
        }
      },
      "required": ["mode", "hypothesis_id"]
    },
    "output": {
      "type": "object",
      "oneOf": [
        {
          "title": "Success Output",
          "properties": {
            "status": { "const": "SUCCESS" },
            "agent": {
              "type": "string",
              "const": "crisis-stress-tester",
              "description": "Agent identifier"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Confidence level in crisis analysis results"
            },
            "agent_specific_output": {
              "type": "object",
              "description": "Crisis stress tester specific output",
              "properties": {
                "hypothesis_id": {
                  "type": "string",
                  "pattern": "^HYP-[0-9]{3}$",
                  "description": "Echo of input hypothesis_id"
                },
                "overall_status": {
                  "enum": ["CRISIS_PROOF", "VULNERABLE", "FRAGILE"],
                  "description": "Aggregate crisis resilience status"
                },
                "overall_score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "Composite crisis resilience score (0-100)"
                },
                "crisis_results": {
                  "type": "object",
                  "description": "Results for each historical crisis period",
                  "properties": {
                    "gfc_2008": { "$ref": "#/definitions/crisis_result" },
                    "covid_2020": { "$ref": "#/definitions/crisis_result" },
                    "rate_hike_2022": { "$ref": "#/definitions/crisis_result" }
                  }
                },
                "tail_metrics": {
                  "type": "object",
                  "description": "Tail risk metrics from extreme event analysis",
                  "properties": {
                    "var_95": {
                      "type": "number",
                      "description": "Value at Risk at 95% confidence level"
                    },
                    "var_99": {
                      "type": "number",
                      "description": "Value at Risk at 99% confidence level"
                    },
                    "cvar_99": {
                      "type": "number",
                      "description": "Conditional VaR (Expected Shortfall) at 99% level"
                    },
                    "max_consecutive_losses": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Maximum consecutive losing days observed"
                    }
                  }
                },
                "soft_gate_results": {
                  "type": "object",
                  "description": "Results of soft validation gates (warnings, not failures)",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "passed": { "type": "boolean" },
                      "value": { "type": "number" },
                      "threshold": { "type": "number" },
                      "message": { "type": "string" }
                    }
                  }
                },
                "temporal_coverage_report": {
                  "type": "object",
                  "description": "Strategy temporal coverage analysis for crisis periods",
                  "properties": {
                    "strategy_inception_date": {
                      "type": "string",
                      "format": "date",
                      "description": "Date strategy data begins"
                    },
                    "covered_crises": {
                      "type": "array",
                      "items": {
                        "enum": ["GFC_2008", "COVID_2020", "RATE_HIKE_2022", "FLASH_CRASH_2010"]
                      },
                      "description": "Crisis periods the strategy has data coverage for"
                    },
                    "excluded_crises": {
                      "type": "array",
                      "items": {
                        "enum": ["GFC_2008", "COVID_2020", "RATE_HIKE_2022", "FLASH_CRASH_2010"]
                      },
                      "description": "Crisis periods excluded due to strategy inception date"
                    },
                    "coverage_percentage": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100,
                      "description": "Percentage of crisis periods covered (0-100)"
                    },
                    "confidence_discount": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "description": "Confidence discount factor applied due to limited coverage"
                    },
                    "validation_gate": {
                      "enum": ["FULL_COVERAGE", "PARTIAL_COVERAGE", "INSUFFICIENT_COVERAGE"],
                      "description": "Temporal coverage validation status"
                    }
                  },
                  "required": ["strategy_inception_date", "covered_crises", "excluded_crises", "coverage_percentage", "confidence_discount", "validation_gate"]
                },
                "verdict": {
                  "enum": ["CRISIS_PROOF", "VULNERABLE", "FRAGILE"],
                  "description": "Final crisis resilience verdict"
                },
                "recommendations": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Actionable recommendations based on crisis analysis"
                },
                "next_action": {
                  "type": "string",
                  "description": "Recommended next step in the workflow"
                }
              },
              "required": ["hypothesis_id", "overall_status", "overall_score", "crisis_results", "verdict", "recommendations", "next_action"]
            }
          },
          "required": ["status", "agent", "confidence", "agent_specific_output"],
          "additionalProperties": false
        },
        {
          "title": "Failure Output",
          "properties": {
            "status": { "const": "FAILURE" },
            "agent": {
              "type": "string",
              "const": "crisis-stress-tester",
              "description": "Agent identifier"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Confidence level in failure analysis"
            },
            "failure_details": {
              "type": "object",
              "description": "Detailed failure information",
              "properties": {
                "failure_type": {
                  "enum": [
                    "missing_hypothesis_id",
                    "backtest_not_passed",
                    "temporal_incompatibility",
                    "delegation_timeout",
                    "data_insufficient",
                    "invalid_crisis_period",
                    "invalid_synthetic_params"
                  ],
                  "description": "Primary failure classification"
                },
                "reasons": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Specific reasons for failure"
                },
                "recovery_suggestions": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Suggested approaches to resolve the failure"
                },
                "temporal_coverage": {
                  "$ref": "#/definitions/temporal_coverage",
                  "description": "Temporal coverage details if failure is coverage-related"
                }
              },
              "required": ["failure_type", "reasons", "recovery_suggestions"]
            }
          },
          "required": ["status", "agent", "confidence", "failure_details"],
          "additionalProperties": false
        }
      ]
    }
  },
  "definitions": {
    "crisis_result": {
      "type": "object",
      "description": "Performance metrics for a single crisis period",
      "properties": {
        "max_dd": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Maximum drawdown during crisis period (decimal, e.g., 0.25 = 25%)"
        },
        "benchmark_dd": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Benchmark (SPY) drawdown during same period"
        },
        "dd_ratio": {
          "type": "number",
          "description": "Strategy DD / Benchmark DD ratio (< 1.0 is favorable)"
        },
        "recovery_days": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Days to recover to pre-crisis high (null if not recovered)"
        },
        "period_sharpe": {
          "type": "number",
          "description": "Sharpe ratio during the crisis period"
        },
        "gate_status": {
          "enum": ["PASS", "FAIL"],
          "description": "Whether the crisis gate was passed"
        },
        "gate_threshold": {
          "type": "string",
          "description": "Human-readable gate threshold (e.g., 'DD ratio < 1.2')"
        }
      },
      "required": ["max_dd", "benchmark_dd", "dd_ratio", "gate_status", "gate_threshold"]
    },
    "temporal_coverage": {
      "type": "object",
      "description": "Temporal coverage analysis for strategy",
      "properties": {
        "strategy_inception_date": {
          "type": "string",
          "format": "date",
          "description": "Strategy inception date"
        },
        "covered_crises": {
          "type": "array",
          "items": {
            "enum": ["GFC_2008", "COVID_2020", "RATE_HIKE_2022", "FLASH_CRASH_2010"]
          },
          "description": "Crisis periods with data coverage"
        },
        "excluded_crises": {
          "type": "array",
          "items": {
            "enum": ["GFC_2008", "COVID_2020", "RATE_HIKE_2022", "FLASH_CRASH_2010"]
          },
          "description": "Crisis periods excluded due to inception date"
        },
        "coverage_percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Percentage of crisis periods covered"
        },
        "confidence_discount": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence discount due to limited coverage"
        },
        "validation_gate": {
          "enum": ["FULL_COVERAGE", "PARTIAL_COVERAGE", "INSUFFICIENT_COVERAGE"],
          "description": "Temporal coverage validation status"
        }
      },
      "required": ["strategy_inception_date", "covered_crises", "excluded_crises", "coverage_percentage", "confidence_discount", "validation_gate"]
    }
  },
  "required": ["input", "output"]
}
