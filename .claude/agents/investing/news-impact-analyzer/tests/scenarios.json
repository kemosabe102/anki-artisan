{
  "$schema": "./schemas/news-impact-analyzer.schema.json",
  "description": "Test scenarios for news-impact-analyzer agent",
  "version": "1.0.0",
  "created": "2026-01-04",
  "scenarios": [
    {
      "name": "happy_path_geopolitical_analysis",
      "description": "Standard news impact analysis for a date with geopolitical events in risk_off regime",
      "input": {
        "date": "2024-03-15",
        "category_filter": "geopolitical",
        "min_severity": 60
      },
      "mock_data": {
        "risk_sentiment": {
          "vix_inverse": 25,
          "fear_greed_index": 22,
          "hy_spread_normalized": 35,
          "put_call_ratio": 28,
          "sp500_vs_200dma": 40,
          "composite_score": 28,
          "recorded_at": "2024-03-15T09:30:00Z"
        },
        "structural_fragility": {
          "debt_cycle_phase": "LATE",
          "policy_bias": "TIGHTENING",
          "inflation_regime": "STAGFLATION",
          "recorded_at": "2024-03-14T00:00:00Z"
        },
        "attention_daily_events": [
          {
            "event_id": "geo-2024-0315-001",
            "category": "geopolitical",
            "headline": "China-Taiwan military exercises intensify",
            "severity": 72,
            "escalation_history": ["2024-03-01:55", "2024-03-08:62", "2024-03-15:72"],
            "sectors_affected": ["semiconductors", "technology", "shipping"],
            "recorded_at": "2024-03-15T06:00:00Z"
          },
          {
            "event_id": "geo-2024-0315-002",
            "category": "geopolitical",
            "headline": "Middle East oil transit disruption",
            "severity": 68,
            "escalation_history": ["2024-03-10:68"],
            "sectors_affected": ["energy", "transportation"],
            "recorded_at": "2024-03-15T08:00:00Z"
          }
        ],
        "historical_analogues": [
          {
            "date": "2022-08-02",
            "event": "Pelosi Taiwan visit tensions",
            "category": "geopolitical",
            "severity": 70,
            "impact_1w": -5.8
          },
          {
            "date": "2020-01-03",
            "event": "Soleimani assassination",
            "category": "geopolitical",
            "severity": 75,
            "impact_1w": -6.4
          },
          {
            "date": "2019-09-14",
            "event": "Saudi Aramco drone attack",
            "category": "geopolitical",
            "severity": 68,
            "impact_1w": -4.2
          }
        ]
      },
      "expected_behavior": {
        "status": "SUCCESS",
        "regime_classification": "risk_off",
        "regime_score_range": [25, 35],
        "regime_multiplier": 1.5,
        "fragility_calculation": {
          "debt_amp": 1.3,
          "policy_amp": 1.3,
          "inflation_amp": 1.4,
          "combined_fragility": 2.366,
          "capped_total_multiplier": 2.7,
          "note": "Total multiplier capped at 2.7 per impact-formula.md"
        },
        "events_analyzed": 2,
        "impact_predictions_count": 2,
        "first_event_validation": {
          "event_id": "geo-2024-0315-001",
          "escalation_status": "escalating",
          "escalation_adjustment": 1.2,
          "baseline_impact_approx": -5.47,
          "contagion_premium": 0.10,
          "adjusted_impact_range": [-19.5, -22.0],
          "scenario_probabilities": {
            "bear": 0.45,
            "base": 0.45,
            "bull": 0.10
          }
        }
      },
      "success_criteria": [
        "Returns status SUCCESS",
        "regime_context.classification equals risk_off",
        "regime_context.score between 25-35",
        "regime_context.multiplier equals 1.5",
        "regime_context.fragility_amplification between 2.3-2.4",
        "regime_context.total_multiplier capped at 2.7",
        "events_analyzed equals 2",
        "impact_predictions array has 2 elements",
        "First prediction escalation_status equals escalating",
        "First prediction escalation_adjustment equals 1.2",
        "First prediction contagion_premium equals 0.10",
        "Scenario probabilities sum to 1.0 within 0.05 tolerance",
        "Bear case probability elevated (0.40-0.50) due to risk_off + escalating",
        "All scenarios include 1d, 1w, 1m projections",
        "All scenarios include non-empty trigger strings",
        "Bear case 1m impact >= 1w impact (compounding rule)",
        "Bull case 1m impact minimal or positive (recovery rule)",
        "composite_metrics.msi_macro_shock_index between 60-80",
        "historical_analogues array has 3+ elements per prediction"
      ],
      "potential_failure_modes": [
        {
          "mode": "regime_multiplier_uncapped",
          "description": "Fragility amplification exceeds 2.7x cap",
          "detection": "total_multiplier > 2.7",
          "root_cause": "Missing cap logic in regime_multiplier calculation"
        },
        {
          "mode": "escalation_misclassification",
          "description": "Event with increasing severity history classified as stable/new",
          "detection": "escalation_status != escalating when history shows increasing trend",
          "root_cause": "Escalation pattern detection logic not parsing history array"
        },
        {
          "mode": "scenario_probability_drift",
          "description": "Bear/base/bull probabilities do not sum to ~1.0",
          "detection": "sum(probabilities) outside 0.95-1.05 range",
          "root_cause": "Regime and escalation adjustments applied incorrectly"
        },
        {
          "mode": "contagion_premium_overflow",
          "description": "Contagion premium exceeds 0.15 maximum",
          "detection": "contagion_premium > 0.15",
          "root_cause": "Sector count not bounded in contagion calculation"
        },
        {
          "mode": "historical_analogue_mismatch",
          "description": "Analogues from wrong category included in baseline",
          "detection": "analogue.category != event.category",
          "root_cause": "Category filter missing in historical query"
        }
      ]
    },
    {
      "name": "edge_case_empty_data_no_events",
      "description": "Edge case where requested date has no events matching criteria",
      "input": {
        "date": "2024-01-01",
        "category_filter": "regulatory",
        "min_severity": 80
      },
      "mock_data": {
        "risk_sentiment": {
          "vix_inverse": 65,
          "fear_greed_index": 58,
          "hy_spread_normalized": 70,
          "put_call_ratio": 55,
          "sp500_vs_200dma": 60,
          "composite_score": 62,
          "recorded_at": "2024-01-01T09:30:00Z"
        },
        "structural_fragility": {
          "debt_cycle_phase": "MID",
          "policy_bias": "NEUTRAL",
          "inflation_regime": "STABLE",
          "recorded_at": "2023-12-31T00:00:00Z"
        },
        "attention_daily_events": [],
        "historical_analogues": []
      },
      "expected_behavior": {
        "status": "SUCCESS",
        "regime_classification": "neutral",
        "regime_score_range": [60, 65],
        "regime_multiplier": 1.0,
        "fragility_calculation": {
          "debt_amp": 1.0,
          "policy_amp": 1.0,
          "inflation_amp": 1.0,
          "combined_fragility": 1.0,
          "total_multiplier": 1.0
        },
        "events_analyzed": 0,
        "impact_predictions_count": 0,
        "impact_predictions": [],
        "composite_metrics": {
          "msi_macro_shock_index": 0,
          "ssi_by_sector": {}
        },
        "note": "Empty predictions with regime_context only per error recovery spec"
      },
      "success_criteria": [
        "Returns status SUCCESS (not FAILURE)",
        "regime_context populated with valid classification",
        "regime_context.classification equals neutral",
        "events_analyzed equals 0",
        "impact_predictions is empty array []",
        "composite_metrics.msi_macro_shock_index equals 0",
        "No FAILURE status for empty events (valid edge case)",
        "Output validates against news-impact-analyzer.schema.json",
        "next_observation_points array may be empty or contain general market watch items"
      ],
      "potential_failure_modes": [
        {
          "mode": "empty_events_as_failure",
          "description": "Agent returns FAILURE instead of SUCCESS with empty predictions",
          "detection": "status equals FAILURE when events are simply empty",
          "root_cause": "Error handling treats no events as error condition"
        },
        {
          "mode": "missing_regime_context",
          "description": "regime_context omitted when no events exist",
          "detection": "regime_context is null or undefined",
          "root_cause": "Regime query skipped when no events found"
        },
        {
          "mode": "null_composite_metrics",
          "description": "composite_metrics null instead of zero values",
          "detection": "composite_metrics is null",
          "root_cause": "MSI/SSI calculation crashes on empty input"
        },
        {
          "mode": "division_by_zero_msi",
          "description": "MSI calculation divides by zero with no events",
          "detection": "msi_macro_shock_index is NaN or Infinity",
          "root_cause": "Missing zero-event guard in MSI formula"
        }
      ]
    },
    {
      "name": "error_handling_invalid_input",
      "description": "Error handling for invalid date format and missing required fields",
      "test_cases": [
        {
          "name": "invalid_date_format",
          "input": {
            "date": "03-15-2024",
            "category_filter": "geopolitical",
            "min_severity": 60
          },
          "expected_behavior": {
            "status": "FAILURE",
            "failure_category": "query_error",
            "error_details_contains": "Invalid date format",
            "recovery_suggestions": [
              "Use YYYY-MM-DD format for date parameter",
              "Example: 2024-03-15"
            ]
          },
          "success_criteria": [
            "Returns status FAILURE",
            "failure_category equals query_error",
            "error_details mentions date format",
            "recovery_suggestions array is non-empty",
            "No partial_results returned for input validation errors"
          ],
          "potential_failure_modes": [
            {
              "mode": "silent_date_parsing_failure",
              "description": "Invalid date silently parsed as different date",
              "detection": "analysis_date in response differs from input",
              "root_cause": "Lenient date parser auto-correcting invalid format"
            },
            {
              "mode": "generic_error_message",
              "description": "Error message does not identify date format issue",
              "detection": "error_details does not contain date or format",
              "root_cause": "Generic exception handling without specific validation"
            }
          ]
        },
        {
          "name": "invalid_category_enum",
          "input": {
            "date": "2024-03-15",
            "category_filter": "cryptocurrency",
            "min_severity": 60
          },
          "expected_behavior": {
            "status": "FAILURE",
            "failure_category": "query_error",
            "error_details_contains": "Invalid category",
            "recovery_suggestions": [
              "Valid categories: all, geopolitical, macro, health, regulatory, tech"
            ]
          },
          "success_criteria": [
            "Returns status FAILURE",
            "failure_category equals query_error",
            "error_details mentions invalid category",
            "recovery_suggestions lists valid category options"
          ],
          "potential_failure_modes": [
            {
              "mode": "category_silently_ignored",
              "description": "Invalid category treated as all",
              "detection": "status SUCCESS with events from all categories",
              "root_cause": "Missing enum validation, fallback to default"
            }
          ]
        },
        {
          "name": "severity_out_of_range",
          "input": {
            "date": "2024-03-15",
            "category_filter": "geopolitical",
            "min_severity": 150
          },
          "expected_behavior": {
            "status": "FAILURE",
            "failure_category": "query_error",
            "error_details_contains": "Severity must be between 0 and 100",
            "recovery_suggestions": [
              "Provide min_severity value between 0 and 100"
            ]
          },
          "success_criteria": [
            "Returns status FAILURE",
            "failure_category equals query_error",
            "error_details mentions severity range",
            "recovery_suggestions provides valid range"
          ],
          "potential_failure_modes": [
            {
              "mode": "severity_clamped_silently",
              "description": "Out-of-range severity clamped to 100 without error",
              "detection": "status SUCCESS when min_severity > 100",
              "root_cause": "Boundary clamping instead of validation"
            }
          ]
        },
        {
          "name": "database_connection_failure",
          "input": {
            "date": "2024-03-15",
            "category_filter": "geopolitical",
            "min_severity": 60
          },
          "mock_data": {
            "database_connection": "UNAVAILABLE"
          },
          "expected_behavior": {
            "status": "FAILURE",
            "failure_category": "connection_failure",
            "error_details_contains": "Database connection failed",
            "recovery_suggestions": [
              "Check database connectivity",
              "Verify connection string",
              "Retry in 30 seconds"
            ],
            "partial_results": null
          },
          "success_criteria": [
            "Returns status FAILURE",
            "failure_category equals connection_failure",
            "Fails fast with clear error message",
            "No partial_results returned (fail fast per spec)",
            "recovery_suggestions array is non-empty"
          ],
          "potential_failure_modes": [
            {
              "mode": "partial_results_on_connection_failure",
              "description": "Agent returns partial data despite connection failure",
              "detection": "partial_results is not null when connection fails",
              "root_cause": "Stale cache used instead of failing fast"
            },
            {
              "mode": "timeout_masking_connection_error",
              "description": "Connection failure reported as timeout",
              "detection": "failure_category equals query_error instead of connection_failure",
              "root_cause": "Generic exception handling not distinguishing error types"
            }
          ]
        },
        {
          "name": "stale_regime_data",
          "input": {
            "date": "2024-03-15",
            "category_filter": "all",
            "min_severity": 40
          },
          "mock_data": {
            "risk_sentiment": {
              "vix_inverse": 45,
              "fear_greed_index": 50,
              "hy_spread_normalized": 55,
              "put_call_ratio": 48,
              "sp500_vs_200dma": 52,
              "composite_score": 50,
              "recorded_at": "2024-03-01T09:30:00Z"
            },
            "structural_fragility": {
              "debt_cycle_phase": "MID",
              "policy_bias": "NEUTRAL",
              "inflation_regime": "STABLE",
              "recorded_at": "2024-02-20T00:00:00Z"
            },
            "data_age_days": {
              "risk_sentiment": 14,
              "structural_fragility": 24
            }
          },
          "expected_behavior": {
            "status": "SUCCESS",
            "regime_context": {
              "classification": "neutral",
              "data_freshness": {
                "risk_sentiment_age_days": 14,
                "fragility_age_days": 24
              }
            },
            "confidence_reduction": 0.6,
            "note": "Data older than 7 days triggers 0.6x confidence per error recovery spec"
          },
          "success_criteria": [
            "Returns status SUCCESS (stale data is warning, not failure)",
            "regime_context.data_freshness accurately reports age in days",
            "Confidence scores reduced by 0.6x factor",
            "All predictions have confidence <= 0.6",
            "Output includes freshness warning indicator"
          ],
          "potential_failure_modes": [
            {
              "mode": "stale_data_not_flagged",
              "description": "Old data used without freshness warning",
              "detection": "data_freshness fields missing or age reported as 0",
              "root_cause": "Freshness check not implemented"
            },
            {
              "mode": "confidence_not_reduced",
              "description": "Stale data used with full confidence",
              "detection": "Any prediction.confidence > 0.6 when data > 7 days old",
              "root_cause": "0.6x multiplier not applied to confidence scores"
            },
            {
              "mode": "stale_fragility_ignored",
              "description": "Fragility data age not tracked separately",
              "detection": "fragility_age_days missing when > 7 days",
              "root_cause": "Only risk_sentiment freshness checked"
            }
          ]
        }
      ]
    }
  ],
  "validation_notes": {
    "impact_formula": {
      "formula": "adjusted_impact = baseline_impact * regime_multiplier * escalation_adjustment * (1 + contagion_premium)",
      "component_sources": {
        "baseline_impact": "Historical analogues average from attention_daily",
        "regime_multiplier": "regime_base * fragility_amplification (capped at 2.7)",
        "escalation_adjustment": "1.2 if escalating, 0.85 if de-escalating, 1.0 otherwise",
        "contagion_premium": "0.05 per sector beyond primary (max 0.15)"
      }
    },
    "regime_thresholds": {
      "risk_off": "composite_score <= 30",
      "neutral": "30 < composite_score < 70",
      "risk_on": "composite_score >= 70"
    },
    "scenario_probability_defaults": {
      "bear": 0.25,
      "base": 0.55,
      "bull": 0.20
    },
    "scenario_adjustments": {
      "risk_off": {"bear": 0.10, "base": -0.05, "bull": -0.05},
      "escalating": {"bear": 0.10, "base": -0.05, "bull": -0.05}
    }
  }
}
