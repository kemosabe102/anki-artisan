{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Prompt Evaluator Agent Schema",
  "description": "Input/output schema for prompt-evaluator agent with comprehensive evaluation dimensions",
  "version": "1.0.0",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "description": "Input schema for agent evaluation requests",
      "properties": {
        "context": {
          "type": "string",
          "description": "Primary task context and evaluation instructions"
        },
        "agent_file_path": {
          "type": "string",
          "description": "Absolute path to agent markdown file (required)"
        },
        "schema_file_path": {
          "type": "string",
          "description": "Absolute path to agent-specific schema (optional)"
        },
        "evaluation_focus": {
          "type": "string",
          "enum": ["all", "prompt-engineering", "tokens", "testing", "structural"],
          "default": "all",
          "description": "Focus area for evaluation"
        },
        "execution_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp from orchestrator (mandatory)"
        }
      },
      "required": ["context", "agent_file_path", "execution_timestamp"]
    },
    "output": {
      "type": "object",
      "oneOf": [
        {
          "title": "Success Output",
          "properties": {
            "status": { "const": "SUCCESS" },
            "agent": { "const": "prompt-evaluator" },
            "task_id": { "type": "string" },
            "operation_type": { "const": "evaluate_agent" },
            "summary": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "execution_timestamp": { "type": "string", "format": "date-time" },
            "agent_specific_output": {
              "type": "object",
              "properties": {
                "evaluation_summary": {
                  "type": "object",
                  "properties": {
                    "agent_name": { "type": "string" },
                    "agent_version": { "type": "string" },
                    "maturity_level": { "type": "string", "enum": ["v0.x-MVP", "v1.x-Alpha", "v2.x-Beta", "v3.x-GA"] },
                    "overall_grade": { "type": "string", "enum": ["A", "B", "C", "D", "F"] },
                    "risk_level": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
                    "agent_type": { "type": "string", "enum": ["Manager", "Creator", "Reviewer", "Worker", "Analyzer", "Fixer", "Improver"] },
                    "evaluation_timestamp": { "type": "string", "format": "date-time" }
                  },
                  "required": ["agent_name", "overall_grade", "risk_level", "evaluation_timestamp"]
                },
                "structural_quality": {
                  "type": "object",
                  "properties": {
                    "score": { "type": "string", "pattern": "^\\d{1,2}/16$" },
                    "percentage": { "type": "number", "minimum": 0, "maximum": 100 },
                    "passing_criteria": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "criterion": { "type": "string" },
                          "evidence": { "type": "string" }
                        },
                        "required": ["criterion", "evidence"]
                      }
                    },
                    "failing_criteria": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "criterion": { "type": "string" },
                          "evidence": { "type": "string" },
                          "fix_guidance": { "type": "string" }
                        },
                        "required": ["criterion", "evidence", "fix_guidance"]
                      }
                    }
                  },
                  "required": ["score", "percentage", "passing_criteria", "failing_criteria"]
                },
                "prompt_engineering_quality": {
                  "type": "object",
                  "properties": {
                    "score": { "type": "number", "minimum": 0, "maximum": 9 },
                    "grade": { "type": "string", "enum": ["A", "B", "C", "D", "F"] },
                    "principle_scores": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "principle": { "type": "string" },
                          "score": { "type": "number", "minimum": 0, "maximum": 5 },
                          "evidence": { "type": "string" }
                        },
                        "required": ["principle", "score", "evidence"]
                      },
                      "minItems": 9, "maxItems": 9
                    },
                    "strengths": { "type": "array", "items": { "type": "string" } },
                    "weaknesses": { "type": "array", "items": { "type": "string" } }
                  },
                  "required": ["score", "grade", "principle_scores", "strengths", "weaknesses"]
                },
                "token_optimization": {
                  "type": "object",
                  "properties": {
                    "current_tokens": { "type": "number" },
                    "optimization_potential": { "type": "number" },
                    "optimization_percentage": { "type": "number", "minimum": 0, "maximum": 100 },
                    "priority_optimizations": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "technique": { "type": "string" },
                          "savings": { "type": "number" },
                          "effort": { "type": "string", "enum": ["low", "medium", "high"] },
                          "priority_score": { "type": "number", "minimum": 0, "maximum": 1 },
                          "implementation": { "type": "string" }
                        },
                        "required": ["technique", "savings", "effort", "implementation"]
                      }
                    }
                  },
                  "required": ["current_tokens", "optimization_potential", "optimization_percentage", "priority_optimizations"]
                },
                "testing_strategy": {
                  "type": "object",
                  "properties": {
                    "current_approach": { "type": "string" },
                    "required_approach": { "type": "string" },
                    "gaps": { "type": "array", "items": { "type": "string" } },
                    "recommended_actions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "action": { "type": "string" },
                          "priority": { "type": "string", "enum": ["critical", "major", "minor"] },
                          "framework": { "type": "string" }
                        },
                        "required": ["action", "priority"]
                      }
                    }
                  },
                  "required": ["current_approach", "required_approach", "gaps", "recommended_actions"]
                },
                "issues": {
                  "type": "object",
                  "properties": {
                    "critical": { "type": "array", "items": { "$ref": "#/definitions/issue" } },
                    "major": { "type": "array", "items": { "$ref": "#/definitions/issue" } },
                    "minor": { "type": "array", "items": { "$ref": "#/definitions/issue" } }
                  },
                  "required": ["critical", "major", "minor"]
                },
                "recommended_improvements": {
                  "type": "object",
                  "properties": {
                    "immediate_actions": { "type": "array", "items": { "$ref": "#/definitions/action" }, "maxItems": 3 },
                    "short_term_actions": { "type": "array", "items": { "$ref": "#/definitions/action" } },
                    "long_term_optimizations": { "type": "array", "items": { "type": "object", "properties": { "action": { "type": "string" }, "rationale": { "type": "string" } }, "required": ["action", "rationale"] } }
                  },
                  "required": ["immediate_actions", "short_term_actions", "long_term_optimizations"]
                },
                "anti_patterns_detected": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "pattern": { "type": "string" },
                      "severity": { "type": "string", "enum": ["critical", "major", "minor"] },
                      "locations": { "type": "array", "items": { "type": "string" } },
                      "fix": { "type": "string" }
                    },
                    "required": ["pattern", "severity", "locations", "fix"]
                  }
                },
                "confidence_scores": {
                  "type": "object",
                  "properties": {
                    "structural_evaluation": { "type": "number", "minimum": 0, "maximum": 1 },
                    "prompt_engineering": { "type": "number", "minimum": 0, "maximum": 1 },
                    "token_analysis": { "type": "number", "minimum": 0, "maximum": 1 },
                    "testing_assessment": { "type": "number", "minimum": 0, "maximum": 1 },
                    "overall_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
                  },
                  "required": ["structural_evaluation", "prompt_engineering", "token_analysis", "testing_assessment", "overall_confidence"]
                }
              },
              "required": ["evaluation_summary", "structural_quality", "prompt_engineering_quality", "token_optimization", "testing_strategy", "issues", "recommended_improvements", "anti_patterns_detected", "confidence_scores"]
            }
          },
          "required": ["status", "agent", "confidence", "agent_specific_output"],
          "additionalProperties": false
        },
        {
          "title": "Failure Output",
          "properties": {
            "status": { "const": "FAILURE" },
            "agent": { "const": "prompt-evaluator" },
            "task_id": { "type": "string" },
            "operation_type": { "const": "evaluate_agent" },
            "summary": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "execution_timestamp": { "type": "string", "format": "date-time" },
            "failure_details": {
              "type": "object",
              "properties": {
                "failure_type": { "type": "string", "enum": ["FILE_NOT_FOUND", "FILE_UNREADABLE", "INVALID_PATH", "SCHEMA_MISSING", "EVALUATION_INCOMPLETE", "GUIDE_UNAVAILABLE"] },
                "reasons": { "type": "array", "items": { "type": "string" } },
                "partial_results": {
                  "type": "object",
                  "properties": {
                    "completed_dimensions": { "type": "array", "items": { "type": "string" } },
                    "incomplete_dimensions": { "type": "array", "items": { "type": "string" } }
                  }
                },
                "recovery_suggestions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "suggestion": { "type": "string" },
                      "effort": { "type": "string", "enum": ["low", "medium", "high"] }
                    },
                    "required": ["suggestion", "effort"]
                  }
                }
              },
              "required": ["failure_type", "reasons"]
            }
          },
          "required": ["status", "agent", "confidence", "failure_details"],
          "additionalProperties": false
        }
      ]
    }
  },
  "definitions": {
    "issue": {
      "type": "object",
      "properties": {
        "issue": { "type": "string" },
        "evidence": { "type": "string" },
        "fix_guidance": { "type": "string" },
        "priority_score": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["issue", "evidence", "fix_guidance"]
    },
    "action": {
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "rationale": { "type": "string" },
        "impact": { "type": "string" },
        "priority_score": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["action", "rationale", "impact"]
    }
  },
  "required": ["input", "output"]
}
