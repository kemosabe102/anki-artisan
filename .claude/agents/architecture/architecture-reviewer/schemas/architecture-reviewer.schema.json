{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "architecture-reviewer.schema.json",
  "title": "Architecture Reviewer Output Schema",
  "description": "Schema for architecture-reviewer agent outputs",
  "allOf": [
    { "$ref": "../../../../docs/shared/schemas/base-agent.schema.json" }
  ],
  "properties": {
    "agent": { "const": "architecture-reviewer" },
    "operation_type": {
      "enum": ["architecture_review", "traceability_analysis", "stage_validation"]
    },
    "agent_specific_output": {
      "type": "object",
      "properties": {
        "technical_review_report": {
          "type": "object",
          "properties": {
            "review_id": {
              "type": "string",
              "pattern": "^TECH-REV-[0-9]{8}-[A-Z0-9]{6}$"
            },
            "overall_score": { "type": "number", "minimum": 0, "maximum": 5 },
            "stage": { "enum": ["MVP", "Alpha", "Beta", "RC", "GA"] },

            "framework_visibility": { "enum": ["explicit", "silent"] },
            "rubric": {
              "type": "object",
              "properties": {
                "architecture_soundness": { "$ref": "#/$defs/criterion" },
                "implementation_readiness": { "$ref": "#/$defs/criterion" },
                "production_readiness": { "$ref": "#/$defs/criterion" },
                "code_reuse_effectiveness": { "$ref": "#/$defs/criterion" },
                "integration_coherence": { "$ref": "#/$defs/criterion" },
                "cleanup_debt_reduction": { "$ref": "#/$defs/criterion" },
                "risk_mitigation": { "$ref": "#/$defs/criterion" },
                "standards_compliance": { "$ref": "#/$defs/criterion" }
              },
              "required": ["architecture_soundness", "implementation_readiness"]
            },
            "traceability": {
              "type": "object",
              "properties": {
                "coverage_pct": { "type": "number", "minimum": 0, "maximum": 100 },
                "missing_links": { "type": "array", "items": { "type": "string" } }
              }
            },
            "anti_patterns": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },

                  "where": { "type": "string" },
                  "severity": { "enum": ["low", "medium", "high"] }
                }
              }
            },
            "recommendations": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["review_id", "overall_score", "stage"]
        },
        "technical_edit_plan": {
          "type": "object",
          "properties": {
            "plan_id": {
              "type": "string",
              "pattern": "^TECH-EDIT-[0-9]{8}-[A-Z0-9]{6}$"
            },
            "review_id": { "type": "string" },
            "target_file": { "type": "string" },
            "enhancement_type": {
              "enum": ["technical_architecture", "api_specification", "integration_design", "performance_optimization"]
            },
            "patches": { "type": "array" },
            "replacements": { "type": "array" },
            "priority": { "enum": ["P1", "P2", "P3"] }
          },
          "required": ["plan_id", "priority"]
        }
      }
    },

    "failure_details": {
      "type": "object",
      "properties": {
        "failure_type": {
          "enum": ["missing_information", "validation_error", "research_failure", "stage_gate_failure"]
        },
        "missing_inputs": { "type": "array", "items": { "type": "string" } },
        "error_context": { "type": "string" },
        "recovery_suggestions": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 5 },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "improvements": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["score"]
    }
  }
}
