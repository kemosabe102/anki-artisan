{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "architecture-enhancer.schema.json",
  "version": "1.0.0",
  "title": "Architecture-Enhancer Agent Schema",
  "description": "Input/output schema for plan technical architecture enhancement operations with Context7 research validation",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "plan_file_path": {
          "type": "string",
          "description": "Path to existing plan file requiring technical architecture enhancement"
        },
        "context": {
          "type": "string",
          "description": "Technical enhancement requirements and focus areas"
        },
        "architecture_context": {
          "type": "object",
          "properties": {
            "system_type": {
              "enum": ["web_application", "api_service", "microservice", "data_pipeline"],
              "description": "Type of system being architected"
            },
            "tech_stack_preferences": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Preferred technologies and frameworks"
            },
            "performance_requirements": {
              "type": "object",
              "properties": {
                "response_time_ms": { "type": "number" },
                "throughput_rps": { "type": "number" },
                "availability_target": { "type": "string" }
              }
            },
            "integration_requirements": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Existing services and systems to integrate with"
            }
          },
          "required": ["system_type"]
        },
        "processing_mode": {
          "enum": ["technical_enhancement"],
          "default": "technical_enhancement",
          "description": "Processing mode for plan enhancement"
        },
        "validate_completion": {
          "type": "boolean",
          "default": true,
          "description": "Whether to validate technical placeholder completion"
        },
        "research_depth": {
          "enum": ["basic", "standard", "deep"],
          "default": "standard",
          "description": "Depth of Context7 research for architecture decisions"
        },
        "execution_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp from orchestrator (mandatory)"
        }
      },
      "required": ["plan_file_path", "context", "execution_timestamp"]
    },
    "output": {
      "type": "object",
      "oneOf": [
        {
          "title": "Enhancement Success",
          "properties": {
            "status": { "const": "SUCCESS" },
            "agent": { "const": "architecture-enhancer" },
            "task_id": { "type": "string" },
            "operation_type": { "const": "technical_architecture_enhancement" },
            "summary": {
              "type": "string",
              "description": "1-3 sentence summary of technical sections populated"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Confidence in technical enhancement quality"
            },
            "execution_timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 UTC timestamp from orchestrator"
            },
            "agent_specific_output": {
              "type": "object",
              "properties": {
                "file_path": {
                  "type": "string",
                  "description": "Path to enhanced plan file"
                },
                "file_modified": {
                  "type": "boolean",
                  "description": "Whether file was successfully modified"
                },
                "placeholders_before": {
                  "type": "number",
                  "description": "Count of technical placeholders before enhancement"
                },
                "placeholders_after": {
                  "type": "number",
                  "description": "Count of technical placeholders after enhancement (should be 0)"
                },
                "sections_enhanced": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "List of technical sections populated"
                },
                "edits_applied": {
                  "type": "number",
                  "description": "Number of file edits performed"
                },
                "research_sources_used": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "source_type": {
                        "enum": ["context7", "web_search", "component_almanac", "codebase"]
                      },
                      "library_id": { "type": "string" },
                      "topic": { "type": "string" },
                      "tokens_consumed": { "type": "number" }
                    },
                    "required": ["source_type"]
                  },
                  "description": "Research sources consulted for architecture decisions"
                },
                "architecture_decisions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "decision_area": { "type": "string" },
                      "choice_made": { "type": "string" },
                      "rationale": { "type": "string" },
                      "alternatives_considered": {
                        "type": "array",
                        "items": { "type": "string" }
                      },
                      "research_backed": { "type": "boolean" }
                    },
                    "required": ["decision_area", "choice_made", "rationale"]
                  },
                  "description": "Major architecture decisions made with rationale"
                },
                "technology_choices_made": {
                  "type": "object",
                  "description": "Technology stack selections with rationale",
                  "additionalProperties": { "type": "string" }
                },
                "architecture_patterns_applied": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Architecture patterns applied (e.g., Clean Architecture, CQRS)"
                },
                "context7_validations": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Context7-validated patterns and practices"
                },
                "cleanup_tasks_generated": {
                  "type": "boolean",
                  "description": "Whether cleanup tasks were generated for replaced components"
                },
                "code_reuse_documented": {
                  "type": "boolean",
                  "description": "Whether Component Almanac reuse opportunities were documented"
                }
              },
              "required": [
                "file_path",
                "file_modified",
                "placeholders_before",
                "placeholders_after",
                "sections_enhanced",
                "edits_applied",
                "research_sources_used",
                "architecture_decisions"
              ]
            },
            "validation_checklist": {
              "type": "object",
              "properties": {
                "checks_performed": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "all_checks_passed": { "type": "boolean" },
                "check_details": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "check": { "type": "string" },
                      "passed": { "type": "boolean" },
                      "details": { "type": "string" }
                    }
                  }
                }
              },
              "required": ["checks_performed", "all_checks_passed", "check_details"]
            }
          },
          "required": [
            "status",
            "agent",
            "task_id",
            "operation_type",
            "summary",
            "confidence",
            "execution_timestamp",
            "agent_specific_output",
            "validation_checklist"
          ],
          "additionalProperties": false
        },
        {
          "title": "Enhancement Failure",
          "properties": {
            "status": { "const": "FAILURE" },
            "agent": { "const": "architecture-enhancer" },
            "task_id": { "type": "string" },
            "operation_type": { "const": "technical_architecture_enhancement" },
            "summary": {
              "type": "string",
              "description": "1-3 sentence summary of why enhancement failed"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Confidence in failure analysis"
            },
            "execution_timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 UTC timestamp from orchestrator"
            },
            "failure_details": {
              "type": "object",
              "properties": {
                "failure_type": {
                  "enum": [
                    "missing_plan_file",
                    "context7_research_failed",
                    "edit_failure",
                    "no_technical_placeholders",
                    "validation_failure",
                    "component_almanac_unavailable"
                  ],
                  "description": "Primary type of failure"
                },
                "reasons": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Specific reasons why enhancement failed"
                },
                "research_attempted": {
                  "type": "object",
                  "properties": {
                    "context7_queries": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "web_searches": {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  }
                },
                "partial_results": {
                  "type": "object",
                  "properties": {
                    "sections_enhanced": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "placeholders_remaining": { "type": "number" }
                  }
                },
                "recovery_suggestions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "approach": { "type": "string" },
                      "rationale": { "type": "string" },
                      "estimated_effort": { "type": "string" }
                    }
                  },
                  "description": "Suggested approaches to resolve failure"
                }
              },
              "required": ["failure_type", "reasons", "recovery_suggestions"]
            },
            "validation_checklist": {
              "type": "object",
              "properties": {
                "checks_performed": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "all_checks_passed": { "type": "boolean" },
                "failed_checks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "check": { "type": "string" },
                      "reason": { "type": "string" }
                    }
                  }
                }
              },
              "required": ["checks_performed", "all_checks_passed", "failed_checks"]
            }
          },
          "required": [
            "status",
            "agent",
            "task_id",
            "operation_type",
            "summary",
            "confidence",
            "execution_timestamp",
            "failure_details",
            "validation_checklist"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["input", "output"]
}
