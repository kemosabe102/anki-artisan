{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ttrpg-campaign-architect.schema.json",
  "title": "TTRPG Campaign Architect Agent Schema",
  "description": "Schema for TTRPG campaign creation agent outputs - world building and story architecture",
  "type": "object",
  "required": ["status", "agent", "confidence"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["SUCCESS", "FAILURE"]
    },
    "agent": {
      "type": "string",
      "const": "ttrpg-campaign-architect"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "execution_timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "oneOf": [
    {
      "properties": {
        "status": { "const": "SUCCESS" },
        "agent_specific_output": { "$ref": "#/definitions/success_output" }
      },
      "required": ["status", "agent", "confidence", "agent_specific_output"]
    },
    {
      "properties": {
        "status": { "const": "FAILURE" },
        "failure_details": { "$ref": "#/definitions/failure_output" }
      },
      "required": ["status", "agent", "confidence", "failure_details"]
    }
  ],

  "definitions": {
    "success_output": {
      "type": "object",
      "required": ["creation_mode", "gm_notes", "consistency_check"],
      "properties": {
        "creation_mode": {
          "type": "string",
          "enum": ["world_building", "story_building", "both", "scamper_refine", "character_creation", "character_first"]
        },
        "world_elements": {
          "type": "object",
          "properties": {
            "setting": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "genre": { "type": "string" },
                "tone": { "type": "string" },
                "key_themes": { "type": "array", "items": { "type": "string" } },
                "brief_overview": { "type": "string" },
                "system_context": { "$ref": "#/definitions/system_context" }
              }
            },
            "geography": {
              "type": "array",
              "items": { "$ref": "#/definitions/geography_element" }
            },
            "creatures_species": {
              "type": "array",
              "items": { "$ref": "#/definitions/creature_element" }
            },
            "factions": {
              "type": "array",
              "items": { "$ref": "#/definitions/faction_element" }
            },
            "magic_systems": {
              "type": "array",
              "items": { "$ref": "#/definitions/magic_system" }
            }
          }
        },

        "story_ideas": {
          "type": "object",
          "description": "Brainstormed and ranked story concepts",
          "properties": {
            "ideas": {
              "type": "array",
              "items": { "$ref": "#/definitions/story_idea" },
              "minItems": 4,
              "maxItems": 8
            },
            "ranking_confirmed": { "type": "boolean" }
          }
        },
        "story_buckets": {
          "type": "object",
          "properties": {
            "early_game": { "$ref": "#/definitions/story_phase" },
            "mid_game": { "$ref": "#/definitions/story_phase" },
            "end_game": { "$ref": "#/definitions/story_phase" }
          }
        },
        "scamper_iterations": {
          "type": "array",
          "items": { "$ref": "#/definitions/scamper_iteration" }
        },
        "gm_notes": {
          "type": "object",
          "properties": {
            "session_zero_topics": { "type": "array", "items": { "type": "string" } },
            "pacing_recommendations": { "type": "array", "items": { "type": "string" } },
            "optional_expansions": { "type": "array", "items": { "type": "string" } },
            "consistency_reminders": { "type": "array", "items": { "type": "string" } }
          }
        },
        "consistency_check": {
          "type": "object",
          "properties": {
            "passed": { "type": "boolean" },
            "warnings": { "type": "array", "items": { "type": "string" } }
          }
        },
        "review": {
          "type": "object",
          "description": "Disney Creative Strategy validation results",
          "properties": {
            "dreamer": { "$ref": "#/definitions/review_check" },
            "realist": { "$ref": "#/definitions/review_check" },
            "critic": { "$ref": "#/definitions/review_check" },
            "overall": { "type": "string", "enum": ["ready", "refine_recommended"] },
            "top_suggestion": { "type": "string" }
          }
        },
        "characters": {
          "type": "array",
          "description": "Player characters with backstories",
          "items": { "$ref": "#/definitions/character_element" }
        },
        "party_dynamics": {
          "type": "object",
          "properties": {
            "bonds": {
              "type": "array",
              "items": { "$ref": "#/definitions/character_bond" }
            },
            "shared_secret": { "type": "string" },
            "party_flaw": { "type": "string" }
          }
        }
      }
    },
    "failure_output": {
      "type": "object",
      "required": ["failure_type", "reasons", "recovery_suggestions"],
      "properties": {
        "failure_type": {
          "type": "string",
          "enum": ["insufficient_seed", "creative_block", "consistency_failure"]
        },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "missing_inputs": { "type": "array", "items": { "type": "string" } },
        "recovery_suggestions": { "type": "array", "items": { "type": "string" } },
        "partial_results": { "type": "object" }
      }
    },

    "geography_element": {
      "type": "object",
      "required": ["name", "type", "description"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["region", "landmark", "route", "settlement"] },
        "description": { "type": "string" },
        "key_features": { "type": "array", "items": { "type": "string" } },
        "connections": { "type": "array", "items": { "type": "string" } }
      }
    },
    "creature_element": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["creature", "species", "race"] },
        "physical_traits": { "type": "array", "items": { "type": "string" } },
        "behaviors": { "type": "array", "items": { "type": "string" } },
        "habitats": { "type": "array", "items": { "type": "string" } },
        "cultural_significance": { "type": "string" },
        "system_stats": { "$ref": "#/definitions/system_stats" }
      }
    },
    "faction_element": {
      "type": "object",
      "required": ["name", "type", "goals"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["political", "religious", "mercantile", "criminal", "military", "other"] },
        "goals": { "type": "array", "items": { "type": "string" } },
        "resources": { "type": "array", "items": { "type": "string" } },
        "key_figures": { "type": "array", "items": { "type": "string" } },
        "relationships": {
          "type": "object",
          "properties": {
            "allies": { "type": "array", "items": { "type": "string" } },
            "enemies": { "type": "array", "items": { "type": "string" } },
            "neutral": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },

    "magic_system": {
      "type": "object",
      "required": ["name", "source"],
      "properties": {
        "name": { "type": "string" },
        "source": { "type": "string" },
        "costs": { "type": "array", "items": { "type": "string" } },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "societal_impact": { "type": "string" }
      }
    },
    "story_phase": {
      "type": "object",
      "properties": {
        "phase_summary": { "type": "string" },
        "sessions_estimate": { "type": "string" },
        "plot_hooks": { "type": "array", "items": { "$ref": "#/definitions/plot_point" } },
        "escalation_plots": { "type": "array", "items": { "$ref": "#/definitions/plot_point" } },
        "climactic_plots": { "type": "array", "items": { "$ref": "#/definitions/plot_point" } }
      }
    },
    "story_idea": {
      "type": "object",
      "description": "A brainstormed story concept with ranking",
      "required": ["content", "rank"],
      "properties": {
        "content": { "type": "string", "description": "The story idea or concept" },
        "rank": { "type": "integer", "minimum": 1, "maximum": 8, "description": "Impact ranking (1=best/climax, 2=hook, 3=mid-game)" },
        "rationale": { "type": "string", "description": "Why this ranking" },
        "placement": { "type": "string", "enum": ["early_game", "mid_game", "end_game", "supporting"], "description": "Strategic placement based on rank" }
      }
    },
    "plot_point": {
      "type": "object",
      "required": ["name", "type", "trigger", "key_elements"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["positive", "negative", "neutral"] },
        "trigger": { "type": "string" },
        "key_elements": { "type": "array", "items": { "type": "string" }, "minItems": 3, "maxItems": 5 },
        "potential_outcomes": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 3 },
        "builds_on": { "type": "array", "items": { "type": "string" } },
        "resolves": { "type": "array", "items": { "type": "string" } },
        "features_idea_rank": { "type": "integer", "description": "Which ranked idea this plot point features (1, 2, 3, etc.)" }
      }
    },
    "scamper_iteration": {
      "type": "object",
      "required": ["technique_used", "original_element", "transformed_element", "rationale"],
      "properties": {
        "technique_used": { "type": "string", "enum": ["Substitute", "Combine", "Adapt", "Modify", "Put to Other Uses", "Eliminate", "Reverse"] },
        "original_element": { "type": "object" },
        "transformed_element": { "type": "object" },
        "rationale": { "type": "string" },
        "improvement_assessment": { "type": "string" }
      }
    },
    "review_check": {
      "type": "object",
      "description": "Single lens of Disney Creative Strategy review",
      "required": ["verdict", "note"],
      "properties": {
        "verdict": { "type": "string", "enum": ["pass", "needs_work"] },
        "note": { "type": "string" }
      }
    },
    "character_element": {
      "type": "object",
      "description": "Player character with backstory",
      "required": ["name", "motivation"],
      "properties": {
        "name": { "type": "string" },
        "archetype": { "type": "string" },
        "background": {
          "type": "object",
          "properties": {
            "origin": { "type": "string" },
            "defining_moment": { "type": "string" },
            "faction_connection": { "type": "string" }
          }
        },
        "motivation": {
          "type": "object",
          "required": ["wants", "needs", "fears"],
          "properties": {
            "wants": { "type": "string" },
            "needs": { "type": "string" },
            "fears": { "type": "string" }
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "npc": { "type": "string" },
              "type": { "type": "string", "enum": ["ally", "rival", "complicated"] },
              "description": { "type": "string" }
            }
          }
        },
        "campaign_hooks": {
          "type": "object",
          "properties": {
            "early_game": { "type": "string" },
            "mid_game": { "type": "string" },
            "end_game": { "type": "string" }
          }
        },
        "system_stats": { "$ref": "#/definitions/system_stats" }
      }
    },
    "character_bond": {
      "type": "object",
      "description": "Relationship between two characters",
      "required": ["characters", "connection"],
      "properties": {
        "characters": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 },
        "connection": { "type": "string" },
        "tension": { "type": "string" },
        "growth": { "type": "string" }
      }
    },
    "system_context": {
      "type": "object",
      "description": "Optional game system information when user provides it",
      "properties": {
        "system_name": { "type": "string", "description": "Name of the game system (D&D 5e, Pathfinder 2e, custom, etc.)" },
        "source_type": { "type": "string", "enum": ["rulebook", "character_sheet", "verbal", "image", "custom"], "description": "How the system info was provided" },
        "key_mechanics": { "type": "array", "items": { "type": "string" }, "description": "Relevant rules that affect design" }
      }
    },
    "system_stats": {
      "type": "object",
      "description": "Optional system-specific stats for characters or creatures",
      "properties": {
        "class": { "type": "string" },
        "abilities": { "type": "string", "description": "Stat array or key abilities" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "equipment": { "type": "array", "items": { "type": "string" } },
        "challenge": { "type": "string", "description": "CR, Level, or equivalent" },
        "special_abilities": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
