{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Researcher-External Agent Schema",
  "description": "Schema for researcher-external agent outputs - unified external research combining library (Context7) and web (Perplexity) capabilities",
  "version": "1.0.0",
  "allOf": [
    {
      "$ref": "../../../../docs/shared/schemas/base-agent.schema.json"
    }
  ],
  "properties": {
    "output": {
      "type": "object",
      "oneOf": [
        {
          "title": "Success Output",
          "properties": {
            "status": { "const": "SUCCESS" },
            "agent": { "const": "researcher-external" },
            "task_id": { "type": "string" },
            "operation_type": {
              "type": "string",
              "enum": [
                "library_research",
                "web_research",
                "best_practice_discovery",
                "trade_off_analysis",
                "quick_lookup"
              ]
            },
            "summary": { "type": "string" },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "execution_timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "agent_specific_output": {
              "type": "object",
              "properties": {
                "research_mode": {
                  "type": "string",
                  "enum": ["library_mode", "web_mode", "analysis_mode", "quick_mode"],
                  "description": "Primary research mode used for this task"
                },
                "primary_source": {
                  "type": "string",
                  "enum": ["context7", "perplexity"],
                  "description": "Primary source used for findings"
                },
                "findings": {
                  "type": "object",
                  "properties": {
                    "key_patterns": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "pattern": { "type": "string" },
                          "description": { "type": "string" },
                          "confidence": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "sources": {
                            "type": "array",
                            "items": { "type": "string", "format": "uri" }
                          },
                          "source_type": {
                            "type": "string",
                            "enum": ["context7", "perplexity"],
                            "description": "Which research tool provided this pattern"
                          },
                          "example": { "type": "string" },
                          "applicability": { "type": "string" }
                        },
                        "required": ["pattern", "description", "confidence", "sources", "source_type"]
                      }
                    },
                    "api_signatures": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "signature": { "type": "string" },
                          "library": { "type": "string" },
                          "version": { "type": "string" },
                          "source": { "type": "string", "format": "uri" }
                        },
                        "required": ["signature", "library", "source"]
                      }
                    },
                    "compressed_synthesis": {
                      "type": "string",
                      "description": "Dense summary of all findings from both sources"
                    }
                  },
                  "required": ["key_patterns", "compressed_synthesis"]
                },
                "source_attribution": {
                  "type": "object",
                  "properties": {
                    "context7_sources": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "library_id": { "type": "string" },
                          "trust_score": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 10
                          },
                          "snippet_count": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "topics_queried": {
                            "type": "array",
                            "items": { "type": "string" }
                          }
                        },
                        "required": ["library_id", "trust_score", "snippet_count", "topics_queried"]
                      }
                    },
                    "web_sources": {
                      "type": "object",
                      "properties": {
                        "authoritative": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "url": { "type": "string", "format": "uri" },
                              "title": { "type": "string" },
                              "quality_score": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                              },
                              "accessed_date": {
                                "type": "string",
                                "format": "date-time"
                              }
                            },
                            "required": ["url", "title", "quality_score"]
                          }
                        },
                        "supporting": {
                          "type": "array",
                          "items": { "type": "string", "format": "uri" }
                        },
                        "rejected": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "url": { "type": "string", "format": "uri" },
                              "reason": { "type": "string" }
                            },
                            "required": ["url", "reason"]
                          }
                        }
                      },
                      "required": ["authoritative"]
                    }
                  }
                },
                "compression_stats": {
                  "type": "object",
                  "properties": {
                    "sources_evaluated": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "context7_queries": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "perplexity_queries": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "patterns_extracted": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "compression_ratio": { "type": "string" }
                  },
                  "required": [
                    "sources_evaluated",
                    "context7_queries",
                    "perplexity_queries",
                    "patterns_extracted",
                    "compression_ratio"
                  ],
                  "anyOf": [
                    { "properties": { "context7_queries": { "minimum": 1 } } },
                    { "properties": { "perplexity_queries": { "minimum": 1 } } }
                  ]
                },
                "research_boundaries": {
                  "type": "object",
                  "properties": {
                    "termination_reason": {
                      "type": "string",
                      "enum": [
                        "target_patterns_found",
                        "confidence_threshold_met",
                        "tool_budget_exhausted",
                        "diminishing_returns"
                      ]
                    },
                    "gaps": {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  },
                  "required": ["termination_reason"]
                },
                "iteration_support": {
                  "type": "object",
                  "description": "Support for orchestrator-driven iterative research when initial findings are incomplete",
                  "properties": {
                    "open_questions": {
                      "type": "array",
                      "description": "Questions that remain unanswered after research, triggering potential follow-up",
                      "items": {
                        "type": "object",
                        "properties": {
                          "question": {
                            "type": "string",
                            "description": "Specific unanswered question"
                          },
                          "context": {
                            "type": "string",
                            "description": "Why this question arose and what was found"
                          },
                          "priority": {
                            "type": "string",
                            "enum": ["high", "medium", "low"],
                            "description": "Importance for understanding the topic"
                          },
                          "suggested_approach": {
                            "type": "string",
                            "description": "How to research this further"
                          }
                        },
                        "required": ["question", "context", "priority"]
                      }
                    },
                    "confidence_breakdown": {
                      "type": "object",
                      "description": "Detailed confidence analysis for iteration decisions",
                      "properties": {
                        "overall_confidence": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1,
                          "description": "Overall confidence in findings"
                        },
                        "confidence_factors": {
                          "type": "object",
                          "properties": {
                            "source_quality": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            "coverage_completeness": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            "pattern_consensus": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          }
                        },
                        "low_confidence_rationale": {
                          "type": "array",
                          "description": "Reasons for confidence below 0.85 threshold",
                          "items": { "type": "string" }
                        },
                        "confidence_improvement_actions": {
                          "type": "array",
                          "description": "Specific steps to increase confidence",
                          "items": { "type": "string" }
                        }
                      },
                      "required": ["overall_confidence"]
                    }
                  }
                }
              },
              "required": [
                "research_mode",
                "primary_source",
                "findings",
                "source_attribution",
                "compression_stats",
                "research_boundaries"
              ]
            }
          },
          "required": ["status", "agent", "confidence", "agent_specific_output"]
        },
        {
          "title": "Failure Output",
          "properties": {
            "status": { "const": "FAILURE" },
            "agent": { "const": "researcher-external" },
            "task_id": { "type": "string" },
            "operation_type": {
              "type": "string",
              "enum": [
                "library_research",
                "web_research",
                "best_practice_discovery",
                "trade_off_analysis",
                "quick_lookup"
              ]
            },
            "summary": { "type": "string" },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "execution_timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "failure_details": {
              "type": "object",
              "properties": {
                "failure_type": {
                  "type": "string",
                  "enum": [
                    "insufficient_sources",
                    "context7_library_not_found",
                    "context7_quality_below_threshold",
                    "perplexity_rate_limited",
                    "fetch_failures",
                    "validation_error",
                    "zero_tool_calls"
                  ]
                },
                "reasons": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "research_attempted": {
                  "type": "object",
                  "properties": {
                    "context7_queries": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "perplexity_queries": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "fallback_chain_executed": {
                      "type": "boolean"
                    }
                  }
                },
                "partial_results": {
                  "type": "object",
                  "properties": {
                    "patterns_found": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "sources_accessed": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "recovery_suggestions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "approach": { "type": "string" },
                      "rationale": { "type": "string" }
                    },
                    "required": ["approach", "rationale"]
                  }
                }
              },
              "required": ["failure_type", "reasons"]
            }
          },
          "required": ["status", "agent", "confidence", "failure_details"]
        }
      ]
    }
  }
}
