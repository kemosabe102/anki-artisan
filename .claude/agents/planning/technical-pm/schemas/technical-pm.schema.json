{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "technical-pm.schema.json",
  "version": "2.1.0",
  "title": "Technical PM Plan Enhancement Schema",
  "description": "Input/output schema for technical project management plan file enhancement operations (NOT file creation)",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "context": {
          "type": "string",
          "description": "Primary instruction field defining what technical PM should accomplish"
        },
        "execution_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp from orchestrator (mandatory)"
        },
        "spec_file": {
          "type": "string",
          "description": "Path to SPEC.md file for strategic framework creation"
        },
        "existing_plans": {
          "type": "array",
          "items": { "type": "string" },
          "description": "REQUIRED: Existing PLAN.md files created by orchestrator that need business context enhancement",
          "minItems": 1
        },
        "operation_type": {
          "enum": [
            "plan_file_enhancement",
            "business_analysis",
            "nfr_analysis",
            "investigation_guidance"
          ],
          "description": "Type of technical PM operation to perform - primarily plan_file_enhancement"
        },
        "business_context": {
          "type": "object",
          "properties": {
            "business_goals": { "type": "array", "items": { "type": "string" } },
            "user_value_proposition": { "type": "string" },
            "success_metrics": { "type": "array", "items": { "type": "string" } },
            "constraints": { "type": "array", "items": { "type": "string" } }
          }
        },
        "requirements": {
          "type": "object",
          "properties": {
            "nfr_analysis_required": { "type": "boolean" },
            "business_context_preservation": { "type": "boolean" },
            "investigation_agenda_needed": { "type": "boolean" },
            "architecture_handoff_required": { "type": "boolean" }
          }
        }
      },
      "required": ["context", "execution_timestamp", "existing_plans"]
    },
    "output": {
      "type": "object",
      "oneOf": [
        {
          "title": "Technical PM Success",
          "properties": {
            "status": { "const": "SUCCESS" },
            "agent": { "const": "technical-pm" },
            "task_id": { "type": "string" },
            "operation_type": {
              "enum": [
                "plan_file_enhancement",
                "business_analysis",
                "nfr_analysis",
                "investigation_guidance"
              ]
            },
            "summary": {
              "type": "string",
              "description": "1-3 sentence executive summary of technical PM work completed"
            },
            "validation_checklist": {
              "type": "object",
              "properties": {
                "checks_performed": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "List of technical PM validation checks performed"
                },
                "all_checks_passed": {
                  "const": true,
                  "description": "Must be true for SUCCESS status"
                },
                "check_details": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "check_name": { "type": "string" },
                      "status": { "const": "passed" },
                      "evidence": { "type": "string" },
                      "validation_method": {
                        "enum": [
                          "business_context_validation",
                          "nfr_analysis",
                          "strategic_alignment",
                          "handoff_readiness"
                        ]
                      },
                      "score": { "type": "number", "minimum": 0, "maximum": 1 }
                    },
                    "required": ["check_name", "status", "evidence", "validation_method"]
                  }
                }
              },
              "required": ["checks_performed", "all_checks_passed", "check_details"]
            },
            "success_evidence": {
              "type": "object",
              "properties": {
                "operation_result": {
                  "type": "object",
                  "properties": {
                    "plan_enhancements": {
                      "type": "object",
                      "properties": {
                        "business_context": {
                          "type": "object",
                          "properties": {
                            "business_goals": {
                              "type": "array",
                              "items": { "type": "string" }
                            },
                            "user_value_proposition": { "type": "string" },
                            "success_metrics": {
                              "type": "array",
                              "items": { "type": "string" }
                            },
                            "stakeholder_impact": {
                              "type": "array",
                              "items": { "type": "string" }
                            },
                            "business_risks": {
                              "type": "array",
                              "items": { "type": "string" }
                            }
                          },
                          "required": [
                            "business_goals",
                            "user_value_proposition",
                            "success_metrics"
                          ]
                        },
                        "nfr_analysis": {
                          "type": "object",
                          "properties": {
                            "performance_requirements": {
                              "type": "object",
                              "properties": {
                                "response_time": { "type": "string" },
                                "throughput": { "type": "string" },
                                "scalability": { "type": "string" }
                              }
                            },
                            "security_requirements": {
                              "type": "object",
                              "properties": {
                                "authentication": { "type": "string" },
                                "authorization": { "type": "string" },
                                "data_protection": { "type": "string" }
                              }
                            },
                            "availability_requirements": {
                              "type": "object",
                              "properties": {
                                "uptime_target": { "type": "string" },
                                "disaster_recovery": { "type": "string" },
                                "backup_strategy": { "type": "string" }
                              }
                            },
                            "compliance_requirements": {
                              "type": "array",
                              "items": { "type": "string" }
                            }
                          }
                        },
                        "requirements_traceability": {
                          "type": "object",
                          "properties": {
                            "functional_requirements": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "fr_id": { "type": "string" },
                                  "description": { "type": "string" },
                                  "business_justification": { "type": "string" },
                                  "acceptance_criteria": {
                                    "type": "array",
                                    "items": { "type": "string" }
                                  }
                                },
                                "required": ["fr_id", "description", "business_justification"]
                              }
                            },
                            "nfr_mapping": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "requirement": { "type": "string" },
                                  "rationale": { "type": "string" },
                                  "measurement": { "type": "string" }
                                },
                                "required": ["requirement", "rationale"]
                              }
                            }
                          }
                        },
                        "investigation_agenda": {
                          "type": "object",
                          "properties": {
                            "research_areas": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "area": { "type": "string" },
                                  "questions": {
                                    "type": "array",
                                    "items": { "type": "string" }
                                  },
                                  "priority": {
                                    "enum": ["critical", "high", "medium", "low"]
                                  },
                                  "estimated_effort": {
                                    "enum": ["low", "medium", "high"]
                                  }
                                },
                                "required": ["area", "questions", "priority"]
                              }
                            },
                            "architecture_placeholders": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "component": { "type": "string" },
                                  "investigation_needed": { "type": "string" },
                                  "decision_criteria": {
                                    "type": "array",
                                    "items": { "type": "string" }
                                  }
                                },
                                "required": ["component", "investigation_needed"]
                              }
                            }
                          }
                        }
                      },
                      "required": [
                        "business_context",
                        "nfr_analysis",
                        "requirements_traceability",
                        "investigation_agenda"
                      ]
                    },
                    "files_enhanced": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "plan_file": { "type": "string" },
                          "enhancements_applied": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "section": { "type": "string" },
                                "enhancement_type": {
                                  "enum": [
                                    "business_context",
                                    "nfr_analysis",
                                    "requirements_mapping",
                                    "investigation_guidance"
                                  ]
                                },
                                "description": { "type": "string" },
                                "rationale": { "type": "string" }
                              },
                              "required": [
                                "section",
                                "enhancement_type",
                                "description",
                                "rationale"
                              ]
                            }
                          }
                        },
                        "required": ["plan_file", "enhancements_applied"]
                      }
                    },
                    "handoff_package": {
                      "type": "object",
                      "properties": {
                        "architecture_handoff_ready": { "type": "boolean" },
                        "business_context_preserved": { "type": "boolean" },
                        "investigation_agenda_complete": { "type": "boolean" },
                        "technical_placeholders_identified": { "type": "boolean" },
                        "handoff_notes": {
                          "type": "array",
                          "items": { "type": "string" }
                        }
                      },
                      "required": ["architecture_handoff_ready", "business_context_preserved"]
                    }
                  },
                  "required": ["plan_enhancements"]
                },
                "recommendations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "category": {
                        "enum": [
                          "business_strategy",
                          "requirements_management",
                          "risk_mitigation",
                          "stakeholder_management",
                          "technical_strategy"
                        ]
                      },
                      "priority": { "enum": ["critical", "high", "medium", "low"] },
                      "recommendation": { "type": "string" },
                      "rationale": { "type": "string" },
                      "business_impact": {
                        "enum": ["critical", "high", "medium", "low"]
                      },
                      "implementation_effort": {
                        "enum": ["low", "medium", "high", "very_high"]
                      }
                    },
                    "required": [
                      "category",
                      "priority",
                      "recommendation",
                      "rationale",
                      "business_impact"
                    ]
                  }
                },
                "next_actions": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "changes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": { "type": "string" },
                      "action": { "enum": ["create", "update", "delete"] },
                      "summary": { "type": "string" }
                    },
                    "required": ["path", "action"]
                  }
                }
              },
              "required": ["operation_result", "recommendations", "next_actions", "changes"]
            },
            "sources": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Research sources consulted during technical PM work"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Confidence level in the technical PM results"
            },
            "severity": {
              "enum": ["Critical", "Major", "Minor"],
              "description": "Severity level of any identified issues"
            },
            "execution_timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 UTC timestamp from orchestrator"
            }
          },
          "required": [
            "status",
            "agent",
            "task_id",
            "operation_type",
            "summary",
            "validation_checklist",
            "success_evidence",
            "confidence",
            "severity",
            "execution_timestamp"
          ],
          "additionalProperties": false
        },
        {
          "title": "Technical PM Failure",
          "properties": {
            "status": { "const": "FAILURE" },
            "agent": { "const": "technical-pm" },
            "task_id": { "type": "string" },
            "operation_type": {
              "enum": [
                "plan_file_enhancement",
                "business_analysis",
                "nfr_analysis",
                "investigation_guidance"
              ]
            },
            "summary": {
              "type": "string",
              "description": "Summary of why technical PM operation failed"
            },
            "validation_checklist": {
              "type": "object",
              "properties": {
                "checks_performed": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "List of validation checks attempted"
                },
                "all_checks_passed": {
                  "const": false,
                  "description": "Must be false for FAILURE status"
                },
                "failed_checks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "check_name": { "type": "string" },
                      "status": { "const": "failed" },
                      "reason": { "type": "string" },
                      "evidence": { "type": "string" },
                      "expected_criteria": { "type": "string" },
                      "actual_result": { "type": "string" }
                    },
                    "required": ["check_name", "status", "reason"]
                  },
                  "minItems": 1
                },
                "passed_checks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "check_name": { "type": "string" },
                      "status": { "const": "passed" },
                      "evidence": { "type": "string" }
                    },
                    "required": ["check_name", "status", "evidence"]
                  }
                }
              },
              "required": ["checks_performed", "all_checks_passed", "failed_checks"]
            },
            "failure_details": {
              "type": "object",
              "properties": {
                "failure_type": {
                  "enum": [
                    "missing_spec",
                    "missing_existing_plans",
                    "plan_file_not_found",
                    "validation_error",
                    "execution_error",
                    "business_context_incomplete",
                    "nfr_analysis_insufficient"
                  ],
                  "description": "Primary type of failure - missing_spec when SPEC.md not found, missing_existing_plans when orchestrator didn't provide plan files"
                },
                "reasons": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Specific reasons why technical PM work cannot be completed"
                },
                "missing": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Missing information, context, or business requirements needed"
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "error_code": { "type": "string" },
                      "message": { "type": "string" },
                      "hint": { "type": "string" },
                      "context": {
                        "type": "object",
                        "properties": {
                          "operation_phase": {
                            "enum": [
                              "initialization",
                              "plan_file_reading",
                              "business_analysis",
                              "nfr_analysis",
                              "requirements_mapping",
                              "investigation_planning",
                              "plan_enhancement"
                            ]
                          },
                          "failed_operation": { "type": "string" },
                          "business_context_details": {
                            "type": "object",
                            "properties": {
                              "missing_business_goals": { "type": "boolean" },
                              "unclear_value_proposition": { "type": "boolean" },
                              "insufficient_stakeholder_input": { "type": "boolean" }
                            }
                          }
                        }
                      }
                    },
                    "required": ["error_code", "message"]
                  }
                },
                "proposed_next_steps": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Actionable next steps to resolve the failure"
                },
                "research_attempted": {
                  "type": "object",
                  "properties": {
                    "business_research": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "nfr_standards": { "type": "array", "items": { "type": "string" } },
                    "industry_benchmarks": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "stakeholder_analysis": {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  }
                },
                "partial_results": {
                  "type": "object",
                  "description": "Any technical PM work completed before failure",
                  "properties": {
                    "business_context_partial": { "type": "object" },
                    "nfr_analysis_partial": { "type": "object" },
                    "requirements_identified": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "investigation_areas_identified": {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  }
                },
                "recovery_suggestions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "strategy": { "type": "string" },
                      "description": { "type": "string" },
                      "estimated_effort": { "enum": ["low", "medium", "high"] },
                      "success_probability": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "required": ["strategy", "description"]
                  }
                }
              },
              "required": ["failure_type", "reasons"]
            },
            "sources": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Sources researched before failure"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Confidence level in failure analysis"
            },
            "severity": {
              "enum": ["Critical", "Major", "Minor"],
              "description": "Severity level of the failure"
            },
            "execution_timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 UTC timestamp from orchestrator"
            }
          },
          "required": [
            "status",
            "agent",
            "task_id",
            "operation_type",
            "summary",
            "validation_checklist",
            "failure_details",
            "confidence",
            "severity",
            "execution_timestamp"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["input", "output"]
}
