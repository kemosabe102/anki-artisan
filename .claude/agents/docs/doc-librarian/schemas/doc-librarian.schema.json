{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Doc Librarian Agent Schema",
  "description": "Documentation health management agent for link validation, organization compliance, and naming enforcement",
  "version": "1.0.0",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "description": "Input schema for doc-librarian operations",
      "properties": {
        "context": {
          "type": "string",
          "description": "Operation description and requirements"
        },
        "operation_type": {
          "type": "string",
          "enum": ["check_health", "fix_links", "rename_files", "audit_organization"],
          "description": "Type of documentation operation to perform"
        },
        "scope": {
          "type": "string",
          "description": "Documentation scope (docs/**, .claude/docs/**, or specific path pattern)",
          "default": "docs/**"
        },
        "tier": {
          "type": "number",
          "enum": [1, 2, 3],
          "description": "Capability tier: 1=read-only, 2=automated fixes, 3=supervised restructuring",
          "default": 1
        },
        "include_external_links": {
          "type": "boolean",
          "description": "Whether to validate external links (slower)",
          "default": false
        },
        "auto_apply": {
          "type": "boolean",
          "description": "Automatically apply safe fixes without preview",
          "default": false
        },
        "execution_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp from orchestrator (mandatory)"
        }
      },
      "required": ["context", "operation_type", "execution_timestamp"]
    },
    "output": {
      "type": "object",
      "oneOf": [
        {
          "title": "Success Output",
          "properties": {
            "status": { "const": "SUCCESS" },
            "agent": {
              "type": "string",
              "const": "doc-librarian"
            },
            "task_id": {
              "type": "string",
              "description": "Unique task identifier"
            },
            "operation_type": {
              "type": "string",
              "enum": ["check_health", "fix_links", "rename_files", "audit_organization"]
            },
            "summary": {
              "type": "string",
              "description": "Executive summary with health score and key metrics"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Confidence in health assessment or fix success"
            },
            "execution_timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 UTC timestamp from orchestrator"
            },
            "agent_specific_output": {
              "type": "object",
              "properties": {
                "health_report": {
                  "type": "object",
                  "description": "Comprehensive documentation health assessment",
                  "properties": {
                    "health_score": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100,
                      "description": "Overall health score (weighted average of all metrics)"
                    },
                    "coverage_percentage": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100,
                      "description": "Percentage of documentation scanned successfully"
                    },
                    "link_health": {
                      "type": "object",
                      "properties": {
                        "total_links": {
                          "type": "number",
                          "description": "Total number of links found"
                        },
                        "valid_links": {
                          "type": "number",
                          "description": "Number of valid links"
                        },
                        "broken_links": {
                          "type": "number",
                          "description": "Number of broken links"
                        },
                        "link_health_percentage": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 100,
                          "description": "Percentage of valid links"
                        },
                        "broken_link_details": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "source_file": {
                                "type": "string",
                                "description": "File containing the broken link"
                              },
                              "line_number": {
                                "type": "number",
                                "description": "Line number of broken link"
                              },
                              "link_text": {
                                "type": "string",
                                "description": "Link display text"
                              },
                              "target_url": {
                                "type": "string",
                                "description": "Target URL or path that is broken"
                              },
                              "link_type": {
                                "type": "string",
                                "enum": ["internal", "external", "anchor"],
                                "description": "Type of link"
                              },
                              "error": {
                                "type": "string",
                                "description": "Error description (404, file not found, etc.)"
                              },
                              "severity": {
                                "type": "string",
                                "enum": ["critical", "high", "medium", "low"],
                                "description": "Violation severity"
                              }
                            },
                            "required": ["source_file", "target_url", "error", "severity"]
                          }
                        }
                      },
                      "required": [
                        "total_links",
                        "valid_links",
                        "broken_links",
                        "link_health_percentage"
                      ]
                    },
                    "organization_compliance": {
                      "type": "object",
                      "properties": {
                        "total_files": {
                          "type": "number",
                          "description": "Total documentation files scanned"
                        },
                        "compliant_files": {
                          "type": "number",
                          "description": "Files in correct locations"
                        },
                        "misplaced_files": {
                          "type": "number",
                          "description": "Files in incorrect locations"
                        },
                        "compliance_percentage": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 100,
                          "description": "Percentage of files in correct locations"
                        },
                        "violations": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "file": {
                                "type": "string",
                                "description": "Misplaced file path"
                              },
                              "current_location": {
                                "type": "string",
                                "description": "Current directory location"
                              },
                              "expected_location": {
                                "type": "string",
                                "description": "Expected directory per DOCS-MANAGEMENT.md"
                              },
                              "reason": {
                                "type": "string",
                                "description": "Why this file should be moved"
                              },
                              "content_type": {
                                "type": "string",
                                "description": "Document type (spec, feature, guide, etc.)"
                              },
                              "severity": {
                                "type": "string",
                                "enum": ["critical", "high", "medium", "low"],
                                "description": "Violation severity"
                              }
                            },
                            "required": ["file", "expected_location", "reason", "severity"]
                          }
                        }
                      },
                      "required": [
                        "total_files",
                        "compliant_files",
                        "misplaced_files",
                        "compliance_percentage"
                      ]
                    },
                    "naming_compliance": {
                      "type": "object",
                      "properties": {
                        "total_files": {
                          "type": "number",
                          "description": "Total files checked for naming"
                        },
                        "compliant_files": {
                          "type": "number",
                          "description": "Files following kebab-case.md convention"
                        },
                        "violations": {
                          "type": "number",
                          "description": "Files violating naming convention"
                        },
                        "compliance_percentage": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 100,
                          "description": "Percentage of compliant file names"
                        },
                        "violation_details": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "file": {
                                "type": "string",
                                "description": "File with naming violation"
                              },
                              "current_name": {
                                "type": "string",
                                "description": "Current file name"
                              },
                              "expected_name": {
                                "type": "string",
                                "description": "Compliant kebab-case name"
                              },
                              "violation_type": {
                                "type": "string",
                                "enum": [
                                  "spaces",
                                  "uppercase",
                                  "underscores",
                                  "special_chars",
                                  "mixed"
                                ],
                                "description": "Type of naming violation"
                              },
                              "is_exception": {
                                "type": "boolean",
                                "description": "Whether this is a valid exception (SPEC.md, etc.)"
                              },
                              "severity": {
                                "type": "string",
                                "enum": ["critical", "high", "medium", "low"],
                                "description": "Violation severity"
                              }
                            },
                            "required": [
                              "file",
                              "current_name",
                              "expected_name",
                              "violation_type",
                              "severity"
                            ]
                          }
                        }
                      },
                      "required": [
                        "total_files",
                        "compliant_files",
                        "violations",
                        "compliance_percentage"
                      ]
                    },
                    "cross_references": {
                      "type": "object",
                      "properties": {
                        "total_files": {
                          "type": "number",
                          "description": "Total files analyzed for cross-references"
                        },
                        "referenced_files": {
                          "type": "number",
                          "description": "Files with incoming references"
                        },
                        "orphaned_files": {
                          "type": "number",
                          "description": "Files with no incoming references"
                        },
                        "duplicate_content": {
                          "type": "number",
                          "description": "Files with suspected duplicate content"
                        },
                        "orphan_details": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "file": {
                                "type": "string",
                                "description": "Orphaned file path"
                              },
                              "last_modified": {
                                "type": "string",
                                "format": "date-time",
                                "description": "Last modification timestamp"
                              },
                              "integration_recommendation": {
                                "type": "string",
                                "description": "Suggested action (link, archive, consolidate)"
                              },
                              "severity": {
                                "type": "string",
                                "enum": ["critical", "high", "medium", "low"],
                                "description": "Isolation severity"
                              }
                            },
                            "required": ["file", "integration_recommendation", "severity"]
                          }
                        }
                      },
                      "required": ["total_files", "referenced_files", "orphaned_files"]
                    }
                  },
                  "required": [
                    "health_score",
                    "coverage_percentage",
                    "link_health",
                    "organization_compliance",
                    "naming_compliance",
                    "cross_references"
                  ]
                },
                "recommendations": {
                  "type": "array",
                  "description": "Prioritized action items for documentation improvement",
                  "items": {
                    "type": "object",
                    "properties": {
                      "priority": {
                        "type": "string",
                        "enum": ["critical", "high", "medium", "low"],
                        "description": "Recommendation priority"
                      },
                      "category": {
                        "type": "string",
                        "enum": ["links", "organization", "naming", "cross_references"],
                        "description": "Issue category"
                      },
                      "action": {
                        "type": "string",
                        "description": "Recommended action"
                      },
                      "affected_files": {
                        "type": "array",
                        "items": { "type": "string" },
                        "description": "Files affected by this recommendation"
                      },
                      "estimated_effort": {
                        "type": "string",
                        "enum": ["5min", "15min", "30min", "1hour", "2hours+"],
                        "description": "Estimated time to resolve"
                      },
                      "automated": {
                        "type": "boolean",
                        "description": "Whether this can be automated (Tier 2)"
                      }
                    },
                    "required": [
                      "priority",
                      "category",
                      "action",
                      "affected_files",
                      "estimated_effort"
                    ]
                  }
                },
                "fixes_applied": {
                  "type": "array",
                  "description": "Fixes applied during Tier 2 automated enhancement",
                  "items": {
                    "type": "object",
                    "properties": {
                      "fix_type": {
                        "type": "string",
                        "enum": [
                          "link_fix",
                          "file_rename",
                          "reference_update",
                          "metadata_addition"
                        ],
                        "description": "Type of fix applied"
                      },
                      "files_modified": {
                        "type": "array",
                        "items": { "type": "string" },
                        "description": "Files modified by this fix"
                      },
                      "details": {
                        "type": "string",
                        "description": "Description of changes made"
                      },
                      "verification_status": {
                        "type": "string",
                        "enum": ["verified", "failed", "partial"],
                        "description": "Post-fix verification result"
                      }
                    },
                    "required": ["fix_type", "files_modified", "details", "verification_status"]
                  }
                }
              },
              "required": ["health_report", "recommendations"]
            }
          },
          "required": ["status", "agent", "confidence", "agent_specific_output"]
        },
        {
          "title": "Failure Output",
          "properties": {
            "status": { "const": "FAILURE" },
            "agent": {
              "type": "string",
              "const": "doc-librarian"
            },
            "task_id": {
              "type": "string",
              "description": "Unique task identifier"
            },
            "operation_type": {
              "type": "string",
              "enum": ["check_health", "fix_links", "rename_files", "audit_organization"]
            },
            "summary": {
              "type": "string",
              "description": "Summary of failure reason and impact"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Confidence in failure analysis"
            },
            "execution_timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 UTC timestamp from orchestrator"
            },
            "failure_details": {
              "type": "object",
              "properties": {
                "failure_type": {
                  "type": "string",
                  "enum": [
                    "tool_failure",
                    "validation_failure",
                    "partial_completion",
                    "scope_violation",
                    "coordination_required",
                    "file_size_exceeded"
                  ],
                  "description": "Primary failure category"
                },
                "reasons": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Specific reasons for failure"
                },
                "partial_results": {
                  "type": "object",
                  "description": "Any work completed before failure",
                  "properties": {
                    "health_report": {
                      "type": "object",
                      "description": "Partial health assessment if scan incomplete"
                    },
                    "fixes_applied": {
                      "type": "array",
                      "description": "Fixes successfully applied before failure"
                    },
                    "fixes_failed": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "file": { "type": "string" },
                          "attempted_fix": { "type": "string" },
                          "error": { "type": "string" }
                        }
                      },
                      "description": "Fixes that failed with error details"
                    }
                  }
                },
                "recovery_suggestions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "approach": {
                        "type": "string",
                        "description": "Recommended recovery approach"
                      },
                      "estimated_effort": {
                        "type": "string",
                        "description": "Time estimate for recovery"
                      },
                      "requires_coordination": {
                        "type": "boolean",
                        "description": "Whether orchestrator coordination needed"
                      }
                    }
                  }
                },
                "next_steps": {
                  "type": "string",
                  "enum": [
                    "retry_with_fallback",
                    "escalate_to_orchestrator",
                    "request_user_input",
                    "coordinate_with_claude_code"
                  ],
                  "description": "Recommended next action"
                },
                "tools_attempted": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Tools attempted before failure"
                },
                "delegation_needed": {
                  "type": "string",
                  "description": "Agent to delegate to for resolution (if known)"
                }
              },
              "required": ["failure_type", "reasons", "recovery_suggestions", "next_steps"]
            }
          },
          "required": ["status", "agent", "confidence", "failure_details"]
        }
      ]
    }
  },
  "required": ["input", "output"]
}
