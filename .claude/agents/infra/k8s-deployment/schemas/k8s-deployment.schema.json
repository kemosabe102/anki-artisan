{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "k8s-deployment.schema.json",
  "title": "K8s Deployment Agent Schema",
  "description": "Schema for k8s-deployment outputs - Kubernetes deployment orchestration",
  "type": "object",
  "required": ["status", "agent", "confidence"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["SUCCESS", "FAILURE"]
    },
    "agent": {
      "type": "string",
      "const": "k8s-deployment"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "execution_timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "oneOf": [
    {
      "properties": {
        "status": { "const": "SUCCESS" },
        "agent_specific_output": { "$ref": "#/definitions/success_output" }

      },
      "required": ["status", "agent", "confidence", "agent_specific_output"]
    },
    {
      "properties": {
        "status": { "const": "FAILURE" },
        "failure_details": { "$ref": "#/definitions/failure_output" }
      },
      "required": ["status", "agent", "confidence", "failure_details"]
    }
  ],

  "definitions": {
    "success_output": {
      "type": "object",
      "required": ["operation"],
      "properties": {
        "operation": {
          "type": "string",
          "enum": ["deploy", "troubleshoot", "validate", "update_manifest", "rollback"],
          "description": "K8s operation type executed"
        },
        "deployments_updated": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of deployments affected"
        },
        "rollout_status": {
          "type": "string",
          "description": "Current rollout status"
        },

        "service_endpoints": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Service name to NodePort URL mapping"
        },
        "validation_passed": {
          "type": "boolean",
          "description": "Whether validation checks passed"
        },
        "failure_pattern": {
          "type": "string",
          "description": "Identified K8s failure pattern (for troubleshoot)"
        },
        "root_cause": {
          "type": "string",
          "description": "Root cause analysis (for troubleshoot)"
        },
        "evidence": {
          "type": "object",
          "properties": {
            "exit_code": { "type": "integer" },
            "events": { "type": "string" },
            "logs": { "type": "string" }
          }
        },
        "remediation": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Recommended remediation steps"
        }
      }
    },


    "failure_output": {
      "type": "object",
      "required": ["failure_type", "reasons", "recovery_suggestions"],
      "properties": {
        "failure_type": {
          "type": "string",
          "enum": [
            "cluster_unreachable",
            "manifest_validation_failed",
            "deployment_failed",
            "application_code_error",
            "permission_denied",
            "production_deployment_requested",
            "circuit_breaker_tripped"
          ],
          "description": "Category of failure"
        },
        "reasons": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Specific reasons for failure"
        },
        "recovery_suggestions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Actionable steps to resolve failure"
        },
        "partial_results": {
          "type": "object",
          "description": "Any work completed before failure"
        }
      }
    }
  }
}
