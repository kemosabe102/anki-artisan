{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "prometheus-alert-builder.schema.json",
  "version": "1.0.0",
  "title": "Prometheus Alert Builder Schema",
  "description": "Input/output schema for Prometheus alert rule construction, validation, and tuning with two-state model",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "description": "Unique identifier for the task"
        },
        "operation_type": {
          "type": "string",
          "enum": [
            "construct_alert",
            "validate_alert",
            "tune_alert"
          ],
          "description": "Type of alert operation to perform"
        },
        "intent_description": {
          "type": "string",
          "description": "Natural language description of what condition should trigger the alert"
        },
        "existing_alert": {
          "type": "string",
          "description": "Existing alert rule YAML to validate or tune (required for validate_alert and tune_alert)"
        },
        "alert_context": {
          "type": "object",
          "description": "Context for alert construction",
          "properties": {
            "service": {
              "type": "string",
              "description": "Service name for alert routing"
            },
            "team": {
              "type": "string",
              "description": "Team responsible for alert response"
            },
            "environment": {
              "type": "string",
              "description": "Environment (production, staging, dev)"
            },
            "severity_preference": {
              "type": "string",
              "enum": ["critical_only", "warning_critical", "multi_tier"],
              "description": "Preferred severity tier strategy"
            }
          }
        },
        "firing_history": {
          "type": "object",
          "description": "Historical firing data for tune_alert operation",
          "properties": {
            "fires_per_day": {
              "type": "number",
              "description": "Average number of alert fires per day"
            },
            "avg_duration_minutes": {
              "type": "number",
              "description": "Average duration of each firing in minutes"
            },
            "incident_correlation": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Correlation with actual incidents (0-1)"
            }
          }
        },
        "execution_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp from orchestrator"
        }
      },
      "required": [
        "task_id",
        "operation_type",
        "intent_description",
        "execution_timestamp"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "oneOf": [
        {
          "title": "Prometheus Alert Builder Success",
          "properties": {
            "status": {
              "const": "SUCCESS"
            },
            "agent": {
              "const": "prometheus-alert-builder"
            },
            "task_id": {
              "type": "string",
              "description": "Unique task identifier"
            },
            "operation_type": {
              "enum": ["construct_alert", "validate_alert", "tune_alert"]
            },
            "summary": {
              "type": "string",
              "description": "1-3 sentence summary of operation completed"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Confidence level in alert quality"
            },
            "execution_timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "agent_specific_output": {
              "type": "object",
              "description": "Alert-specific output structure",
              "properties": {
                "alert_rule_yaml": {
                  "type": "string",
                  "description": "Complete Prometheus alert rule in YAML format"
                },
                "alert_name": {
                  "type": "string",
                  "description": "Name of the alert rule"
                },
                "severity": {
                  "type": "string",
                  "enum": ["critical", "warning", "info"],
                  "description": "Alert severity level"
                },
                "for_clause": {
                  "type": "string",
                  "description": "Duration before alert fires (e.g., '10m')"
                },
                "for_clause_rationale": {
                  "type": "string",
                  "description": "Why this for duration was chosen"
                },
                "threshold_rationale": {
                  "type": "string",
                  "description": "Why these threshold values were chosen"
                },
                "anti_patterns_checked": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "pattern_name": {
                        "type": "string",
                        "description": "Name of anti-pattern checked"
                      },
                      "status": {
                        "type": "string",
                        "enum": ["passed", "failed", "warning"]
                      },
                      "recommendation": {
                        "type": "string",
                        "description": "Recommendation if pattern failed"
                      }
                    },
                    "required": ["pattern_name", "status"]
                  },
                  "description": "Anti-patterns validated against"
                },
                "annotations_included": {
                  "type": "object",
                  "properties": {
                    "summary": { "type": "boolean" },
                    "description": { "type": "boolean" },
                    "runbook_url": { "type": "boolean" },
                    "dashboard_url": { "type": "boolean" }
                  },
                  "description": "Which annotations are present"
                },
                "tuning_recommendations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "issue": { "type": "string" },
                      "current_value": { "type": "string" },
                      "recommended_value": { "type": "string" },
                      "expected_improvement": { "type": "string" }
                    },
                    "required": ["issue", "recommended_value"]
                  },
                  "description": "Tuning recommendations for noisy alerts"
                },
                "clarifying_questions_asked": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "question": { "type": "string" },
                      "answer_assumed": { "type": "string" },
                      "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
                    },
                    "required": ["question", "answer_assumed", "confidence"]
                  }
                }
              }
            }
          },
          "required": ["status", "agent", "task_id", "operation_type", "summary", "confidence", "execution_timestamp", "agent_specific_output"],
          "additionalProperties": false
        },
        {
          "title": "Prometheus Alert Builder Failure",
          "properties": {
            "status": { "const": "FAILURE" },
            "agent": { "const": "prometheus-alert-builder" },
            "task_id": { "type": "string" },
            "operation_type": { "enum": ["construct_alert", "validate_alert", "tune_alert"] },
            "summary": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "execution_timestamp": { "type": "string", "format": "date-time" },
            "failure_details": {
              "type": "object",
              "properties": {
                "failure_type": {
                  "type": "string",
                  "enum": [
                    "ambiguous_alert_intent",
                    "invalid_alert_syntax",
                    "anti_pattern_violation",
                    "missing_required_fields",
                    "threshold_validation_failed"
                  ]
                },
                "reasons": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "anti_patterns_violated": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "clarifying_questions": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "recovery_suggestions": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "required": ["failure_type", "reasons", "recovery_suggestions"]
            }
          },
          "required": ["status", "agent", "task_id", "operation_type", "summary", "confidence", "execution_timestamp", "failure_details"],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["input", "output"]
}
