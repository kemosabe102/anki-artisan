{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "grafana-dashboard-builder.schema.json",
  "version": "2.0.0",
  "title": "Grafana Dashboard Builder Schema",
  "description": "Input/output schema for Grafana dashboard creation, enhancement, and validation operations with two-state model",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "description": "Unique identifier for the dashboard operation task"
        },
        "operation_type": {
          "type": "string",
          "enum": ["create_from_intent", "import_enhance", "modify_panel", "validate_dashboard"],
          "description": "Type of dashboard operation to perform"
        },
        "description": {
          "type": "string",
          "description": "Detailed description of dashboard operation requirements"
        },
        "intent_text": {
          "type": "string",
          "description": "Natural language intent for create_from_intent operation"
        },
        "dashboard_source": {
          "type": "string",
          "description": "File path or URL for import_enhance operation"
        },
        "dashboard_path": {
          "type": "string",
          "description": "Path to existing dashboard"
        },
        "validation_level": {
          "type": "string",
          "enum": ["schema-only", "query-syntax", "full-connectivity"],
          "default": "full-connectivity"
        },
        "datasource_uid": {
          "type": "string",
          "description": "Grafana datasource UID (default: 'prometheus')"
        },
        "execution_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp from orchestrator"
        }
      },
      "required": ["task_id", "operation_type", "description", "execution_timestamp"],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "oneOf": [
        {
          "title": "Success",
          "properties": {
            "status": {
              "const": "SUCCESS"
            },
            "agent": {
              "const": "grafana-dashboard-builder"
            },
            "task_id": {
              "type": "string"
            },
            "operation_type": {
              "enum": ["create_from_intent", "import_enhance", "modify_panel", "validate_dashboard"]
            },
            "summary": {
              "type": "string"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "execution_timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "agent_specific_output": {
              "type": "object",
              "properties": {
                "dashboard_json_path": {
                  "type": "string"
                },
                "configmap_yaml_path": {
                  "type": "string"
                },
                "dashboard_uid": {
                  "type": "string"
                },
                "dashboard_title": {
                  "type": "string"
                },
                "panel_count": {
                  "type": "number"
                },
                "framework_applied": {
                  "enum": ["RED", "USE", "Four Golden Signals", "Custom"]
                },
                "deployment_instructions": {
                  "type": "object",
                  "properties": {
                    "delegate_to": {
                      "const": "k8s-deployment"
                    },
                    "configmap_path": {
                      "type": "string"
                    },
                    "namespace": {
                      "type": "string"
                    }
                  }
                }
              },
              "required": ["dashboard_json_path", "configmap_yaml_path"]
            }
          },
          "required": ["status", "agent", "confidence", "agent_specific_output"]
        },
        {
          "title": "Failure",
          "properties": {
            "status": {
              "const": "FAILURE"
            },
            "agent": {
              "const": "grafana-dashboard-builder"
            },
            "task_id": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "confidence": {
              "type": "number"
            },
            "execution_timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "failure_details": {
              "type": "object",
              "properties": {
                "failure_type": {
                  "enum": [
                    "prometheus_connectivity_error",
                    "invalid_intent",
                    "missing_metrics",
                    "promql_syntax_error",
                    "datasource_not_found"
                  ]
                },
                "reasons": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "proposed_next_steps": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": ["failure_type", "reasons"]
            }
          },
          "required": ["status", "agent", "confidence", "failure_details"]
        }
      ]
    }
  },
  "required": ["input", "output"]
}
