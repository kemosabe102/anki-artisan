{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "test-executor.schema.json",
  "title": "Test Executor Agent Schema",
  "description": "Schema for test-executor agent - runs test suites, parses output, categorizes failures, recommends delegation",
  "version": "1.0.0",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "context": {
          "type": "string"
        },
        "operation_type": {
          "type": "string",
          "enum": ["execute_tests", "validate_independence", "analyze_coverage"]
        },
        "test_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "execution_timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["context", "operation_type", "execution_timestamp"]
    },
    "output": {
      "type": "object",
      "oneOf": [
        {
          "title": "Success Output",
          "properties": {
            "status": {
              "const": "SUCCESS"
            },
            "agent": {
              "const": "test-executor"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "execution_timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "agent_specific_output": {
              "type": "object",
              "properties": {
                "execution_summary": {
                  "type": "object",
                  "properties": {
                    "total_tests": {
                      "type": "number"
                    },
                    "passed": {
                      "type": "number"
                    },
                    "failed": {
                      "type": "number"
                    },
                    "exit_code": {
                      "type": "number"
                    }
                  }
                },
                "failures": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "test_name": {
                        "type": "string",
                        "description": "Full test name including path"
                      },
                      "category": {
                        "type": "string",
                        "enum": [
                          "APPLICATION_BUG",
                          "TEST_BUG",
                          "ENVIRONMENT",
                          "FLAKY_TEST",
                          "MANUAL_REVIEW_NEEDED"
                        ],
                        "description": "Categorized failure type"
                      },
                      "confidence": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1,
                        "description": "Confidence in categorization"
                      },
                      "error_message": {
                        "type": "string",
                        "description": "Error message from test failure"
                      },
                      "stack_trace": {
                        "type": "string",
                        "description": "Full stack trace if available"
                      }
                    },
                    "required": ["test_name", "category", "confidence"]
                  }
                },
                "framework_detected": {
                  "type": "string"
                },
                "command_executed": {
                  "type": "string"
                },
                "delegation_summary": {
                  "type": "object",
                  "properties": {
                    "primary_category": {
                      "type": "string",
                      "enum": [
                        "APPLICATION_BUG",
                        "TEST_BUG",
                        "ENVIRONMENT",
                        "FLAKY_TEST",
                        "MANUAL_REVIEW_NEEDED"
                      ],
                      "description": "Most common failure category"
                    },
                    "failure_count": {
                      "type": "number",
                      "description": "Total number of failures"
                    },
                    "delegation_confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "description": "Overall confidence in delegation recommendations"
                    }
                  },
                  "required": ["primary_category", "failure_count", "delegation_confidence"]
                },
                "delegation_recommendations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "category": {
                        "type": "string",
                        "enum": ["APPLICATION_BUG", "TEST_BUG", "ENVIRONMENT", "FLAKY_TEST"],
                        "description": "Failure category for this recommendation"
                      },
                      "next_step": {
                        "type": "string",
                        "description": "Description of what needs to be done (not agent name)"
                      },
                      "priority": {
                        "type": "string",
                        "enum": ["critical", "high", "medium", "low"],
                        "description": "Priority level for this recommendation"
                      },
                      "rationale": {
                        "type": "string",
                        "description": "Why this next step is recommended"
                      },
                      "affected_tests": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "description": "List of test names affected by this category"
                      }
                    },
                    "required": ["category", "next_step", "priority", "affected_tests"]
                  }
                },
                "test_health_metrics": {
                  "type": "object",
                  "properties": {
                    "independence_score": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "description": "Score indicating test independence (1.0 = fully independent)"
                    },
                    "repeatability_score": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "description": "Score indicating test repeatability (1.0 = fully repeatable)"
                    },
                    "flaky_test_indicators": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "List of indicators suggesting flaky tests"
                    }
                  }
                },
                "coverage_gaps": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "file": {
                        "type": "string",
                        "description": "Source file with coverage gap"
                      },
                      "functions": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "description": "Uncovered functions in the file"
                      },
                      "lines": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "description": "Uncovered line numbers"
                      },
                      "severity": {
                        "type": "string",
                        "enum": ["critical", "high", "medium", "low"],
                        "description": "Impact of coverage gap"
                      }
                    },
                    "required": ["file", "severity"]
                  }
                },
                "delegation_history": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "iteration": {
                        "type": "number",
                        "description": "Iteration number (1, 2, 3...)"
                      },
                      "category": {
                        "type": "string",
                        "enum": ["APPLICATION_BUG", "TEST_BUG", "ENVIRONMENT", "FLAKY_TEST"],
                        "description": "Failure category for this iteration"
                      },
                      "confidence": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1,
                        "description": "Confidence score for this iteration"
                      },
                      "timestamp": {
                        "type": "string",
                        "format": "date-time",
                        "description": "ISO 8601 timestamp of this iteration"
                      }
                    },
                    "required": ["iteration", "category", "confidence", "timestamp"]
                  },
                  "description": "History of delegation iterations for loop protection (max 3)"
                }
              },
              "required": ["execution_summary", "failures"]
            }
          }
        },
        {
          "title": "Failure Output",
          "properties": {
            "status": {
              "const": "FAILURE"
            },
            "agent": {
              "const": "test-executor"
            },
            "confidence": {
              "type": "number"
            },
            "execution_timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "failure_details": {
              "type": "object",
              "properties": {
                "failure_type": {
                  "type": "string"
                },
                "reasons": {
                  "type": "array"
                }
              }
            }
          }
        }
      ]
    }
  }
}
