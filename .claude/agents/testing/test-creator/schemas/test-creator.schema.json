{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "test-creator.schema.json",
  "title": "Test Creator Agent Schema",
  "description": "Schema for test-creator agent (test generation specialist) - creates unit tests, analyzes coverage gaps, designs test strategies",
  "version": "1.0.0",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "context": {
          "type": "string",
          "description": "Test creation task with files requiring test coverage and coverage requirements"
        },
        "operation_type": {
          "type": "string",
          "enum": ["create_tests", "analyze_coverage", "fix_test_bug"],
          "description": "Type of test creation operation to perform"
        },
        "files_to_test": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of files requiring test creation (for create_tests operation)"
        },
        "coverage_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 80,
          "description": "Minimum coverage percentage target"
        },
        "test_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Test patterns to apply (AAA, mocking, parametrization)",
          "examples": ["AAA", "pytest-mock", "parametrize"]
        },
        "execution_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp from orchestrator (mandatory)"
        },
        "fix_test_bug_input": {
          "type": "object",
          "properties": {
            "test_file": {
              "type": "string",
              "description": "Path to test file needing fix"
            },
            "test_name": {
              "type": "string",
              "description": "Specific test function name"
            },
            "failure_category": {
              "type": "string",
              "enum": ["TEST_BUG"],
              "description": "Must be TEST_BUG category"
            },
            "error_message": {
              "type": "string",
              "description": "Full error output from test failure"
            },
            "stack_trace": {
              "type": "string",
              "description": "Stack trace if available"
            },
            "suggested_fix": {
              "type": "string",
              "description": "Preliminary analysis from test-executor"
            }
          },
          "required": ["test_file", "test_name", "failure_category", "error_message"]
        }
      },
      "required": ["context", "operation_type", "execution_timestamp"]
    },
    "output": {
      "type": "object",
      "oneOf": [
        {
          "title": "Success Output",
          "properties": {
            "status": {
              "const": "SUCCESS"
            },
            "agent": {
              "const": "test-creator"
            },
            "task_id": {
              "type": "string"
            },
            "operation_type": {
              "type": "string",
              "enum": ["create_tests", "analyze_coverage", "fix_test_bug"]
            },
            "summary": {
              "type": "string",
              "description": "Executive summary of test creation results",
              "examples": [
                "Created 12 unit tests for auth module with 95% coverage",
                "Identified 8 coverage gaps in payment processing logic"
              ]
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Confidence in test creation quality and coverage"
            },
            "execution_timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 UTC timestamp from orchestrator"
            },
            "agent_specific_output": {
              "type": "object",
              "properties": {
                "tests_created": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "List of test files created with absolute paths"
                },
                "test_patterns_applied": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Test patterns used (AAA, mocking, parametrization)"
                },
                "coverage_gaps": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "file": { "type": "string" },
                      "function": { "type": "string" },
                      "lines": { "type": "array", "items": { "type": "number" } },
                      "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
                      "recommendation": { "type": "string" }
                    },
                    "required": ["file", "function", "severity"]
                  }
                },
                "test_strategy": {
                  "type": "object",
                  "properties": {
                    "approach": { "type": "string" },
                    "test_types": { "type": "array", "items": { "type": "string" } },
                    "coverage_achieved": { "type": "number", "minimum": 0, "maximum": 100 },
                    "remaining_gaps": { "type": "number" },
                    "next_steps": { "type": "array", "items": { "type": "string" } }
                  },
                  "required": ["approach", "test_types"]
                },
                "libraries_researched": { "type": "array", "items": { "type": "string" } },
                "best_practices_applied": { "type": "array", "items": { "type": "string" } }
              },
              "required": ["tests_created", "test_patterns_applied", "test_strategy"]
            }
          },
          "required": ["status", "agent", "confidence", "execution_timestamp", "agent_specific_output"]
        },
        {
          "title": "Failure Output",
          "properties": {
            "status": { "const": "FAILURE" },
            "agent": { "const": "test-creator" },
            "task_id": { "type": "string" },
            "operation_type": { "type": "string", "enum": ["create_tests", "analyze_coverage", "fix_test_bug"] },
            "summary": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "execution_timestamp": { "type": "string", "format": "date-time" },
            "failure_details": {
              "type": "object",
              "properties": {
                "failure_type": {
                  "type": "string",
                  "enum": ["test_creation_blocked", "coverage_analysis_failed", "insufficient_context", "library_research_failed", "file_write_error", "pattern_mismatch"]
                },
                "reasons": { "type": "array", "items": { "type": "string" } },
                "files_attempted": { "type": "array", "items": { "type": "string" } },
                "research_attempted": { "type": "array", "items": { "type": "string" } },
                "partial_results": {
                  "type": "object",
                  "properties": {
                    "tests_created": { "type": "array", "items": { "type": "string" } },
                    "coverage_gaps_identified": { "type": "number" }
                  }
                },
                "recovery_suggestions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "approach": { "type": "string" },
                      "rationale": { "type": "string" },
                      "estimated_effort": { "type": "string", "enum": ["low", "medium", "high"] }
                    },
                    "required": ["approach", "rationale"]
                  }
                },
                "delegation_needed": {
                  "type": "string",
                  "enum": ["researcher-external", "researcher-codebase", "python-code-implementer", "none"]
                }
              },
              "required": ["failure_type", "reasons"]
            }
          },
          "required": ["status", "agent", "confidence", "execution_timestamp", "failure_details"]
        }
      ]
    }
  },
  "required": ["input", "output"]
}
