{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/kemosabe102/gauntlet-agents/schemas/tech-debt-investigator.schema.json",
  "title": "Technical Debt Investigator Agent Output Schema",
  "description": "Structured output for technical debt analysis with framework-aligned metrics",
  "type": "object",
  "allOf": [
    {
      "$ref": "base-agent.schema.json"
    }
  ],
  "properties": {
    "agent_specific_output": {
      "type": "object",
      "description": "Technical debt investigation findings and metrics",
      "properties": {
        "debt_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Overall technical debt score (0=severe, 100=excellent). Composite metric: Code Quality (40%) + Testing (20%) + Architecture (15%) + Docs (10%) + Infrastructure (10%) + Historical (5%)"
        },
        "debt_classification": {
          "type": "string",
          "enum": ["Low", "Moderate", "High", "Severe"],
          "description": "Categorical debt rating: Low (81-100), Moderate (61-80), High (41-60), Severe (0-40)"
        },
        "tdr_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Technical Debt Ratio (SQALE): (Remediation Cost) / (Development Cost). Target: <0.05 (5%)"
        },
        "sqale_grade": {
          "type": "string",
          "enum": ["A", "B", "C", "D", "E"],
          "description": "SQALE maintainability grade: A (≤5% TDR), B (6-10%), C (11-20%), D (21-50%), E (>50%)"
        },
        "category_ratings": {
          "type": "object",
          "description": "Orthogonal 6-category assessment (SQALE-inspired)",
          "properties": {
            "code_quality": {
              "$ref": "#/definitions/category_rating"
            },
            "architecture": {
              "$ref": "#/definitions/category_rating"
            },
            "testing": {
              "$ref": "#/definitions/category_rating"
            },
            "documentation": {
              "$ref": "#/definitions/category_rating"
            },
            "infrastructure": {
              "$ref": "#/definitions/category_rating"
            },
            "design_ui": {
              "$ref": "#/definitions/category_rating"
            }
          },
          "required": ["code_quality", "architecture", "testing", "documentation", "infrastructure"],
          "additionalProperties": false
        },
        "quantitative_metrics": {
          "type": "object",
          "description": "Measurable debt indicators with industry thresholds",
          "properties": {
            "cyclomatic_complexity": {
              "type": "object",
              "properties": {
                "average": {
                  "type": "number",
                  "description": "Average complexity across all functions"
                },
                "max": {
                  "type": "number",
                  "description": "Highest complexity function"
                },
                "high_complexity_count": {
                  "type": "integer",
                  "description": "Functions with complexity >10 (industry threshold)"
                },
                "critical_complexity_count": {
                  "type": "integer",
                  "description": "Functions with complexity >20 (critical threshold)"
                }
              },
              "required": ["average", "max", "high_complexity_count"]
            },
            "code_duplication": {
              "type": "object",
              "properties": {
                "percentage": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "% of duplicated lines (target: <5%)"
                },
                "duplicate_block_count": {
                  "type": "integer",
                  "description": "Number of duplicate code blocks detected"
                },
                "largest_duplicate_loc": {
                  "type": "integer",
                  "description": "Lines of code in largest duplicate block"
                }
              },
              "required": ["percentage", "duplicate_block_count"]
            },
            "test_coverage": {
              "type": "object",
              "properties": {
                "line_coverage_pct": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "% of code lines covered by tests (target: >80%)"
                },
                "function_coverage_pct": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "% of functions with at least one test"
                },
                "untested_critical_paths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "List of critical modules without tests"
                }
              },
              "required": ["line_coverage_pct", "function_coverage_pct"]
            },
            "dependency_staleness": {
              "type": "object",
              "properties": {
                "outdated_count": {
                  "type": "integer",
                  "description": "Number of outdated dependencies"
                },
                "critical_cves": {
                  "type": "integer",
                  "description": "Dependencies with known critical CVEs"
                },
                "months_behind_avg": {
                  "type": "number",
                  "description": "Average months behind latest version"
                }
              }
            },
            "documentation_coverage": {
              "type": "object",
              "properties": {
                "docstring_coverage_pct": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100,
                  "description": "% of functions with docstrings"
                },
                "readme_quality_score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10,
                  "description": "README completeness score (0-10)"
                },
                "missing_docs_count": {
                  "type": "integer",
                  "description": "Number of undocumented modules"
                }
              }
            }
          },
          "required": ["cyclomatic_complexity", "code_duplication", "test_coverage"]
        },
        "historical_metrics": {
          "type": "object",
          "description": "Git-based behavioral analysis (requires git access)",
          "properties": {
            "code_churn": {
              "type": "object",
              "properties": {
                "high_churn_files": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/churn_file"
                  },
                  "description": "Files with >10 commits in 3 months"
                },
                "churn_frequency_avg": {
                  "type": "number",
                  "description": "Average commits per file (3-month window)"
                }
              }
            },
            "ownership_dispersion": {
              "type": "object",
              "properties": {
                "low_ownership_modules": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/ownership_module"
                  },
                  "description": "Modules with >5 minor contributors (<10% each)"
                },
                "orphaned_files": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Files with no commits in >12 months"
                }
              }
            },
            "defect_density": {
              "type": "object",
              "properties": {
                "bugs_per_kloc": {
                  "type": "number",
                  "description": "Bugs per 1000 lines of code"
                },
                "open_bug_count": {
                  "type": "integer",
                  "description": "Total open bugs in scope"
                },
                "high_defect_modules": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Modules with >5 bugs in 6 months"
                }
              }
            }
          }
        },
        "hotspots": {
          "type": "array",
          "description": "Critical areas: high churn + high complexity + high defects",
          "items": {
            "type": "object",
            "properties": {
              "file_path": {
                "type": "string",
                "description": "Path to hotspot file"
              },
              "hotspot_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 10,
                "description": "Composite score: Churn (40%) + Complexity (30%) + Defects (20%) + Criticality (10%)"
              },
              "churn_frequency": {
                "type": "integer",
                "description": "Commits in last 3 months"
              },
              "cyclomatic_complexity": {
                "type": "number",
                "description": "Average complexity of functions in file"
              },
              "bug_count": {
                "type": "integer",
                "description": "Bugs traced to this file (6-month window)"
              },
              "business_criticality": {
                "type": "string",
                "enum": ["critical", "high", "medium", "low"],
                "description": "User-facing, payment flow, etc."
              },
              "priority": {
                "type": "string",
                "enum": ["P1", "P2", "P3", "P4"],
                "description": "Priority assignment from impact/effort matrix"
              }
            },
            "required": ["file_path", "hotspot_score", "priority"]
          }
        },
        "impact_effort_matrix": {
          "type": "array",
          "description": "Prioritized debt items classified into 4 quadrants",
          "items": {
            "type": "object",
            "properties": {
              "debt_item_id": {
                "type": "string",
                "description": "Unique identifier for this debt finding"
              },
              "description": {
                "type": "string",
                "description": "Brief description of the debt issue"
              },
              "category": {
                "type": "string",
                "enum": ["code_quality", "architecture", "testing", "documentation", "infrastructure", "design_ui"],
                "description": "Debt category classification"
              },
              "impact_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 10,
                "description": "Business/technical impact: Criticality (35%) + Usage (25%) + Defect Risk (20%) + Churn (10%) + Downstream (10%)"
              },
              "effort_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 10,
                "description": "Remediation effort: Complexity (40%) + Testing (25%) + Risk (20%) + Expertise (15%)"
              },
              "priority_quadrant": {
                "type": "string",
                "enum": ["P1_quick_wins", "P2_strategic", "P3_defer", "P4_opportunistic"],
                "description": "Matrix classification: P1 (high impact, low effort), P2 (high/high), P3 (low/high), P4 (low/low)"
              },
              "principal_cost_hours": {
                "type": "number",
                "description": "Estimated hours to fix debt now"
              },
              "interest_cost_per_sprint": {
                "type": "number",
                "description": "Ongoing cost (hours) if debt unfixed per 2-week sprint"
              },
              "is_hotspot": {
                "type": "boolean",
                "description": "True if item is in hotspots list (high churn + complexity)"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "File paths, line numbers, metric values supporting this finding"
              }
            },
            "required": ["debt_item_id", "description", "category", "impact_score", "effort_score", "priority_quadrant", "principal_cost_hours"]
          }
        },
        "remediation_plan": {
          "type": "array",
          "description": "Prioritized actionable remediation steps",
          "items": {
            "type": "object",
            "properties": {
              "priority_order": {
                "type": "integer",
                "description": "Execution order (1 = highest priority)"
              },
              "debt_item_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "References to impact_effort_matrix items"
              },
              "action": {
                "type": "string",
                "description": "Specific remediation action (e.g., 'Refactor PaymentProcessor using strangler pattern')"
              },
              "estimated_effort_hours": {
                "type": "number",
                "description": "Total effort for this remediation action"
              },
              "expected_debt_score_improvement": {
                "type": "number",
                "description": "Predicted debt_score increase after completion"
              },
              "acceptance_criteria": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Testable criteria for completion (e.g., 'Complexity <10', 'Coverage >80%')"
              }
            },
            "required": ["priority_order", "debt_item_ids", "action", "estimated_effort_hours", "acceptance_criteria"]
          }
        },
        "trend_analysis": {
          "type": "object",
          "description": "Delta comparison with baseline (if iterative run)",
          "properties": {
            "baseline_timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "Timestamp of baseline run for comparison"
            },
            "debt_score_delta": {
              "type": "object",
              "properties": {
                "previous": {
                  "type": "number"
                },
                "current": {
                  "type": "number"
                },
                "change_pct": {
                  "type": "number",
                  "description": "Percentage change (positive = improvement)"
                },
                "trend_direction": {
                  "type": "string",
                  "enum": ["improving", "stable", "worsening"],
                  "description": "Debt trajectory: improving (>5% increase), stable (±5%), worsening (<-5%)"
                }
              }
            },
            "category_deltas": {
              "type": "object",
              "description": "Per-category score changes",
              "additionalProperties": {
                "type": "number",
                "description": "Score delta for each category"
              }
            },
            "regressions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "metric": {
                    "type": "string",
                    "description": "Metric that regressed (e.g., 'test_coverage')"
                  },
                  "previous_value": {
                    "type": "number"
                  },
                  "current_value": {
                    "type": "number"
                  },
                  "threshold_violated": {
                    "type": "string",
                    "description": "Threshold crossed (e.g., 'TDR >5%', 'Coverage drop >5%')"
                  },
                  "severity": {
                    "type": "string",
                    "enum": ["critical", "warning", "info"]
                  }
                }
              },
              "description": "Metrics that worsened beyond thresholds"
            },
            "new_hotspots": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Files that became hotspots since baseline"
            }
          }
        },
        "connection_graph": {
          "type": "object",
          "description": "Relationships between debt findings (hotspot correlation)",
          "properties": {
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": ["file", "module", "debt_item"]
                  },
                  "label": {
                    "type": "string"
                  }
                }
              }
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string"
                  },
                  "target": {
                    "type": "string"
                  },
                  "relationship": {
                    "type": "string",
                    "enum": ["imports", "calls", "shares_debt_pattern", "hotspot_correlation"]
                  },
                  "weight": {
                    "type": "number",
                    "description": "Relationship strength (0-1)"
                  }
                }
              }
            }
          }
        },
        "stakeholder_summary": {
          "type": "object",
          "description": "Executive-friendly summary for non-technical stakeholders",
          "properties": {
            "overall_health": {
              "type": "string",
              "enum": ["Excellent", "Good", "Needs Improvement", "Critical"],
              "description": "Plain-language health assessment"
            },
            "top_recommendations": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "string"
              },
              "description": "Top 5 actionable recommendations"
            },
            "roi_estimate": {
              "type": "object",
              "properties": {
                "investment_hours": {
                  "type": "number",
                  "description": "Total remediation hours (principal)"
                },
                "monthly_savings_hours": {
                  "type": "number",
                  "description": "Estimated time saved per month after debt paydown (interest)"
                },
                "break_even_months": {
                  "type": "number",
                  "description": "Months to recoup investment"
                }
              }
            }
          }
        }
      },
      "required": ["debt_score", "debt_classification", "category_ratings", "quantitative_metrics", "impact_effort_matrix", "remediation_plan"]
    }
  },
  "definitions": {
    "category_rating": {
      "type": "object",
      "description": "Individual category assessment with evidence",
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 5,
          "description": "SIG-inspired star rating: 5 (top 5%), 4 (next 30%), 3 (average), 2 (below), 1 (bottom 5%)"
        },
        "raw_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "0-100 score before percentile conversion"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Supporting findings (file paths, metrics, violations)"
        },
        "remediation_hours": {
          "type": "number",
          "minimum": 0,
          "description": "Estimated hours to remediate all issues in this category"
        },
        "top_issues": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string"
          },
          "description": "Top 3 issues contributing to this category's debt"
        }
      },
      "required": ["score", "evidence", "remediation_hours"]
    },
    "churn_file": {
      "type": "object",
      "properties": {
        "file_path": {
          "type": "string"
        },
        "commit_count": {
          "type": "integer",
          "description": "Commits in 3-month window"
        },
        "unique_authors": {
          "type": "integer",
          "description": "Number of distinct contributors"
        },
        "lines_changed_total": {
          "type": "integer",
          "description": "Total LOC additions + deletions"
        }
      },
      "required": ["file_path", "commit_count"]
    },
    "ownership_module": {
      "type": "object",
      "properties": {
        "module_path": {
          "type": "string"
        },
        "total_contributors": {
          "type": "integer"
        },
        "top_owner_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "% of commits by top contributor"
        },
        "minor_contributor_count": {
          "type": "integer",
          "description": "Contributors with <10% commit share"
        }
      },
      "required": ["module_path", "total_contributors", "top_owner_pct"]
    }
  }
}
