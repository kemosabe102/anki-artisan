{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "root-cause-identifier.schema.json",
  "title": "Root Cause Identifier Schema",
  "description": "Input/output schema for root cause analysis using 5 Whys and SCAMPER frameworks (ORIENT/DECIDE phase)",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "description": "Unique identifier for the root cause analysis task"
        },
        "problem_statement": {
          "type": "object",
          "properties": {
            "symptom": {
              "type": "string",
              "description": "Observable symptom or problem being investigated"
            },
            "context": {
              "type": "string",
              "description": "Surrounding context when the problem occurred"
            },
            "timeline": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "timestamp": { "type": "string" },
                  "event": { "type": "string" }
                }
              },
              "description": "Timeline of events leading to the problem (optional)"
            }
          },
          "required": ["symptom"]
        },
        "evidence_available": {
          "type": "object",
          "properties": {
            "logs": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Relevant log entries or error messages"
            },
            "code_references": {
              "type": "array",
              "items": { "type": "string" },
              "description": "File paths or code snippets related to the problem"
            },
            "previous_occurrences": {
              "type": "array",
              "items": { "type": "object" },
              "description": "Previous instances of this or similar problems"
            }
          },
          "description": "Available evidence for root cause analysis"
        },
        "execution_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp from orchestrator (mandatory)"
        }
      },
      "required": ["task_id", "problem_statement", "execution_timestamp"],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "oneOf": [
        {
          "title": "Root Cause Analysis Success",
          "properties": {
            "status": { "const": "SUCCESS" },
            "agent": { "const": "root-cause-identifier" },
            "task_id": { "type": "string" },
            "operation_type": { "const": "analyze_root_cause" },
            "summary": {
              "type": "string",
              "description": "1-3 sentence summary of root cause and top recommendation"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Confidence in root cause identification (based on evidence quality)"
            },
            "execution_timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 UTC timestamp from orchestrator"
            },
            "agent_specific_output": {
              "type": "object",
              "properties": {
                "five_whys_chain": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "level": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 5,
                        "description": "Why level (1-5)"
                      },
                      "question": {
                        "type": "string",
                        "description": "The 'why' question asked at this level"
                      },
                      "answer": {
                        "type": "string",
                        "description": "Answer to the why question"
                      },
                      "evidence": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "type": {
                              "enum": ["log", "code", "pattern", "testimony", "metric", "documentation"],
                              "description": "Type of evidence"
                            },
                            "description": { "type": "string" },
                            "source": { "type": "string" }
                          },
                          "required": ["type", "description"]
                        },
                        "minItems": 1,
                        "description": "Evidence supporting this answer"
                      },
                      "confidence": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1,
                        "description": "Confidence in this answer based on evidence"
                      }
                    },
                    "required": ["level", "question", "answer", "evidence", "confidence"]
                  },
                  "minItems": 3,
                  "maxItems": 5,
                  "description": "The 5 Whys chain (minimum 3, typically 5 levels)"
                },
                "root_cause": {
                  "type": "object",
                  "properties": {
                    "description": {
                      "type": "string",
                      "description": "Clear description of the identified root cause"
                    },
                    "actionable": {
                      "type": "boolean",
                      "description": "Whether the root cause can be directly addressed"
                    },
                    "circular_check_passed": {
                      "type": "boolean",
                      "description": "Verification that root cause doesn't loop back to symptom"
                    },
                    "category": {
                      "enum": ["process", "technical", "human", "external", "design", "resource"],
                      "description": "Category of root cause"
                    },
                    "recurrence_risk": {
                      "enum": ["low", "medium", "high", "critical"],
                      "description": "Risk of recurrence if not addressed"
                    }
                  },
                  "required": ["description", "actionable", "circular_check_passed", "category", "recurrence_risk"]
                },
                "scamper_recommendations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "Recommendation ID (e.g., 'R1', 'R2')"
                      },
                      "scamper_lens": {
                        "enum": ["Substitute", "Combine", "Adapt", "Modify", "Put to other use", "Eliminate", "Reverse/Rearrange"],
                        "description": "Which SCAMPER lens generated this recommendation"
                      },
                      "description": {
                        "type": "string",
                        "description": "Clear description of the improvement"
                      },
                      "prevents_recurrence_by": {
                        "type": "string",
                        "description": "How this recommendation prevents the root cause from recurring"
                      },
                      "effort_estimate": {
                        "enum": ["low", "medium", "high"],
                        "description": "Implementation effort estimate"
                      },
                      "impact_estimate": {
                        "enum": ["low", "medium", "high"],
                        "description": "Impact on preventing recurrence"
                      },
                      "priority": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 5,
                        "description": "Priority ranking (1 = highest)"
                      }
                    },
                    "required": ["id", "scamper_lens", "description", "prevents_recurrence_by", "effort_estimate", "impact_estimate", "priority"]
                  },
                  "minItems": 2,
                  "maxItems": 5,
                  "description": "SCAMPER-derived improvement recommendations"
                },
                "analysis_metadata": {
                  "type": "object",
                  "properties": {
                    "evidence_quality": {
                      "enum": ["strong", "moderate", "weak"],
                      "description": "Overall quality of evidence available"
                    },
                    "alternative_root_causes_considered": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "description": { "type": "string" },
                          "ruled_out_because": { "type": "string" }
                        },
                        "required": ["description", "ruled_out_because"]
                      },
                      "description": "Other potential root causes that were considered and ruled out"
                    },
                    "assumptions_made": {
                      "type": "array",
                      "items": { "type": "string" },
                      "description": "Assumptions made during analysis"
                    }
                  },
                  "required": ["evidence_quality"]
                }
              },
              "required": ["five_whys_chain", "root_cause", "scamper_recommendations", "analysis_metadata"]
            }
          },
          "required": ["status", "agent", "task_id", "operation_type", "summary", "confidence", "execution_timestamp", "agent_specific_output"],
          "additionalProperties": false
        },
        {
          "title": "Root Cause Analysis Failure",
          "properties": {
            "status": { "const": "FAILURE" },
            "agent": { "const": "root-cause-identifier" },
            "task_id": { "type": "string" },
            "operation_type": { "const": "analyze_root_cause" },
            "summary": {
              "type": "string",
              "description": "Summary of why root cause analysis failed"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Confidence in failure diagnosis"
            },
            "execution_timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 UTC timestamp from orchestrator"
            },
            "failure_details": {
              "type": "object",
              "properties": {
                "failure_type": {
                  "enum": [
                    "insufficient_evidence",
                    "circular_root_cause",
                    "no_actionable_root_cause",
                    "ambiguous_symptoms",
                    "invalid_input",
                    "analysis_blocked"
                  ],
                  "description": "Primary type of failure"
                },
                "reasons": {
                  "type": "array",
                  "items": { "type": "string" },
                  "minItems": 1,
                  "description": "Specific reasons why analysis failed"
                },
                "partial_analysis": {
                  "type": "object",
                  "properties": {
                    "whys_completed": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 5,
                      "description": "Number of 'why' levels completed before failure"
                    },
                    "last_answer": { "type": "string" },
                    "blocking_point": { "type": "string" }
                  },
                  "description": "Progress made before failure"
                },
                "evidence_gaps": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "gap": { "type": "string" },
                      "investigation_path": { "type": "string" }
                    },
                    "required": ["gap", "investigation_path"]
                  },
                  "description": "Specific evidence needed to continue analysis"
                },
                "recovery_suggestions": {
                  "type": "array",
                  "items": { "type": "string" },
                  "minItems": 1,
                  "description": "Suggested approaches to resolve the failure"
                }
              },
              "required": ["failure_type", "reasons", "recovery_suggestions"]
            }
          },
          "required": ["status", "agent", "task_id", "operation_type", "summary", "confidence", "execution_timestamp", "failure_details"],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["input", "output"]
}
