{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Debugger Agent Schema",
  "description": "Input/output contract for hypothesis-driven debugging agent with 5 Whys RCA methodology",
  "$comment": "Version 1.0.0 - Self-contained debugging specialist",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "description": "Debugging task input schema",
      "properties": {
        "context": {
          "type": "string",
          "description": "Bug description, failing tests, error messages, or reproduction steps"
        },
        "execution_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 UTC timestamp from orchestrator (mandatory)"
        },
        "operation_type": {
          "type": "string",
          "enum": ["debug", "validate_pre_commit", "fix_failing_tests"],
          "description": "Type of debugging operation to perform"
        },
        "bug_context": {
          "type": "object",
          "properties": {
            "failing_test": {
              "type": "string",
              "description": "Name of failing test (if applicable)"
            },
            "error_message": {
              "type": "string",
              "description": "Error message or stack trace"
            },
            "reproduction_steps": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Steps to reproduce the bug"
            },
            "affected_files": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Files suspected to be involved"
            }
          }
        },
        "validate_pre_commit_options": {
          "type": "object",
          "properties": {
            "modified_files": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Files to validate in pre-commit workflow"
            },
            "validation_tier": {
              "type": "string",
              "enum": ["fast", "full"],
              "default": "fast",
              "description": "Validation thoroughness level"
            }
          }
        }
      },
      "required": ["context", "execution_timestamp", "operation_type"]
    },
    "output": {
      "type": "object",
      "oneOf": [
        {
          "title": "Success Output",
          "properties": {
            "status": { "const": "SUCCESS" },
            "agent": { "const": "debugger" },
            "task_id": { "type": "string" },
            "operation_type": {
              "type": "string",
              "enum": ["debug", "validate_pre_commit", "fix_failing_tests"]
            },
            "summary": {
              "type": "string",
              "description": "1-3 sentence executive summary of debugging result"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Confidence in hypothesis confirmation and fix effectiveness"
            },
            "execution_timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "agent_specific_output": {
              "type": "object",
              "description": "Debugging-specific results",
              "oneOf": [
                {
                  "title": "debug operation output",
                  "properties": {
                    "bug_reproduced": {
                      "type": "boolean",
                      "description": "Whether bug was successfully reproduced"
                    },
                    "hypothesis": {
                      "type": "string",
                      "description": "Specific, testable hypothesis about root cause"
                    },
                    "experiment_method": {
                      "type": "string",
                      "enum": ["test_harness", "instrumentation", "log_analysis", "debugger"],
                      "description": "Non-invasive experiment technique used: test_harness (isolated reproduction script in .claude/debug/), instrumentation (temporary logging/profiling without source changes), log_analysis (systematic analysis of existing logs/traces), debugger (step-through with breakpoints)"
                    },
                    "hypothesis_confirmed": {
                      "type": "boolean",
                      "description": "Whether hypothesis was confirmed by experiment"
                    },
                    "root_cause_analysis": {
                      "type": "object",
                      "properties": {
                        "baseline": {
                          "type": "string",
                          "description": "How to reproduce bug (command/test), observed error"
                        },
                        "observation": {
                          "type": "string",
                          "description": "What actually happened during experiment"
                        },
                        "five_whys": {
                          "type": "array",
                          "items": { "type": "string" },
                          "minItems": 1,
                          "maxItems": 5,
                          "description": "5 Whys root cause analysis chain - each item asks 'Why?' to drill down from symptom to root cause"
                        },
                        "root_cause": {
                          "type": "string",
                          "description": "Fundamental, actionable root cause identified"
                        }
                      },
                      "required": ["baseline", "observation", "five_whys", "root_cause"]
                    },
                    "fix_applied": {
                      "type": "boolean",
                      "description": "Whether a fix was implemented"
                    },
                    "fix_summary": {
                      "type": "object",
                      "properties": {
                        "files_changed": {
                          "type": "array",
                          "items": { "type": "string" },
                          "description": "Files modified in fix"
                        },
                        "change_description": {
                          "type": "string",
                          "description": "Brief diff summary of changes"
                        },
                        "rationale": {
                          "type": "string",
                          "description": "Why this fix addresses root cause"
                        },
                        "minimal_fix": {
                          "type": "boolean",
                          "description": "Whether fix followed minimal change principle"
                        }
                      },
                      "required": ["files_changed", "change_description", "rationale"]
                    },
                    "verification_results": {
                      "type": "object",
                      "properties": {
                        "failing_test_passes": {
                          "type": "boolean",
                          "description": "Original failing test now passes"
                        },
                        "regression_tests_passed": {
                          "type": "boolean",
                          "description": "Regression test suite passed"
                        },
                        "test_output_path": {
                          "type": "string",
                          "description": "Path to test output file"
                        },
                        "new_regression_tests": {
                          "type": "array",
                          "items": { "type": "string" },
                          "description": "New tests added for regression guard"
                        }
                      },
                      "required": ["failing_test_passes", "regression_tests_passed"]
                    },
                    "debugging_artifacts": {
                      "type": "object",
                      "properties": {
                        "harness_files": {
                          "type": "array",
                          "items": { "type": "string" },
                          "description": "Test harnesses created in .claude/debug/"
                        },
                        "temp_files_cleaned": {
                          "type": "boolean",
                          "description": "Whether temporary debugging files were cleaned up"
                        },
                        "artifacts_promoted": {
                          "type": "array",
                          "items": { "type": "string" },
                          "description": "Harnesses promoted to permanent tests"
                        }
                      }
                    },
                    "follow_up_recommendations": {
                      "type": "array",
                      "items": { "type": "string" },
                      "description": "Doc updates, refactoring tasks, or other follow-ups"
                    }
                  },
                  "required": ["bug_reproduced", "hypothesis", "hypothesis_confirmed"]
                },
                {
                  "title": "validate_pre_commit output",
                  "properties": {
                    "validation_status": {
                      "type": "string",
                      "enum": ["PASS", "FAIL"],
                      "description": "Final validation result after all fixes"
                    },
                    "fixes_applied": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": ["linting", "formatting", "test_failure", "import_error", "syntax_error"]
                          },
                          "files": {
                            "type": "array",
                            "items": { "type": "string" }
                          },
                          "description": { "type": "string" }
                        },
                        "required": ["type", "files", "description"]
                      },
                      "description": "List of all fixes applied during validation iterations"
                    },
                    "iteration_count": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 3,
                      "description": "Number of validation iterations performed"
                    },
                    "duration_seconds": {
                      "type": "number",
                      "minimum": 0,
                      "description": "Total time spent on validation and fixes"
                    },
                    "validation_command": {
                      "type": "string",
                      "description": "Command used for validation"
                    }
                  },
                  "required": ["validation_status", "fixes_applied", "iteration_count"]
                },
                {
                  "title": "fix_failing_tests output",
                  "type": "object",
                  "properties": {
                    "tests_fixed": {
                      "type": "array",
                      "description": "List of successfully fixed tests",
                      "items": {
                        "type": "object",
                        "properties": {
                          "test_name": {
                            "type": "string",
                            "description": "Name of the fixed test"
                          },
                          "test_path": {
                            "type": "string",
                            "description": "Full path to test file with test name"
                          },
                          "attempts_needed": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 3,
                            "description": "Number of attempts needed to fix"
                          },
                          "fix_type": {
                            "type": "string",
                            "enum": ["null_check", "type_validation", "logic_fix", "test_data_fix", "other"],
                            "description": "Category of fix applied: null_check (added null/None validation), type_validation (added type checking or coercion), logic_fix (fixed algorithmic or business logic error), test_data_fix (corrected test fixture/mock/assertions), other (see fix_description for details)"
                          },
                          "fix_description": {
                            "type": "string",
                            "description": "Brief description of what was fixed"
                          },
                          "files_changed": {
                            "type": "array",
                            "items": { "type": "string" },
                            "description": "List of files modified during fix"
                          },
                          "research_used": {
                            "type": "boolean",
                            "description": "Whether WebSearch was used (Attempt 3)"
                          },
                          "research_sources": {
                            "type": "array",
                            "items": { "type": "string" },
                            "description": "WebSearch queries executed"
                          },
                          "hypothesis": {
                            "type": "string",
                            "description": "Final hypothesis that led to successful fix"
                          }
                        },
                        "required": ["test_name", "test_path", "attempts_needed", "fix_type", "fix_description", "files_changed", "research_used"]
                      }
                    },
                    "unfixable_tests": {
                      "type": "array",
                      "description": "List of tests that could not be fixed after 3 attempts",
                      "items": {
                        "type": "object",
                        "properties": {
                          "test_name": {
                            "type": "string",
                            "description": "Name of the unfixable test"
                          },
                          "test_path": {
                            "type": "string",
                            "description": "Full path to test file with test name"
                          },
                          "attempts_made": {
                            "type": "integer",
                            "minimum": 3,
                            "maximum": 3,
                            "description": "Always 3 for unfixable tests"
                          },
                          "hypotheses_tried": {
                            "type": "array",
                            "items": { "type": "string" },
                            "description": "List of hypotheses attempted across 3 attempts"
                          },
                          "research_summary": {
                            "type": "string",
                            "description": "Summary of WebSearch findings (Attempt 3)"
                          },
                          "recommendation": {
                            "type": "string",
                            "description": "Next steps or escalation recommendation"
                          },
                          "evidence": {
                            "type": "object",
                            "description": "Supporting evidence for why test is unfixable",
                            "properties": {
                              "error_messages": {
                                "type": "array",
                                "items": { "type": "string" }
                              },
                              "stack_traces": {
                                "type": "array",
                                "items": { "type": "string" }
                              },
                              "attempted_fixes": {
                                "type": "array",
                                "items": { "type": "string" }
                              }
                            }
                          }
                        },
                        "required": ["test_name", "test_path", "attempts_made", "hypotheses_tried", "recommendation"]
                      }
                    },
                    "summary": {
                      "type": "object",
                      "description": "Summary statistics for the operation",
                      "properties": {
                        "total_tests": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "Total tests processed"
                        },
                        "fixed": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "Number of tests successfully fixed"
                        },
                        "unfixable": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "Number of tests that remain unfixable"
                        },
                        "total_duration_seconds": {
                          "type": "number",
                          "minimum": 0,
                          "description": "Total time spent on all tests"
                        },
                        "research_triggered": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "Number of tests that required WebSearch (Attempt 3)"
                        }
                      },
                      "required": ["total_tests", "fixed", "unfixable", "total_duration_seconds"]
                    }
                  },
                  "required": ["tests_fixed", "unfixable_tests", "summary"]
                }
              ]
            }
          },
          "required": ["status", "agent", "confidence", "agent_specific_output"]
        },
        {
          "title": "Failure Output",
          "properties": {
            "status": { "const": "FAILURE" },
            "agent": { "const": "debugger" },
            "task_id": { "type": "string" },
            "operation_type": {
              "type": "string",
              "enum": ["debug", "validate_pre_commit", "fix_failing_tests"]
            },
            "summary": {
              "type": "string",
              "description": "1-3 sentence summary of why debugging failed"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Confidence in failure analysis"
            },
            "execution_timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "failure_details": {
              "type": "object",
              "properties": {
                "failure_type": {
                  "type": "string",
                  "enum": [
                    "cannot_reproduce",
                    "hypothesis_refuted",
                    "fix_ineffective",
                    "regression_introduced",
                    "validation_timeout",
                    "unfixable_issues",
                    "missing_dependencies",
                    "out_of_scope",
                    "blocked"
                  ],
                  "description": "Category of debugging failure: cannot_reproduce (issue does not occur after 3 attempts), hypothesis_refuted (all hypotheses disproved), fix_ineffective (fix applied but issue persists), regression_introduced (fix breaks other tests), validation_timeout (execution >30 min), unfixable_issues (some tests remain broken after 3 attempts each), missing_dependencies (required resources unavailable), out_of_scope (requires architectural/design changes beyond debugging), blocked (external blockers prevent progress)"
                },
                "reasons": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Specific reasons why debugging failed"
                },
                "hypotheses_attempted": {
                  "type": "array",
                  "description": "Log of hypotheses tested during failed debugging attempts",
                  "items": {
                    "type": "object",
                    "properties": {
                      "hypothesis": {
                        "type": "string",
                        "description": "Testable statement about root cause"
                      },
                      "result": {
                        "type": "string",
                        "enum": ["confirmed", "refuted", "inconclusive"],
                        "description": "Outcome of hypothesis validation"
                      },
                      "evidence": {
                        "type": "string",
                        "description": "Observed facts supporting the result"
                      }
                    }
                  }
                },
                "unfixable_issues": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Issues that could not be fixed after 3 iterations"
                },
                "partial_results": {
                  "type": "object",
                  "properties": {
                    "bug_reproduced": { "type": "boolean" },
                    "root_cause_identified": { "type": "boolean" },
                    "partial_fix_applied": { "type": "boolean" }
                  },
                  "description": "Progress made before failure"
                },
                "recovery_suggestions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "approach": { "type": "string" },
                      "rationale": { "type": "string" },
                      "estimated_effort": { "type": "string" }
                    }
                  },
                  "description": "Actionable recovery strategies"
                },
                "escalation_needed": {
                  "type": "boolean",
                  "description": "Whether human intervention is required"
                },
                "blocked_on": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Dependencies or requirements blocking resolution"
                }
              },
              "required": ["failure_type", "reasons", "recovery_suggestions"]
            }
          },
          "required": ["status", "agent", "confidence", "failure_details"]
        }
      ]
    }
  },
  "required": ["input", "output"]
}
