{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PostgresTimescaleSpecialistOutput",
  "description": "Output schema for postgres-timescale-specialist agent responses",
  "type": "object",
  "required": ["status", "agent", "confidence", "agent_specific_output"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["SUCCESS", "FAILURE"],
      "description": "Overall operation status"
    },
    "agent": {
      "type": "string",
      "const": "postgres-timescale-specialist",
      "description": "Agent identifier"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence score for the output (0.0-1.0)"
    },
    "error_type": {
      "type": "string",
      "enum": ["insufficient_context", "crash_risk_detected", "connection_failure", "query_timeout"],
      "description": "Error classification when status is FAILURE"
    },
    "agent_specific_output": {
      "type": "object",
      "description": "Mode-specific output data",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["create_query", "optimize_query", "design_indexes", "audit_performance", "tune_configuration"],
          "description": "The mode that was executed"
        },
        "query": {
          "type": "string",
          "description": "Generated SQL query (for create_query mode)"
        },
        "original_query": {
          "type": "string",
          "description": "Original SQL query before optimization"
        },
        "optimized_query": {
          "type": "string",
          "description": "Optimized SQL query"
        },
        "improvement_factors": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of optimization factors applied"
        },
        "estimated_speedup": {
          "type": "string",
          "description": "Estimated performance improvement (e.g., '16x')"
        },
        "explain_summary": {
          "type": "string",
          "description": "Summary of EXPLAIN output"
        },
        "crash_risk_assessment": {
          "type": "object",
          "properties": {
            "risk_level": { "enum": ["safe", "warning", "blocked"] },
            "estimated_memory": { "type": "string" },
            "recommendation": { "type": "string" }
          },
          "description": "Crash risk assessment for aggregate queries"
        },
        "indexes_recommended": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index_name": { "type": "string" },
              "create_statement": { "type": "string" },
              "expected_benefit": { "type": "string" }
            }
          },
          "description": "Recommended indexes (for design_indexes mode)"
        }
      }
    }
  }
}
