{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gauntlet-agents.com/schemas/decisions/v1.0.0",
  "title": "Decision Snapshot",
  "description": "Machine-readable decision with rationale and context tracking",
  "type": "object",
  "required": [
    "id",
    "area",
    "decision",
    "rationale",
    "alternatives",
    "context_used",
    "impact_scope",
    "reversibility",
    "decision_hash"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^DEC-[A-Z0-9]+-\\d{3}$",
      "description": "Unique decision ID (format: DEC-<domain>-<NNN>)"
    },
    "area": {
      "type": "string",
      "description": "Domain or area of decision (e.g., authentication, database)"
    },
    "decision": {
      "type": "string",
      "description": "The specific decision made"
    },
    "rationale": {
      "type": "string",
      "description": "Justification for the decision"
    },
    "alternatives": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Alternative approaches considered"
    },
    "context_used": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Sources used for decision (at least one must be pinned)"
    },
    "impact_scope": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Files, sections, or components affected by this decision"
    },
    "reversibility": {
      "enum": ["Low", "Medium", "High"],
      "description": "How easily this decision can be reversed"
    },
    "decision_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA-256 hash of decision+rationale+context_used+impact_scope"
    },
    "context_pinned": {
      "type": "boolean",
      "description": "Whether at least one context_used entry is pinned with commit hash"
    }
  }
}
