{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gauntlet-agents.com/schemas/spec-review-output/v1.0.0",
  "title": "Specification Review Output",
  "description": "Output from planner agent when performing spec-review taskType",
  "type": "object",
  "required": ["status", "task_type", "spec_file_updated"],
  "properties": {
    "status": {
      "enum": ["ok", "blocked", "error"],
      "description": "Review completion status"
    },
    "task_type": {
      "enum": ["spec-review"],
      "description": "Confirms this is a spec review task"
    },
    "spec_file_updated": {
      "type": "string",
      "description": "Absolute path to updated SPEC.md file"
    },
    "enhancements_made": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section", "original", "resolved", "source"],
        "properties": {
          "section": {
            "type": "string",
            "description": "Section of spec that was enhanced"
          },
          "original": {
            "type": "string",
            "description": "Original [NEEDS VERIFICATION] text"
          },
          "resolved": {
            "type": "string",
            "description": "Resolved content with evidence"
          },
          "source": {
            "type": "string",
            "description": "Documentation source used for resolution"
          }
        }
      },
      "description": "List of verification markers that were resolved"
    },
    "remaining_verification_needed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section", "item", "reason"],
        "properties": {
          "section": {
            "type": "string",
            "description": "Section containing the unresolved item"
          },
          "item": {
            "type": "string",
            "description": "Specific item requiring human input"
          },
          "reason": {
            "type": "string",
            "description": "Why this requires human judgment"
          }
        }
      },
      "description": "Items that still require human review/decision"
    },
    "human_report": {
      "type": "string",
      "description": "Path to generated human-readable report file"
    },
    "confidence_assessment": {
      "type": "object",
      "required": ["enhancement_quality", "remaining_gaps"],
      "properties": {
        "enhancement_quality": {
          "enum": ["High", "Medium", "Low"],
          "description": "Quality of automatic enhancements made"
        },
        "remaining_gaps": {
          "enum": ["High", "Medium", "Low"],
          "description": "Significance of remaining gaps"
        }
      }
    },
    "roadmap_item_id": {
      "type": "string",
      "description": "ID of the roadmap item that was specified"
    },
    "verification_markers_found": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of [NEEDS VERIFICATION] markers found"
    },
    "verification_markers_resolved": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of markers successfully resolved"
    }
  }
}
