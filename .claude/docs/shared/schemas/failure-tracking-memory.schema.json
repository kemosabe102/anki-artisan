{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Failure Tracking Memory Schema",
  "description": "Schema for agents to track failures and retries during task execution in memory",
  "type": "object",
  "properties": {
    "task_assessment": {
      "type": "object",
      "description": "Self-assessment done during pre-flight",
      "properties": {
        "complexity_estimate": {
          "type": "string",
          "enum": ["minimal", "low", "medium", "high", "complex"],
          "description": "Agent's assessment of task complexity"
        },
        "expected_changes": {
          "type": "integer",
          "minimum": 0,
          "description": "Expected number of file modifications (can be 0)"
        },
        "failure_tolerance": {
          "type": "integer",
          "minimum": 2,
          "maximum": 10,
          "description": "Max failures agent expects to handle before escalation"
        },
        "approach_strategy": {
          "type": "string",
          "description": "High-level strategy for completing the task"
        }
      },
      "required": ["complexity_estimate", "expected_changes", "failure_tolerance"]
    },
    "operation_tracking": {
      "type": "object",
      "description": "Runtime tracking of specific operations",
      "properties": {
        "operation_attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "operation_id": {
                "type": "string",
                "description": "Unique identifier for the specific operation (tool + target)"
              },
              "tool_used": {
                "type": "string",
                "description": "Name of the tool used (Edit, Write, MultiEdit, etc.)"
              },
              "target": {
                "type": "string",
                "description": "Target file/resource being operated on"
              },
              "attempt_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2,
                "description": "Number of attempts for this specific operation (max 2)"
              },
              "last_failure": {
                "type": "object",
                "properties": {
                  "timestamp": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "error_type": {
                    "type": "string"
                  },
                  "error_message": {
                    "type": "string"
                  }
                }
              },
              "approach_history": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Different approaches tried for this operation"
              }
            },
            "required": ["operation_id", "tool_used", "target", "attempt_count"]
          }
        },
        "failure_summary": {
          "type": "object",
          "properties": {
            "total_failed_operations": {
              "type": "integer",
              "minimum": 0
            },
            "operations_at_max_attempts": {
              "type": "integer",
              "minimum": 0,
              "description": "Operations that hit the 2-attempt limit"
            },
            "escalation_needed": {
              "type": "boolean",
              "description": "True when failure patterns indicate need for escalation"
            }
          },
          "required": ["total_failed_operations", "operations_at_max_attempts", "escalation_needed"]
        }
      },
      "required": ["operation_attempts", "failure_summary"]
    },
    "escalation_plan": {
      "type": "object",
      "description": "Plan for escalating to orchestrator when failures exceed tolerance",
      "properties": {
        "trigger_reason": {
          "type": "string",
          "enum": [
            "max_attempts_reached",
            "repeated_failures",
            "approach_exhausted",
            "scope_change_needed"
          ],
          "description": "Why escalation is needed"
        },
        "failed_operations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of operations that could not be completed"
        },
        "attempted_approaches": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "All approaches tried"
        },
        "recommended_next_steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": ["ask_planner_agent", "ask_different_subagent", "ask_human", "change_scope"]
              },
              "reason": {
                "type": "string"
              },
              "specific_request": {
                "type": "string",
                "description": "Exact request to make to orchestrator/human"
              }
            },
            "required": ["action", "reason", "specific_request"]
          }
        }
      },
      "required": ["trigger_reason", "failed_operations", "recommended_next_steps"]
    }
  },
  "required": ["task_assessment", "operation_tracking"]
}
