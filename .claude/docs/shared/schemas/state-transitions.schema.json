{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gauntlet-agents.com/schemas/state-transitions/v1.0.0",
  "title": "State Transition",
  "description": "Before/after state description with migration and rollback plans",
  "type": "object",
  "required": [
    "component",
    "before",
    "after",
    "migration",
    "checksum",
    "preflight_checks",
    "rollback_plan",
    "validation"
  ],
  "properties": {
    "component": {
      "type": "string",
      "description": "System component being changed (e.g., database, config, service)"
    },
    "before": {
      "type": "string",
      "description": "State before the change"
    },
    "after": {
      "type": "string",
      "description": "State after the change"
    },
    "migration": {
      "type": "string",
      "description": "Migration file or command to execute"
    },
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA-256 checksum of migration file"
    },
    "preflight_checks": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Checks to perform before migration"
    },
    "rollback_plan": {
      "type": "string",
      "description": "How to revert this change"
    },
    "validation": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Post-migration validation steps"
    }
  }
}
