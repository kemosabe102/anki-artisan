{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "code-review-checkpoint.schema.json",
  "title": "Code Review Checkpoint",
  "description": "Schema for checkpointing the 7-phase code-review workflow",
  "type": "object",
  "required": ["meta", "tools_available", "phases"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["schema_version", "command", "source_flag", "started_at", "current_phase", "status"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "command": { "const": "code-review" },
        "source_flag": {
          "type": "string",
          "enum": ["--all", "--branch", "--files", "--commit"],
          "description": "Flag indicating the source of files to review"
        },
        "source_value": {
          "type": "string",
          "description": "Value associated with source_flag (branch name, file paths, commit SHA)"
        },
        "started_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "current_phase": { "type": "integer", "minimum": 0, "maximum": 6 },
        "status": { "type": "string", "enum": ["in_progress", "paused", "completed", "failed"] }
      }
    },
    "tools_available": {
      "type": "object",
      "properties": {
        "git": { "type": "boolean", "description": "Whether git CLI is available" },
        "semgrep": { "type": "boolean", "description": "Whether semgrep is available for static analysis" }
      },
      "required": ["git", "semgrep"]
    },
    "phases": {
      "type": "object",
      "properties": {
        "phase_0": { "$ref": "#/definitions/phase_state" },
        "phase_1": { "$ref": "#/definitions/phase_with_files" },
        "phase_2": { "$ref": "#/definitions/phase_with_batches" },
        "phase_3": { "$ref": "#/definitions/phase_with_findings" },
        "phase_4": { "$ref": "#/definitions/phase_with_validated_findings" },
        "phase_5": { "$ref": "#/definitions/phase_with_consolidated" },
        "phase_6": { "$ref": "#/definitions/phase_with_report" }
      }
    }
  },
  "definitions": {
    "phase_state": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["pending", "in_progress", "completed", "skipped", "failed"] },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "error": { "type": "string" }
      },
      "required": ["status"]
    },
    "phase_with_files": {
      "allOf": [
        { "$ref": "#/definitions/phase_state" },
        {
          "type": "object",
          "properties": {
            "files": {
              "type": "array",
              "items": { "type": "string" },
              "description": "List of file paths to review"
            },
            "total_files": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "phase_with_batches": {
      "allOf": [
        { "$ref": "#/definitions/phase_state" },
        {
          "type": "object",
          "properties": {
            "batches": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "batch_id": { "type": "integer" },
                  "files": { "type": "array", "items": { "type": "string" } },
                  "status": { "type": "string", "enum": ["pending", "in_progress", "completed", "failed"] }
                }
              }
            },
            "total_batches": { "type": "integer", "minimum": 0 },
            "completed_batches": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "phase_with_findings": {
      "allOf": [
        { "$ref": "#/definitions/phase_state" },
        {
          "type": "object",
          "properties": {
            "findings": {
              "type": "array",
              "items": { "$ref": "code-review.schema.json#/definitions/finding" }
            },
            "total_findings": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "phase_with_validated_findings": {
      "allOf": [
        { "$ref": "#/definitions/phase_state" },
        {
          "type": "object",
          "properties": {
            "validated_findings": {
              "type": "array",
              "items": { "$ref": "code-review.schema.json#/definitions/finding" }
            },
            "dropped_findings": {
              "type": "array",
              "items": { "$ref": "code-review.schema.json#/definitions/finding" }
            },
            "validation_stats": {
              "type": "object",
              "properties": {
                "total_reviewed": { "type": "integer" },
                "confirmed": { "type": "integer" },
                "dropped": { "type": "integer" }
              }
            }
          }
        }
      ]
    },
    "phase_with_consolidated": {
      "allOf": [
        { "$ref": "#/definitions/phase_state" },
        {
          "type": "object",
          "properties": {
            "consolidated_findings": {
              "type": "array",
              "items": { "$ref": "code-review.schema.json#/definitions/finding" }
            },
            "by_severity": {
              "type": "object",
              "properties": {
                "critical": { "type": "integer", "minimum": 0 },
                "high": { "type": "integer", "minimum": 0 },
                "medium": { "type": "integer", "minimum": 0 },
                "low": { "type": "integer", "minimum": 0 },
                "nit": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      ]
    },
    "phase_with_report": {
      "allOf": [
        { "$ref": "#/definitions/phase_state" },
        {
          "type": "object",
          "properties": {
            "report_path": { "type": "string" },
            "report_format": { "type": "string", "enum": ["markdown", "json", "html"] }
          }
        }
      ]
    }
  }
}
