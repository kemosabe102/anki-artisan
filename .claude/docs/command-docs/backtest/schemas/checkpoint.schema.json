{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Backtest Checkpoint",
  "description": "Schema for backtest checkpoint state used for resume/recovery",
  "type": "object",
  "required": ["schema_version", "run_id", "algorithm", "tier", "status"],
  "properties": {
    "schema_version": {
      "const": "1.0",
      "description": "Schema version for checkpoint format"
    },
    "checksum": {
      "type": "string",
      "pattern": "^sha256:",
      "description": "SHA256 checksum for integrity verification"
    },
    "run_id": {
      "type": "string",
      "pattern": "^\\d{8}_\\d{3}$",
      "description": "Unique run identifier in format YYYYMMDD_SEQ"
    },
    "algorithm": {
      "type": "string",
      "description": "Algorithm name being tested"
    },
    "tier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "description": "Tier level (1-4)"
    },
    "hypothesis_id": {
      "type": "string",
      "pattern": "^HYP-",
      "description": "Associated hypothesis ID"
    },
    "trial_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Trial number within hypothesis (1-5)"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when run started"
    },
    "total_periods": {
      "type": "integer",
      "minimum": 1,
      "description": "Total number of periods to test"
    },
    "completed_periods": {
      "type": "array",
      "description": "Periods that have been completed",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Period identifier (e.g., post_gfc_bull)"
          },
          "sharpe": {
            "type": "number",
            "description": "Sharpe ratio for this period"
          },
          "dd": {
            "type": "number",
            "description": "Maximum drawdown for this period"
          },
          "trades": {
            "type": "integer",
            "description": "Number of trades in this period"
          },
          "status": {
            "enum": ["OK", "FAIL"],
            "description": "Period pass/fail status"
          }
        }
      }
    },
    "current_period": {
      "type": "integer",
      "minimum": 1,
      "description": "Index of current period being tested"
    },
    "status": {
      "enum": ["IN_PROGRESS", "COMPLETED", "FAILED"],
      "description": "Current run status"
    }
  }
}
