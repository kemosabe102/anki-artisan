{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Backtest Run Manifest",
  "description": "Schema for completed backtest run output manifest",
  "type": "object",
  "required": ["run_id", "algorithm", "tier", "hypothesis_id", "verdict", "metrics"],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^\\d{8}_\\d{3}$",
      "description": "Unique run identifier in format YYYYMMDD_SEQ"
    },
    "algorithm": {
      "type": "string",
      "description": "Algorithm name being tested"
    },
    "tier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "description": "Tier level (1-4)"
    },
    "hypothesis_id": {
      "type": "string",
      "pattern": "^HYP-",
      "description": "Associated hypothesis ID"
    },
    "trial_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Trial number within hypothesis (1-5)"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when run started"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when run completed"
    },
    "verdict": {
      "enum": ["PASS", "FAIL"],
      "description": "Final gate verdict"
    },
    "metrics": {
      "type": "object",
      "description": "Aggregated metrics across all periods",
      "properties": {
        "avg_sharpe": {
          "type": "number",
          "description": "Average Sharpe ratio across periods"
        },
        "dsr": {
          "type": "number",
          "description": "Deflated Sharpe Ratio"
        },
        "worst_dd": {
          "type": "number",
          "description": "Worst drawdown percentage"
        },
        "total_trades": {
          "type": "integer",
          "description": "Total number of trades across all periods"
        },
        "avg_win_rate": {
          "type": "number",
          "description": "Average win rate across periods"
        },
        "regime_cv": {
          "type": "number",
          "description": "Coefficient of variation across regimes"
        }
      }
    },
    "period_results": {
      "type": "array",
      "description": "Results for each test period",
      "items": {
        "type": "object",
        "required": ["period_id", "sharpe", "status"],
        "properties": {
          "period_id": {
            "type": "string",
            "description": "Period identifier (e.g., post_gfc_bull)"
          },
          "sharpe": {
            "type": "number",
            "description": "Sharpe ratio for this period"
          },
          "dd": {
            "type": "number",
            "description": "Maximum drawdown for this period"
          },
          "trades": {
            "type": "integer",
            "description": "Number of trades in this period"
          },
          "win_rate": {
            "type": "number",
            "description": "Win rate for this period"
          },
          "status": {
            "enum": ["OK", "FAIL"],
            "description": "Period pass/fail status"
          }
        }
      }
    },
    "gate_results": {
      "type": "array",
      "description": "Results for each gate check",
      "items": {
        "type": "object",
        "properties": {
          "gate": {
            "type": "string",
            "description": "Gate name (e.g., sharpe_minimum)"
          },
          "passed": {
            "type": "boolean",
            "description": "Whether this gate passed"
          },
          "value": {
            "type": "number",
            "description": "Actual value achieved"
          },
          "threshold": {
            "type": "number",
            "description": "Required threshold value"
          }
        }
      }
    }
  }
}
