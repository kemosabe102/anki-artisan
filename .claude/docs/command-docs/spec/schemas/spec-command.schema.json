{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spec Command Output Schema",
  "description": "Validates /spec command outputs for downstream compatibility",
  "type": "object",
  "required": ["spec_file", "status", "quality_metrics"],
  "properties": {
    "spec_file": {
      "type": "string",
      "pattern": "^docs/01-planning/specifications/[0-9]{3}-[a-z0-9-]+/SPEC\\.md$",
      "description": "Path to generated SPEC.md file"
    },
    "technical_context_file": {
      "type": "string",
      "pattern": "^docs/01-planning/specifications/[0-9]{3}-[a-z0-9-]+/technical-context\\.md$",
      "description": "Path to companion technical context file (optional)"
    },
    "status": {
      "type": "string",
      "enum": ["SUCCESS", "FAILURE"],
      "description": "Command completion status"
    },
    "error_code": {
      "type": "string",
      "pattern": "^SPEC_ERR_[0-9]{3}$",
      "description": "Error code if status is FAILURE"
    },
    "quality_metrics": {
      "type": "object",
      "required": ["pain_point_score", "completeness_score", "how_violations"],
      "properties": {
        "pain_point_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Pain point alignment score (threshold >= 0.4)"
        },
        "completeness_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Requirements completeness score"
        },
        "how_violations": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of HOW boundary violations (target: 0)"
        },
        "cq_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Context Quality score from Phase 3.5 gate"
        }
      }
    },
    "reviews": {
      "type": "object",
      "properties": {
        "spec_reviewer": {
          "type": "object",
          "properties": {
            "grade": {"type": "string", "enum": ["A", "B", "C", "D", "F"]},
            "recommendation": {"type": "string"}
          }
        },
        "technical_pm": {
          "type": "object",
          "properties": {
            "alignment_score": {"type": "number"},
            "recommendation": {"type": "string"}
          }
        },
        "architecture_reviewer": {
          "type": "object",
          "properties": {
            "feasibility": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW"]},
            "constraints_coverage": {"type": "number"}
          }
        }
      }
    },
    "next_command": {
      "type": "string",
      "description": "Suggested next command (typically /plan path)"
    }
  }
}
