{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "review.schema.json",
  "title": "Review Finding Schema",
  "description": "Schema for code review findings with confidence-driven investigation",
  "type": "object",
  "required": ["finding_id", "severity", "location", "message", "confidence"],
  "properties": {
    "finding_id": {
      "type": "string",
      "pattern": "^(CRIT|HIGH|MED|LOW|NIT|OQ)-[0-9]{3}$",
      "description": "Unique identifier (e.g., CRIT-001, HIGH-003)"
    },
    "severity": {
      "type": "string",
      "enum": ["Critical", "High", "Medium", "Low", "Nit"],
      "description": "Severity level of the finding"
    },
    "category": {
      "type": "string",
      "enum": ["Security", "Performance", "Quality", "Design", "Maintainability"],
      "description": "Category of the finding"
    },
    "location": {
      "type": "string",
      "pattern": "^.+:[0-9]+$",
      "description": "File path and line number (file.py:line)"
    },
    "message": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "description": "Clear, concise description of the issue"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Final confidence after investigation (0.0-1.0)"
    },
    "confidence_sources": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of sources that validated the finding"
    },
    "problem": {
      "type": "string",
      "description": "Detailed explanation of what's wrong"
    },
    "principle": {
      "type": "string",
      "description": "Reference to coding standard or guideline"
    },
    "verification_commands": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Deterministic commands to verify the issue"
    },
    "recommendation": {
      "type": "string",
      "description": "Specific fix with code example if applicable"
    },
    "investigation_trail": {
      "type": "object",
      "properties": {
        "initial_confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "context7_research": {
          "type": ["string", "object", "null"],
          "description": "Context7 research results"
        },
        "perplexity_synthesis": {
          "type": ["string", "null"],
          "description": "Perplexity research results"
        },
        "final_confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    },
    "impact": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "Severity of user/system harm (1-10)"
    },
    "effort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "Complexity to fix (1-10)"
    },
    "risk_multiplier": {
      "type": "number",
      "minimum": 1.0,
      "maximum": 2.0,
      "description": "Risk of introducing bugs (1.0-2.0)"
    },
    "change_multiplier": {
      "type": "number",
      "minimum": 1.0,
      "maximum": 1.5,
      "description": "Scope of change required (1.0-1.5)"
    },
    "priority_score": {
      "type": "number",
      "description": "Calculated: (Impact * 0.6) / (Effort * Risk * Change)"
    },
    "remediation_time_days": {
      "type": "integer",
      "description": "Estimated time to fix based on severity"
    },
    "cvss_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 10.0,
      "description": "CVSS severity score (security findings only)"
    }
  }
}
