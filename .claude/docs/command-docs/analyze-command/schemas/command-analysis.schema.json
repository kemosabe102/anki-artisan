{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "command-analysis.schema.json",
  "title": "Command Analysis Report",
  "description": "Schema for /analyze-command output",
  "type": "object",
  "required": ["command_name", "analysis_date", "overall_score", "grade", "phase_results", "workflow_analysis"],
  "properties": {
    "command_name": {
      "type": "string",
      "description": "Name of analyzed command (e.g., 'git', 'implement')"
    },
    "command_path": {
      "type": "string",
      "description": "Absolute path to command file"
    },
    "analysis_date": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    "overall_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Aggregate quality score (0-100)"
    },
    "grade": {
      "type": "string",
      "enum": ["A", "B", "C", "D", "F"],
      "description": "Letter grade based on overall_score"
    },
    "assessment": {
      "type": "string",
      "enum": ["Excellent", "Good", "Acceptable", "Needs Improvement", "Poor"]
    },
    "overall_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Analysis confidence level"
    },
    "executive_summary": {
      "type": "string",
      "description": "2-3 sentence summary of analysis"
    },
    "phase_results": {
      "type": "object",
      "description": "Results from each analysis phase",
      "properties": {
        "P0_input_validation": { "$ref": "#/$defs/phase_result" },
        "P1_parallel_analysis": { "$ref": "#/$defs/phase_result" },
        "P2_orchestrator_validation": { "$ref": "#/$defs/phase_result" },
        "P3_synthesis": { "$ref": "#/$defs/phase_result" },
        "P4_pre_mortem": { "$ref": "#/$defs/phase_result" },
        "P5_scoring": { "$ref": "#/$defs/phase_result" },
        "P6_report_generation": { "$ref": "#/$defs/phase_result" },
        "P7_delegation_routing": { "$ref": "#/$defs/phase_result" },
        "P8_scamper_optimization": { "$ref": "#/$defs/phase_result" }
      }
    },
    "workflow_analysis": {
      "type": "object",
      "description": "7-dimension quality breakdown",
      "required": ["workflow_quality", "delegation_patterns", "error_handling", "documentation_quality", "integration_points", "token_efficiency", "resilience"],
      "properties": {
        "workflow_quality": { "$ref": "#/$defs/dimension_score" },
        "delegation_patterns": { "$ref": "#/$defs/dimension_score" },
        "error_handling": { "$ref": "#/$defs/dimension_score" },
        "documentation_quality": { "$ref": "#/$defs/dimension_score" },
        "integration_points": { "$ref": "#/$defs/dimension_score" },
        "token_efficiency": { "$ref": "#/$defs/dimension_score" },
        "resilience": { "$ref": "#/$defs/dimension_score" }
      }
    },
    "pre_mortem": {
      "type": "object",
      "description": "Phase 4 pre-mortem results",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["SUCCESS", "TIMEOUT", "SKIPPED", "FAILED"]
        },
        "resilience_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "failure_modes": {
          "type": "array",
          "items": { "$ref": "#/$defs/failure_mode" }
        },
        "risk_matrix": {
          "type": "object",
          "properties": {
            "critical": { "type": "array", "items": { "type": "string" } },
            "high": { "type": "array", "items": { "type": "string" } },
            "medium": { "type": "array", "items": { "type": "string" } },
            "low": { "type": "array", "items": { "type": "string" } }
          }
        },
        "top_3_risks": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "failure_id": { "type": "string" },
              "mitigation_priority": { "type": "string", "enum": ["P1", "P2", "P3"] }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" },
      "description": "All findings sorted by priority"
    },
    "recommendations": {
      "type": "array",
      "items": { "$ref": "#/$defs/recommendation" },
      "description": "Prioritized recommendations"
    },
    "scamper_optimizations": {
      "type": "array",
      "description": "Optional P8 SCAMPER recommendations",
      "items": { "$ref": "#/$defs/scamper_item" }
    },
    "token_analysis": {
      "type": "object",
      "properties": {
        "current_tokens": { "type": "integer" },
        "optimized_tokens": { "type": "integer" },
        "savings_percentage": { "type": "number" },
        "compression_opportunities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "section": { "type": "string" },
              "current_tokens": { "type": "integer" },
              "potential_tokens": { "type": "integer" },
              "strategy": { "type": "string" }
            }
          }
        }
      }
    },
    "debt_analysis": {
      "type": "object",
      "properties": {
        "debt_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "debt_classification": { "type": "string", "enum": ["Low", "Moderate", "High", "Critical"] },
        "tdr_ratio": { "type": "number" },
        "sqale_grade": { "type": "string", "enum": ["A", "B", "C", "D", "E"] },
        "sig_stars": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "synthesis": {
      "type": "object",
      "properties": {
        "overlap_percentage": { "type": "number" },
        "synthesis_applied": { "type": "boolean" },
        "conflicts_detected": { "type": "integer" },
        "consensus_findings": { "type": "array", "items": { "type": "string" } },
        "divergent_findings": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "phase_result": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["SUCCESS", "PARTIAL", "FAILED", "SKIPPED", "TIMEOUT"] },
        "duration_ms": { "type": "integer" },
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "errors": { "type": "array", "items": { "type": "string" } }
      }
    },
    "dimension_score": {
      "type": "object",
      "required": ["score", "weight"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "grade": { "type": "string", "enum": ["A", "B", "C", "D", "F"] },
        "status": { "type": "string", "enum": ["PASS", "NEEDS IMPROVEMENT", "FAIL"] },
        "findings_count": { "type": "integer" }
      }
    },
    "failure_mode": {
      "type": "object",
      "required": ["failure_id", "category", "description", "likelihood", "impact"],
      "properties": {
        "failure_id": { "type": "string", "pattern": "^FM-[A-Z]+-[0-9]+$" },
        "category": { "type": "string", "enum": ["INPUT", "EXECUTION", "WORKFLOW", "OUTPUT", "INTEGRATION"] },
        "description": { "type": "string" },
        "likelihood": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
        "impact": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "risk_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "root_cause": { "type": "string" },
        "prevention": { "type": "string" },
        "detection": { "type": "string" }
      }
    },
    "finding": {
      "type": "object",
      "required": ["title", "source", "priority"],
      "properties": {
        "title": { "type": "string" },
        "source": { "type": "string", "enum": ["claude-code-ecosystem", "documentation", "tech-debt-investigator", "contingency-planner", "orchestrator"] },
        "phase": { "type": "string" },
        "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
        "impact": { "type": "string", "enum": ["High", "Medium", "Low"] },
        "effort": { "type": "string", "enum": ["Low", "Medium", "High"] },
        "priority": { "type": "string", "enum": ["P1", "P2", "P3", "P4"] },
        "priority_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "location": { "type": "string" },
        "description": { "type": "string" },
        "recommendation": { "type": "string" },
        "token_impact": { "type": "integer" }
      }
    },
    "recommendation": {
      "type": "object",
      "required": ["title", "priority"],
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "priority": { "type": "string", "enum": ["P1", "P2", "P3"] },
        "effort": { "type": "string", "enum": ["Low", "Medium", "High"] },
        "impact": { "type": "string", "enum": ["Low", "Medium", "High"] },
        "source_findings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "scamper_item": {
      "type": "object",
      "required": ["technique", "title", "composite_score"],
      "properties": {
        "technique": { "type": "string", "enum": ["S", "C", "A", "M", "P", "E", "R"] },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "current_state": { "type": "string" },
        "proposed_change": { "type": "string" },
        "minimality_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "risk_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "maintainability_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "composite_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "effort": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
        "impact": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
        "priority": { "type": "string", "enum": ["P1", "P2", "P3", "Skip"] }
      }
    }
  }
}
