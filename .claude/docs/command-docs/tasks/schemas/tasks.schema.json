{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TASKS.json",
  "description": "Generated task list for /implement command",
  "type": "object",
  "required": ["metadata", "tasks"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["feature_name", "component_name", "generated_at", "plan_file"],
      "properties": {
        "feature_name": {
          "type": "string",
          "description": "Name of the feature"
        },
        "feature_number": {
          "type": "string",
          "description": "Feature number if present (e.g., '005')"
        },
        "component_name": {
          "type": "string",
          "description": "Sanitized component name for directory"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of generation"
        },
        "plan_file": {
          "type": "string",
          "description": "Source plan file path"
        },
        "total_tasks": {
          "type": "integer",
          "description": "Total number of tasks"
        },
        "parallel_tasks": {
          "type": "integer",
          "description": "Number of tasks that can run in parallel"
        },
        "sequential_tasks": {
          "type": "integer",
          "description": "Number of tasks requiring sequential execution"
        },
        "sprint_points": {
          "type": "integer",
          "description": "Total estimated sprint points"
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/task"
      }
    },
    "review_groups": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/review_group"
      }
    }
  },
  "definitions": {
    "task": {
      "type": "object",
      "required": ["id", "title", "agent", "effort"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^T[0-9]{3}$",
          "description": "Task ID (e.g., T001, T102)"
        },
        "title": {
          "type": "string",
          "description": "Brief task title"
        },
        "description": {
          "type": "string",
          "description": "Detailed task description"
        },
        "agent": {
          "type": "string",
          "enum": [
            "development",
            "code-quality",
            "code-quality",
            "code-quality",
            "claude-code-ecosystem",
            "debugger",
            "documentation",
            "workflow"
          ],
          "description": "Assigned agent"
        },
        "effort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "description": "Effort estimate in points (1-8)"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^T[0-9]{3}$"
          },
          "description": "Task IDs this task depends on"
        },
        "parallel": {
          "type": "boolean",
          "default": true,
          "description": "Can run in parallel with other parallel tasks"
        },
        "priority": {
          "type": "string",
          "enum": ["high", "medium", "low"],
          "default": "medium"
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of acceptance criteria"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Files to be created or modified"
        }
      }
    },
    "review_group": {
      "type": "object",
      "required": ["id", "after_tasks", "reviewers"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^RG[0-9]{2}$",
          "description": "Review group ID (e.g., RG01)"
        },
        "after_tasks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^T[0-9]{3}$"
          },
          "description": "Tasks that must complete before this review"
        },
        "reviewers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "code-quality",
              "architecture",
              "sast-scanner",
              "code-quality"
            ]
          },
          "description": "Agents to perform review"
        },
        "focus": {
          "type": "string",
          "description": "Review focus area"
        }
      }
    }
  }
}
