{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "review-architecture.schema.json",
  "title": "Review Architecture Command Output Schema",
  "description": "Schema for /review-architecture command output",
  "type": "object",
  "required": [
    "architecture_review_report"
  ],
  "properties": {
    "architecture_review_report": {
      "type": "object",
      "required": [
        "target",
        "stage",
        "scores",
        "framework_compliance",
        "pre_mortem",
        "recommendations"
      ],
      "properties": {
        "target": {
          "type": "string",
          "description": "Path or scope reviewed"
        },
        "stage": {
          "type": "string",
          "enum": ["MVP", "Alpha", "Beta", "RC", "GA"],
          "description": "Detected or overridden maturity stage"
        },
        "stage_override": {
          "type": "boolean",
          "description": "Whether stage was manually overridden"
        },
        "scores": {
          "type": "object",
          "required": ["overall", "grade", "stage_gate"],
          "properties": {
            "overall": {
              "type": "number",
              "minimum": 0,
              "maximum": 5,
              "description": "Composite score (0-5.0)"
            },
            "grade": {
              "type": "string",
              "enum": ["A", "A-", "B+", "B", "B-", "C+", "C", "C-", "D", "F"],
              "description": "Letter grade"
            },
            "stage_gate": {
              "type": "string",
              "enum": ["PASS", "FAIL", "WARN"],
              "description": "Stage gate result"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Confidence score (0-1.0)"
            }
          }
        },
        "framework_compliance": {
          "type": "object",
          "required": ["solid", "nfr", "togaf_level", "arb_gates_passed"],
          "properties": {
            "solid": {
              "type": "object",
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 5
                },
                "violations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "principle": {
                        "type": "string",
                        "enum": ["SRP", "OCP", "LSP", "ISP", "DIP"]
                      },
                      "location": { "type": "string" },
                      "description": { "type": "string" }
                    }
                  }
                }
              }
            },
            "nfr": {
              "type": "object",
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 5
                },
                "categories_assessed": { "type": "integer" },
                "categories_passing": { "type": "integer" },
                "details": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "category": { "type": "string" },
                      "status": {
                        "type": "string",
                        "enum": ["PASS", "FAIL", "PARTIAL"]
                      },
                      "notes": { "type": "string" }
                    }
                  }
                }
              }
            },
            "togaf_level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "description": "TOGAF ACMM maturity level (1-5)"
            },
            "arb_gates_passed": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["ARB1", "ARB2", "ARB3", "ARB4"]
              },
              "description": "ARB gates that have been passed"
            }
          }
        },
        "pre_mortem": {
          "type": "object",
          "required": ["failure_modes", "resilience_score"],
          "properties": {
            "failure_modes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "description", "probability", "impact", "exposure"],
                "properties": {
                  "id": { "type": "string" },
                  "description": { "type": "string" },
                  "probability": { "type": "integer", "minimum": 1, "maximum": 5 },
                  "impact": { "type": "integer", "minimum": 1, "maximum": 5 },
                  "exposure": { "type": "integer", "minimum": 1, "maximum": 5 },
                  "risk_score": { "type": "number" },
                  "mitigation": { "type": "string" }
                }
              }
            },
            "resilience_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Overall resilience score (0-100)"
            }
          }
        },
        "recommendations": {
          "type": "object",
          "required": ["p1_critical", "p2_important", "p3_moderate", "p4_optional"],
          "properties": {
            "p1_critical": {
              "type": "array",
              "items": { "$ref": "#/$defs/recommendation" }
            },
            "p2_important": {
              "type": "array",
              "items": { "$ref": "#/$defs/recommendation" }
            },
            "p3_moderate": {
              "type": "array",
              "items": { "$ref": "#/$defs/recommendation" }
            },
            "p4_optional": {
              "type": "array",
              "items": { "$ref": "#/$defs/recommendation" }
            }
          }
        },
        "stage_transition": {
          "type": "object",
          "properties": {
            "current_readiness": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Readiness percentage for next stage"
            },
            "blocking_issues": {
              "type": "array",
              "items": { "type": "string" }
            },
            "next_stage_criteria": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "criterion": { "type": "string" },
                  "status": { "type": "string", "enum": ["MET", "NOT_MET", "PARTIAL"] },
                  "gap": { "type": "string" }
                }
              }
            }
          }
        },
        "adr_gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "decision": { "type": "string" },
              "priority": { "type": "string" },
              "suggested_adr_title": { "type": "string" }
            }
          },
          "description": "Undocumented architecture decisions"
        }
      }
    }
  },
  "$defs": {
    "recommendation": {
      "type": "object",
      "required": ["id", "title", "ice_score"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["architecture", "solid", "nfr", "togaf", "arb", "integration", "documentation", "testing"]
        },
        "ice_score": { "type": "number" },
        "impact": { "type": "integer", "minimum": 1, "maximum": 10 },
        "confidence": { "type": "integer", "minimum": 1, "maximum": 10 },
        "ease": { "type": "integer", "minimum": 1, "maximum": 10 },
        "effort_estimate": { "type": "string" },
        "delegated_to": { "type": "string" }
      }
    }
  }
}
